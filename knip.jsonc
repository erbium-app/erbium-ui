{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": { "packages/*": {}, "apps/*": {} },
  "ignore": [
    "**/.astro/**",
    "**/.blume/**",
    "apps/docs/blume.config.ts",
    "apps/website/src/counter.ts",
  ],
  "ignoreDependencies": [
    "@erbium/ui",
    "@oxlint/plugins",
    "@shadcn/lint",
    "anti-slop",
    "astro",
    "blume",
    "es-module-lexer",
    "react",
    "react-dom",
  ],
}
