{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "packages/*": {},
    "packages/showcase": {
      "entry": [
        "src/**/examples/**/*.tsx",
        "src/**/variants/*.tsx",
        "src/*/catalog.tsx",

        "scripts/*.mjs",
      ],
    },
    "apps/*": {},
  },
  "ignore": ["apps/website/src/counter.ts"],
  "ignoreDependencies": [
    // Referenced by Ultracite's Stylelint preset for its .scss/.less
    // overrides; this repo has neither, so they stay uninstalled.
    "postcss-less",
    "postcss-scss",
  ],
}
