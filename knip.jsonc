{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "packages/*": {},
    "packages/showcase": {
      "entry": [
        "src/**/examples/**/*.tsx",
        "src/**/variants/*.tsx",
        "src/*/catalog.tsx",

        "scripts/*.mjs",
      ],
    },
    "apps/*": {},
  },
  "ignore": ["apps/website/src/counter.ts"],
  "ignoreDependencies": [
    "@erbium/ui",
    "@oxlint/plugins",
    "@shadcn/lint",
    "anti-slop",
    "es-module-lexer",
    "react",
    "react-dom",
  ],
}
