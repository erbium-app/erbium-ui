{
  "name": "erbium-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Agent-first, cross-platform UI primitives and components for React and React Native.",
  "keywords": [
    "accessibility",
    "components",
    "design-system",
    "react",
    "react-native",
    "rtl",
    "shadcn",
    "ui"
  ],
  "homepage": "https://github.com/erbium-app/erbium-ui#readme",
  "bugs": {
    "url": "https://github.com/erbium-app/erbium-ui/issues"
  },
  "author": "erbium-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/erbium-app/erbium-ui.git",
    "directory": "."
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@hugeicons/core-free-icons": "^4.3.5",
      "@hugeicons/react": "^1.1.10",
      "@shadcn/react": "^0.3.1",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/charts": "1.1.0",
      "@tanstack/react-hotkeys": "^0.16.0",
      "@tanstack/react-pacer": "0.24.1",
      "@tanstack/react-router": "^1.170.45",
      "@tanstack/react-table": "9.3.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "class-variance-authority": "^0.7.1",
      "date-fns": "^4.4.0",
      "react": "^19.3.1",
      "react-day-picker": "^10.0.2",
      "react-dom": "^19.3.1",
      "typescript": "next",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
      "vite-plus": "1.3.0"
    },
    "catalogs": {
      "typescript-stable": {
        "typescript": "^7.0.2"
      },
      "storybook": {
        "@tanstack/react-router": "1.170.35"
      }
    }
  },
  "type": "module",
  "scripts": {
    "deploy": "bun run infra deploy",
    "deploy:ci": "bun run infra deploy:ci",
    "deploy:preview": "bun run infra deploy:preview",
    "deploy:preview:plan": "bun run infra plan:preview",
    "infra:typecheck": "bun run infra typecheck",
    "dev": "vp run --parallel --filter './apps/*' dev",
    "docs": "vp run --filter ./apps/docs --fail-if-no-match dev",
    "docs:build": "vp run --filter ./apps/docs --fail-if-no-match build",
    "docs:preview": "vp run --filter ./apps/docs --fail-if-no-match preview",
    "docs:typecheck": "vp run --filter ./apps/docs --fail-if-no-match typecheck",
    "docs:cloudflare:build": "vp run --filter ./apps/docs --fail-if-no-match build:cloudflare",
    "docs:cloudflare:preview": "vp run --filter ./apps/docs --fail-if-no-match preview:cloudflare",
    "website": "vp run --filter ./apps/website --fail-if-no-match dev",
    "website:build": "vp run --filter ./apps/website --fail-if-no-match build",
    "website:preview": "vp run --filter ./apps/website --fail-if-no-match preview",
    "website:typecheck": "vp run --filter ./apps/website --fail-if-no-match typecheck",
    "storybook": "vp run --filter ./apps/storybook --fail-if-no-match dev",
    "storybook:build": "vp run --filter ./apps/storybook --fail-if-no-match build",
    "storybook:preview": "vp run --filter ./apps/storybook --fail-if-no-match preview",
    "storybook:typecheck": "vp run --filter ./apps/storybook --fail-if-no-match typecheck",
    "build": "vp run -r build",
    "typecheck": "vp run -r typecheck",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check && stylelint \"**/*.css\"",
    "fix": "vp check --fix && stylelint \"**/*.css\" --fix",
    "knip": "knip",
    "skills": "skills",
    "skills:add": "skills add",
    "skills:list": "skills ls",
    "skills:remove": "skills remove",
    "skills:update": "skills update",
    "ruler:apply": "ruler apply --local-only",
    "taze": "taze -r",
    "update": "taze -r -I -w -u -l",
    "ui:add": "bunx --bun shadcn@latest add",
    "ui:registry": "vp run --filter ./packages/ui --fail-if-no-match registry:build",
    "ready": "vp run check && vp run build",
    "prepare": "vp config",
    "storybook:registry": "vp run --filter ./apps/storybook --fail-if-no-match registry:build",
    "showcase": "vp run --parallel --filter docs --filter @erbium/storybook dev",
    "showcase:check": "vp run showcase:generate --check && vp run showcase:registry --check && vp run check && vp run docs:build && vp run storybook:build",
    "showcase:generate": "vp run --filter ./packages/showcase --fail-if-no-match generate",
    "showcase:registry": "vp run --filter ./packages/showcase --fail-if-no-match registry:build",
    "intent:list": "intent list",
    "build:cached": "vp run -r --cache build",
    "infra": "bun run --cwd packages/infra",
    "icons:generate": "vp run --filter ./packages/icons --fail-if-no-match generate",
    "icons:check": "vp run --filter ./packages/icons --fail-if-no-match check",
    "icons:dev": "vp run --filter ./packages/icons --fail-if-no-match dev"
  },
  "devDependencies": {
    "@intellectronica/ruler": "0.3.44",
    "@shadcn/lint": "^0.2.3",
    "@tanstack/intent": "^0.5.6",
    "@types/node": "^26.6.5",
    "knip": "^6.42.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "skills": "^1.7.4",
    "stylelint": "^17.16.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "taze": "^21.3.0",
    "typescript": "catalog:",
    "ultracite": "^8.0.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "intent": {
    "skills": [
      "*"
    ]
  },
  "patchedDependencies": {
    "@tanstack/form-core@1.33.5": "patches/@tanstack%2Fform-core@1.33.5.patch",
    "@pierre/diffs@1.5.2": "patches/@pierre%2Fdiffs@1.5.2.patch"
  }
}
