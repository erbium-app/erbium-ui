{
  "name": "@erbium/infra",
  "private": true,
  "type": "module",
  "scripts": {
    "profile": "alchemy profile edit --profile default",
    "plan": "alchemy plan --stage prod --profile default",
    "deploy": "alchemy deploy --stage prod --profile default",
    "deploy:ci": "alchemy deploy --stage prod --profile default --yes --no-input",
    "destroy": "alchemy destroy --stage prod --profile default",
    "builds:plan": "alchemy plan builds.run.ts --stage prod --profile default",
    "builds:deploy": "alchemy deploy builds.run.ts --stage prod --profile default",
    "builds:destroy": "alchemy destroy builds.run.ts --stage prod --profile default",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "alchemy": "2.0.0-beta.80",
    "effect": "4.0.0",
    "typescript": "catalog:"
  }
}
