{
  "name": "@erbium/infra",
  "private": true,
  "type": "module",
  "scripts": {
    "profile": "alchemy profile edit --profile default",
    "plan": "alchemy plan --stage prod --profile default",
    "deploy": "alchemy deploy --stage prod --profile default",
    "deploy:ci": "alchemy deploy --stage prod --profile default --yes --no-input",
    "plan:preview": "alchemy plan --stage preview --profile erbium",
    "deploy:preview": "alchemy deploy --stage preview --profile erbium --yes --no-input",
    "destroy": "alchemy destroy --stage prod --profile default",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@distilled.cloud/cloudflare": "1.0.0-rc.13",
    "@effect/platform-bun": "4.0.3",
    "@effect/platform-node": "4.0.3",
    "alchemy": "2.0.0-beta.81",
    "effect": "4.0.2",
    "typescript": "catalog:"
  }
}
