{
  "name": "@erbium/infra",
  "private": true,
  "type": "module",
  "scripts": {
    "profile": "alchemy profile edit --profile default",
    "plan": "node ../../scripts/registry.mjs && alchemy plan --stage prod --profile default",
    "deploy": "node ../../scripts/registry.mjs && alchemy deploy --stage prod --profile default",
    "deploy:ci": "sh scripts/prepare-history.sh && node ../../scripts/registry.mjs && alchemy deploy --stage prod --profile default --yes --no-input",
    "plan:preview": "node ../../scripts/registry.mjs && alchemy plan --stage preview --profile default",
    "deploy:preview": "sh scripts/prepare-history.sh && node ../../scripts/registry.mjs && alchemy deploy --stage preview --profile default --yes --no-input",
    "destroy": "alchemy destroy --stage prod --profile default",
    "typecheck": "vp check --no-fmt --no-lint"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@distilled.cloud/cloudflare": "1.0.0-rc.20",
    "@effect/platform-bun": "4.1.6",
    "@effect/platform-node": "4.1.6",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.6"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
