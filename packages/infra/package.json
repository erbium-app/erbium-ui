{
  "name": "@erbium/infra",
  "private": true,
  "type": "module",
  "scripts": {
    "profile": "alchemy profile edit --profile default",
    "plan": "alchemy plan --stage prod --profile default",
    "deploy": "alchemy deploy --stage prod --profile default",
    "deploy:ci": "alchemy deploy --stage prod --profile default --yes --no-input",
    "plan:preview": "alchemy plan --stage preview --profile default",
    "deploy:preview": "alchemy deploy --stage preview --profile default --yes --no-input",
    "destroy": "alchemy destroy --stage prod --profile default",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@distilled.cloud/cloudflare": "1.0.0-rc.17",
    "@effect/platform-bun": "4.1.0",
    "@effect/platform-node": "4.1.0",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
