{
  "name": "@erbium-ui/react",
  "version": "0.1.0",
  "description": "Unstyled, accessible React primitives for Erbium UI.",
  "keywords": [
    "accessible",
    "cascader",
    "editable",
    "erbium",
    "filters",
    "headless",
    "pagination",
    "primitives",
    "react",
    "slider",
    "unstyled"
  ],
  "homepage": "https://ui.erbium.app/docs/react",
  "bugs": {
    "url": "https://github.com/erbium-app/erbium-ui/issues"
  },
  "license": "MIT",
  "author": "AvanVision Pty Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erbium-app/erbium-ui.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./cascader": "./src/cascader/index.ts",
    "./editable": "./src/editable/index.ts",
    "./filters": "./src/filters/index.ts",
    "./pagination": "./src/pagination/index.ts",
    "./pagination/core": "./src/pagination/core.ts",
    "./slider": "./src/slider/index.ts",
    "./slider/core": "./src/slider/core.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./cascader": {
        "types": "./dist/cascader/index.d.ts",
        "default": "./dist/cascader/index.js"
      },
      "./editable": {
        "types": "./dist/editable/index.d.ts",
        "default": "./dist/editable/index.js"
      },
      "./filters": {
        "types": "./dist/filters/index.d.ts",
        "default": "./dist/filters/index.js"
      },
      "./pagination": {
        "types": "./dist/pagination/index.d.ts",
        "default": "./dist/pagination/index.js"
      },
      "./pagination/core": {
        "types": "./dist/pagination/core.d.ts",
        "default": "./dist/pagination/core.js"
      },
      "./slider": {
        "types": "./dist/slider/index.d.ts",
        "default": "./dist/slider/index.js"
      },
      "./slider/core": {
        "types": "./dist/slider/core.d.ts",
        "default": "./dist/slider/core.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && node scripts/finalize-dist.mjs",
    "prepack": "bun run build && node scripts/manifest.mjs publish",
    "postpack": "node scripts/manifest.mjs restore",
    "test": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-table": "catalog:",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "31.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "@types/react": ">=19",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
