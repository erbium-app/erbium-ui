{
  "name": "@erbium-ui/react",
  "version": "0.1.0",
  "description": "Unstyled, accessible React primitives for Erbium UI.",
  "keywords": [
    "accessible",
    "cascader",
    "erbium",
    "filters",
    "headless",
    "primitives",
    "react",
    "unstyled"
  ],
  "homepage": "https://ui.erbium.app/docs/react",
  "bugs": {
    "url": "https://github.com/erbium-app/erbium-ui/issues"
  },
  "license": "MIT",
  "author": "AvanVision Pty Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erbium-app/erbium-ui.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./cascader": "./src/cascader/index.ts",
    "./cascader/tree": "./src/cascader/tree.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./cascader": {
        "types": "./dist/cascader/index.d.ts",
        "default": "./dist/cascader/index.js"
      },
      "./cascader/tree": {
        "types": "./dist/cascader/tree.d.ts",
        "default": "./dist/cascader/tree.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && node scripts/finalize-dist.mjs",
    "prepack": "bun run build && node scripts/manifest.mjs publish",
    "postpack": "node scripts/manifest.mjs restore",
    "test": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "30.1.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "@types/react": ">=19",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
