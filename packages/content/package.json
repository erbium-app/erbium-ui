{
  "name": "@erbium/content",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Markdown documentation for Erbium UI.",
  "files": [
    "components",
    "references",
    "*.md",
    "src"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./*.md": "./*.md",
    "./taxonomy": "./src/taxonomy.ts",
    "./documents": "./src/documents.ts",
    "./markdown": "./src/markdown.ts",
    "./components/*": "./components/*"
  },
  "devDependencies": {
    "vite": "catalog:"
  }
}
