    "@types/d3-shape": "^3.2.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "4.1.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
