{
  "name": "@erbium/ui",
  "version": "0.0.0",
  "description": "Composable, accessible, RTL-ready UI components with consistent styling and behavior across React, Astro, and React Native.",
  "keywords": [
    "accessibility",
    "astro",
    "components",
    "design-system",
    "react",
    "react-native",
    "rtl",
    "shadcn",
    "ui"
  ],
  "homepage": "https://github.com/erbium-app/erbium-ui#readme",
  "bugs": {
    "url": "https://github.com/erbium-app/erbium-ui/issues"
  },
  "license": "MIT",
  "author": "erbium-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/erbium-app/erbium-ui.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./globals.css": "./src/styles/globals.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "registry:build": "node scripts/build-registry.mjs && shadcn build registry.json --output public/r && vp fmt registry.json public/r --write",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@shadcn/react": "^0.3.1",
    "@tanstack/charts": "0.18.0",
    "@tanstack/hotkeys": "^0.10.1",
    "@tanstack/react-pacer": "0.24.0",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "easing-gradients": "^0.0.3",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "motion": "^13.5.0",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.14.1",
    "shadcn": "^4.21.1",
    "shadow-plugin": "^2.1.1",
    "tailwindcss": "latest",
    "torph": "^0.1.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "latest",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "next",
    "vite-plus": "catalog:",
    "vitest": "latest"
  },
  "inlinedDependencies": {
    "react": "19.3.0"
  }
}
