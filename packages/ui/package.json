{
  "name": "@erbium/ui",
  "version": "0.0.0",
  "description": "Composable, accessible, RTL-ready UI components with consistent styling and behavior across React and React Native.",
  "keywords": [
    "accessibility",
    "components",
    "design-system",
    "react",
    "react-native",
    "rtl",
    "shadcn",
    "ui"
  ],
  "homepage": "https://github.com/erbium-app/erbium-ui#readme",
  "bugs": {
    "url": "https://github.com/erbium-app/erbium-ui/issues"
  },
  "license": "MIT",
  "author": "erbium-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/erbium-app/erbium-ui.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./globals.css": "./src/styles/globals.css",
    "./brand/logo.css": "./src/styles/brand/logo.css",
    "./package.json": "./package.json",
    "./blocks/*": "./src/blocks/*.tsx",
    "./charts/*": "./src/charts/*.tsx",
    "./assets/fonts/*": "./src/assets/fonts/*"
  },
  "scripts": {
    "registry:build": "node scripts/build-registry.mjs && vp fmt registry.json public/r --write",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@base-ui/utils": "0.5.0",
    "@daypicker/react": "catalog:",
    "@erbium-ui/react": "workspace:*",
    "@erbium/icons": "workspace:*",
    "@foresightjs/react": "1.0.0",
    "@hugeicons/core-free-icons": "catalog:",
    "@hugeicons/react": "catalog:",
    "@pierre/diffs": "1.6.4",
    "@pierre/highlights": "0.4.0",
    "@pierre/trees": "1.0.0",
    "@ramka/react": "^0.0.2",
    "@shadcn/react": "catalog:",
    "@tanstack/charts": "catalog:",
    "@tanstack/react-hotkeys": "catalog:",
    "@tanstack/react-pacer": "catalog:",
    "@tanstack/react-table": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "^0.5.2",
    "d3-shape": "3.2.1",
    "easing-gradients": "^0.0.3",
    "embla-carousel-react": "^8.6.0",
    "js.foresight": "4.2.1",
    "motion": "^14.14.0",
    "react-resizable-panels": "^4.24.1",
    "shadcn": "^4.23.0",
    "shadow-plugin": "^2.1.1",
    "skullet": "0.0.3",
    "tailwindcss": "latest",
    "torph": "^0.1.4",
    "tw-animate-css": "^1.4.0"
