{
  "name": "@erbium/showcase",
  "private": true,
  "type": "module",
  "exports": {
    "./catalog": "./src/catalog.ts",
    "./manifest": "./manifest.json",
    "./preview": "./src/preview.tsx",
    "./sources": "./src/sources.ts",
    "./*": "./src/*/catalog.tsx",
    "./registry": "./registry.json"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "registry:build": "node scripts/build-registry.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@erbium/content": "workspace:*",
    "@erbium/ui": "workspace:*",
    "@hugeicons/core-free-icons": "catalog:",
    "@hugeicons/react": "catalog:",
    "@pierre/diffs": "1.6.4",
    "@shadcn/react": "catalog:",
    "@tanstack/charts": "catalog:",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-hotkeys": "catalog:",
    "@tanstack/react-pacer": "catalog:",
    "@tanstack/react-table": "catalog:",
    "date-fns": "catalog:",
    "embla-carousel-autoplay": "^8.6.0",
    "react": "catalog:",
    "react-day-picker": "catalog:",
    "react-dom": "catalog:",
    "react-textarea-autosize": "^8.5.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:typescript-stable",
    "vite": "catalog:"
  }
}
