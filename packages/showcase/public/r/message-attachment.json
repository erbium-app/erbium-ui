{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "message-attachment",
  "type": "registry:block",
  "title": "Message: Attachment",
  "description": "Display an attachment within a message.",
  "dependencies": ["@hugeicons/core-free-icons@^4.3.5", "@hugeicons/react@^1.1.10"],
  "registryDependencies": [
    "@erbium/attachment",
    "@erbium/bubble",
    "@erbium/message",
    "@erbium/styles"
  ],
  "files": [
    {
      "path": "src/message/examples/upstream/message-attachment.tsx",
      "type": "registry:component",
      "target": "@components/showcase/message/examples/upstream/message-attachment.tsx",
      "content": "import { HugeiconsIcon } from \"@hugeicons/react\";\nimport Download01Icon from \"@hugeicons/core-free-icons/Download01Icon\";\nimport FileTextIcon from \"@hugeicons/core-free-icons/FileTextIcon\";\n\nimport {\n  Attachment,\n  AttachmentAction,\n  AttachmentActions,\n  AttachmentContent,\n  AttachmentDescription,\n  AttachmentMedia,\n  AttachmentTitle,\n} from \"@/registry/erbium/ui/attachment\";\nimport { Bubble, BubbleContent } from \"@/registry/erbium/ui/bubble\";\nimport { Message, MessageContent } from \"@/registry/erbium/ui/message\";\n\nexport function MessageAttachmentDemo() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-8 py-12\">\n      <Message align=\"end\">\n        <MessageContent>\n          <Attachment orientation=\"vertical\">\n            <AttachmentMedia variant=\"image\">\n              <img\n                src=\"https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=900&auto=format&fit=crop&q=80\"\n                alt=\"Workspace\"\n              />\n            </AttachmentMedia>\n          </Attachment>\n          <Bubble>\n            <BubbleContent>\n              Here&apos;s the image. Can you add it to the PDF? Use it for the cover page.\n            </BubbleContent>\n          </Bubble>\n        </MessageContent>\n      </Message>\n      <Message>\n        <MessageContent>\n          <Bubble variant=\"muted\">\n            <BubbleContent>\n              Done. Here&apos;s the PDF with the image added as the cover page.\n            </BubbleContent>\n          </Bubble>\n          <Attachment>\n            <AttachmentMedia>\n              <HugeiconsIcon icon={FileTextIcon} />\n            </AttachmentMedia>\n            <AttachmentContent>\n              <AttachmentTitle>sales-dashboard.pdf</AttachmentTitle>\n              <AttachmentDescription>PDF · 2.4 MB</AttachmentDescription>\n            </AttachmentContent>\n            <AttachmentActions>\n              <AttachmentAction\n                type=\"button\"\n                title=\"Download\"\n                aria-label=\"Download\"\n                size=\"icon-sm\"\n                variant=\"secondary\"\n              >\n                <HugeiconsIcon icon={Download01Icon} />\n              </AttachmentAction>\n            </AttachmentActions>\n          </Attachment>\n        </MessageContent>\n      </Message>\n      <Message align=\"end\">\n        <MessageContent>\n          <Bubble>\n            <BubbleContent>Thanks. Looks good.</BubbleContent>\n          </Bubble>\n        </MessageContent>\n      </Message>\n    </div>\n  );\n}\n"
    },
    {
      "path": "src/message/variants/attachment.tsx",
      "type": "registry:component",
      "target": "@components/showcase/message/variants/attachment.tsx",
      "content": "import { MessageAttachmentDemo } from \"../examples/upstream/message-attachment\";\n\nconst Example = () => <MessageAttachmentDemo />;\n\nexport default Example;\n"
    }
  ]
}
