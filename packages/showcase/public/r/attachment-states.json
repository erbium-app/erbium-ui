{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "attachment-states",
  "type": "registry:block",
  "title": "Attachment: States",
  "description": "Set `state` to reflect the upload lifecycle. `uploading` and `processing` shimmer the title, and `error` switches to a error treatment.",
  "dependencies": ["@hugeicons/core-free-icons@^4.3.5", "@hugeicons/react@^1.1.10"],
  "registryDependencies": ["@erbium/attachment", "@erbium/spinner", "@erbium/styles"],
  "files": [
    {
      "path": "src/attachment/examples/upstream/attachment-states.tsx",
      "type": "registry:component",
      "target": "@components/showcase/attachment/examples/upstream/attachment-states.tsx",
      "content": "import { HugeiconsIcon } from \"@hugeicons/react\";\nimport AlertSquareIcon from \"@hugeicons/core-free-icons/AlertSquareIcon\";\nimport CheckIcon from \"@hugeicons/core-free-icons/CheckIcon\";\nimport Clock01Icon from \"@hugeicons/core-free-icons/Clock01Icon\";\nimport FileTextIcon from \"@hugeicons/core-free-icons/FileTextIcon\";\nimport RefreshCwIcon from \"@hugeicons/core-free-icons/RefreshCwIcon\";\nimport XIcon from \"@hugeicons/core-free-icons/XIcon\";\n\nimport {\n  Attachment,\n  AttachmentAction,\n  AttachmentActions,\n  AttachmentContent,\n  AttachmentDescription,\n  AttachmentMedia,\n  AttachmentTitle,\n} from \"@/registry/erbium/ui/attachment\";\nimport { Spinner } from \"@/registry/erbium/ui/spinner\";\n\nexport function AttachmentStates() {\n  return (\n    <div className=\"mx-auto flex w-full max-w-sm flex-col gap-2 py-12\">\n      <Attachment state=\"idle\" className=\"w-full\">\n        <AttachmentMedia>\n          <HugeiconsIcon icon={Clock01Icon} />\n        </AttachmentMedia>\n        <AttachmentContent>\n          <AttachmentTitle>selected-file.pdf</AttachmentTitle>\n          <AttachmentDescription>Ready to upload</AttachmentDescription>\n        </AttachmentContent>\n        <AttachmentActions>\n          <AttachmentAction aria-label=\"Remove selected-file.pdf\">\n            <HugeiconsIcon icon={XIcon} />\n          </AttachmentAction>\n        </AttachmentActions>\n      </Attachment>\n      <Attachment state=\"uploading\" className=\"w-full\">\n        <AttachmentMedia>\n          <Spinner />\n        </AttachmentMedia>\n        <AttachmentContent>\n          <AttachmentTitle>design-system.zip</AttachmentTitle>\n          <AttachmentDescription>Uploading · 64%</AttachmentDescription>\n        </AttachmentContent>\n        <AttachmentActions>\n          <AttachmentAction aria-label=\"Cancel upload\">\n            <HugeiconsIcon icon={XIcon} />\n          </AttachmentAction>\n        </AttachmentActions>\n      </Attachment>\n      <Attachment state=\"processing\" className=\"w-full\">\n        <AttachmentMedia>\n          <HugeiconsIcon icon={FileTextIcon} />\n        </AttachmentMedia>\n        <AttachmentContent>\n          <AttachmentTitle>market-research.pdf</AttachmentTitle>\n          <AttachmentDescription>Processing document</AttachmentDescription>\n        </AttachmentContent>\n        <AttachmentActions>\n          <AttachmentAction aria-label=\"Remove market-research.pdf\">\n            <HugeiconsIcon icon={XIcon} />\n          </AttachmentAction>\n        </AttachmentActions>\n      </Attachment>\n      <Attachment state=\"error\" className=\"w-full\">\n        <AttachmentMedia>\n          <HugeiconsIcon icon={AlertSquareIcon} />\n        </AttachmentMedia>\n        <AttachmentContent>\n          <AttachmentTitle>financial-model.xlsx</AttachmentTitle>\n          <AttachmentDescription>Upload failed. Try again.</AttachmentDescription>\n        </AttachmentContent>\n        <AttachmentActions>\n          <AttachmentAction aria-label=\"Retry upload\">\n            <HugeiconsIcon icon={RefreshCwIcon} />\n          </AttachmentAction>\n          <AttachmentAction aria-label=\"Remove financial-model.xlsx\">\n            <HugeiconsIcon icon={XIcon} />\n          </AttachmentAction>\n        </AttachmentActions>\n      </Attachment>\n      <Attachment state=\"done\" className=\"w-full\">\n        <AttachmentMedia>\n          <HugeiconsIcon icon={CheckIcon} />\n        </AttachmentMedia>\n        <AttachmentContent>\n          <AttachmentTitle>uploaded-report.pdf</AttachmentTitle>\n          <AttachmentDescription>Uploaded · 1.8 MB</AttachmentDescription>\n        </AttachmentContent>\n        <AttachmentActions>\n          <AttachmentAction aria-label=\"Remove uploaded-report.pdf\">\n            <HugeiconsIcon icon={XIcon} />\n          </AttachmentAction>\n        </AttachmentActions>\n      </Attachment>\n    </div>\n  );\n}\n"
    },
    {
      "path": "src/attachment/variants/states.tsx",
      "type": "registry:component",
      "target": "@components/showcase/attachment/variants/states.tsx",
      "content": "import { AttachmentStates } from \"../examples/upstream/attachment-states\";\n\nconst Example = () => <AttachmentStates />;\n\nexport default Example;\n"
    }
  ]
}
