{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "context-menu-checkboxes",
  "type": "registry:block",
  "title": "Context Menu: Checkboxes",
  "description": "Use `ContextMenuCheckboxItem` for toggles.",
  "registryDependencies": ["@erbium/context-menu", "@erbium/styles"],
  "files": [
    {
      "content": "import {\n  ContextMenu,\n  ContextMenuCheckboxItem,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuTrigger,\n  ContextMenuList,\n} from \"@/registry/erbium/ui/context-menu\";\n\nexport function ContextMenuCheckboxes() {\n  return (\n    <ContextMenu>\n      <ContextMenuTrigger className=\"flex aspect-video w-full max-w-xs items-center justify-center rounded-xl border border-dashed bg-surface-panel text-caption\">\n        <span className=\"hidden pointer-fine:inline-block\">Right click here</span>\n        <span className=\"hidden pointer-coarse:inline-block\">Long press here</span>\n      </ContextMenuTrigger>\n      <ContextMenuContent>\n        <ContextMenuList>\n          <ContextMenuGroup>\n            <ContextMenuCheckboxItem defaultChecked>Show Bookmarks Bar</ContextMenuCheckboxItem>\n            <ContextMenuCheckboxItem>Show Full URLs</ContextMenuCheckboxItem>\n            <ContextMenuCheckboxItem defaultChecked>Show Developer Tools</ContextMenuCheckboxItem>\n          </ContextMenuGroup>\n        </ContextMenuList>\n      </ContextMenuContent>\n    </ContextMenu>\n  );\n}\n",
      "path": "src/context-menu/examples/context-menu-checkboxes.tsx",
      "target": "@components/showcase/context-menu/examples/context-menu-checkboxes.tsx",
      "type": "registry:component"
    },
    {
      "content": "import { ContextMenuCheckboxes } from \"../examples/context-menu-checkboxes\";\n\nconst Example = () => <ContextMenuCheckboxes />;\n\nexport default Example;\n",
      "path": "src/context-menu/variants/checkboxes.tsx",
      "target": "@components/showcase/context-menu/variants/checkboxes.tsx",
      "type": "registry:component"
    }
  ]
}
