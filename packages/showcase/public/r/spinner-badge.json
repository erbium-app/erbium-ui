{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "spinner-badge",
  "type": "registry:block",
  "title": "Spinner: Badge",
  "description": "Use `Badge loading` to show a spinner at the inline start: left in LTR and right in RTL. The badge manages placement and sizing automatically.",
  "registryDependencies": ["@erbium/badge", "@erbium/styles"],
  "files": [
    {
      "content": "import { Badge } from \"@/registry/erbium/ui/badge\";\n\nconst SpinnerBadge = () => (\n  <div className=\"flex flex-wrap items-center justify-center gap-group\">\n    <Badge loading variant=\"default\">\n      default\n    </Badge>\n    <Badge loading variant=\"secondary\">\n      secondary\n    </Badge>\n    <Badge loading variant=\"outline\">\n      outline\n    </Badge>\n    <Badge loading variant=\"ghost\">\n      ghost\n    </Badge>\n    <Badge loading variant=\"link\">\n      link\n    </Badge>\n    <Badge loading variant=\"error\">\n      error\n    </Badge>\n    <Badge loading variant=\"info\">\n      info\n    </Badge>\n    <Badge loading variant=\"success\">\n      success\n    </Badge>\n    <Badge loading variant=\"warning\">\n      warning\n    </Badge>\n    <Badge loading variant=\"ghost-error\">\n      ghost-error\n    </Badge>\n    <Badge loading variant=\"ghost-info\">\n      ghost-info\n    </Badge>\n    <Badge loading variant=\"ghost-success\">\n      ghost-success\n    </Badge>\n    <Badge loading variant=\"ghost-warning\">\n      ghost-warning\n    </Badge>\n    <Badge loading variant=\"tag-blue\">\n      tag-blue\n    </Badge>\n    <Badge loading variant=\"tag-cyan\">\n      tag-cyan\n    </Badge>\n    <Badge loading variant=\"tag-gray\">\n      tag-gray\n    </Badge>\n    <Badge loading variant=\"tag-green\">\n      tag-green\n    </Badge>\n    <Badge loading variant=\"tag-magenta\">\n      tag-magenta\n    </Badge>\n    <Badge loading variant=\"tag-orange\">\n      tag-orange\n    </Badge>\n    <Badge loading variant=\"tag-purple\">\n      tag-purple\n    </Badge>\n    <Badge loading variant=\"tag-red\">\n      tag-red\n    </Badge>\n    <Badge loading variant=\"tag-yellow\">\n      tag-yellow\n    </Badge>\n  </div>\n);\n\nexport default SpinnerBadge;\n",
      "path": "src/spinner/examples/spinner-badge.tsx",
      "target": "@components/showcase/spinner/examples/spinner-badge.tsx",
      "type": "registry:component"
    },
    {
      "content": "import ExampleSpinnerBadge from \"../examples/spinner-badge\";\n\nconst Example = () => (\n  <div className=\"w-full min-w-72 max-w-2xl p-4\">\n    <ExampleSpinnerBadge />\n  </div>\n);\n\nexport default Example;\n",
      "path": "src/spinner/variants/badge.tsx",
      "target": "@components/showcase/spinner/variants/badge.tsx",
      "type": "registry:component"
    }
  ]
}
