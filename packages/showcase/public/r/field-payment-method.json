  "title": "field payment method",
  "description": "Erbium field payment method example.",
  "registryDependencies": [
    "@erbium/button",
    "@erbium/checkbox",
    "@erbium/field",
    "@erbium/input",
    "@erbium/select",
    "@erbium/styles",
