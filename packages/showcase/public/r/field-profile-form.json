{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "field-profile-form",
  "type": "registry:component",
  "title": "field profile form",
  "description": "Erbium field profile form example.",
  "registryDependencies": ["@erbium/button", "@erbium/field", "@erbium/input", "@erbium/styles"],
  "files": [
    {
      "content": "import { Button } from \"@/registry/erbium/ui/button\";\nimport {\n  Field,\n  FieldContent,\n  FieldDescription,\n  FieldGroup,\n  FieldLabel,\n  FieldLegend,\n  FieldSet,\n} from \"@/registry/erbium/ui/field\";\nimport { Input } from \"@/registry/erbium/ui/input\";\n\nexport function FieldResponsive() {\n  return (\n    <div className=\"w-full max-w-lg\">\n      <form>\n        <FieldSet>\n          <FieldLegend>Profile</FieldLegend>\n          <FieldDescription>Fill in your profile information.</FieldDescription>\n          <FieldGroup>\n            <Field orientation=\"responsive\">\n              <FieldContent>\n                <FieldLabel>Name</FieldLabel>\n                <FieldDescription>Provide your full name for identification</FieldDescription>\n              </FieldContent>\n              <Input placeholder=\"Alex Smith\" required />\n            </Field>\n            <Field orientation=\"responsive\">\n              <Button type=\"submit\">Submit</Button>\n              <Button type=\"button\" variant=\"outline\">\n                Cancel\n              </Button>\n            </Field>\n          </FieldGroup>\n        </FieldSet>\n      </form>\n    </div>\n  );\n}\n",
      "path": "src/field/examples/field-profile-form.tsx",
      "target": "@components/showcase/field/examples/field-profile-form.tsx",
      "type": "registry:component"
    }
  ]
}
