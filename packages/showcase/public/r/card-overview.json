{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "card-overview",
  "type": "registry:block",
  "title": "Card: Overview",
  "description": "",
  "registryDependencies": [
    "@erbium/button",
    "@erbium/card",
    "@erbium/field",
    "@erbium/input",
    "@erbium/password-input",
    "@erbium/stateful-button",
    "@erbium/styles"
  ],
  "files": [
    {
      "content": "import { Button } from \"@/registry/erbium/ui/button\";\nimport {\n  Card,\n  CardAction,\n  CardContent,\n  CardDescription,\n  CardFooter,\n  CardHeader,\n  CardTitle,\n} from \"@/registry/erbium/ui/card\";\nimport { Input } from \"@/registry/erbium/ui/input\";\nimport { Field, FieldLabel } from \"@/registry/erbium/ui/field\";\nimport { PasswordInput } from \"@/registry/erbium/ui/password-input\";\nimport { StatefulButton } from \"@/registry/erbium/ui/stateful-button\";\n\nconst CardDemo = () => (\n  <Card className=\"w-full max-w-sm\">\n    <CardHeader>\n      <CardTitle>Login to your account</CardTitle>\n      <CardDescription>Enter your email below to login to your account</CardDescription>\n      <CardAction>\n        <Button variant=\"link\">Sign Up</Button>\n      </CardAction>\n    </CardHeader>\n    <CardContent>\n      <form\n        id=\"card-login-form\"\n        onSubmit={(event) => {\n          event.preventDefault();\n        }}\n      >\n        <div className=\"flex flex-col gap-section\">\n          <Field>\n            <FieldLabel>Email</FieldLabel>\n            <Input type=\"email\" placeholder=\"m@example.com\" required />\n          </Field>\n          <Field>\n            <div className=\"flex items-center\">\n              <FieldLabel>Password</FieldLabel>\n              <a\n                href=\"/forgot-password\"\n                className=\"ml-auto inline-block text-caption underline-offset-4 hover:underline\"\n              >\n                Forgot your password?\n              </a>\n            </div>\n            <PasswordInput required />\n          </Field>\n        </div>\n      </form>\n    </CardContent>\n    <CardFooter className=\"gap-related\">\n      <StatefulButton type=\"submit\" form=\"card-login-form\" className=\"min-w-0 flex-1\">\n        Login\n      </StatefulButton>\n      <Button variant=\"outline\" className=\"shrink-0\">\n        Login with Google\n      </Button>\n    </CardFooter>\n  </Card>\n);\n\nexport default CardDemo;\n",
      "path": "src/card/examples/card-demo.tsx",
      "target": "@components/showcase/card/examples/card-demo.tsx",
      "type": "registry:component"
    },
    {
      "content": "import Demo from \"../examples/card-demo\";\n\nconst Example = () => (\n  <div className=\"w-full min-w-72 max-w-2xl p-4\">\n    <Demo />\n  </div>\n);\n\nexport default Example;\n",
      "path": "src/card/variants/overview.tsx",
      "target": "@components/showcase/card/variants/overview.tsx",
      "type": "registry:component"
    }
  ]
}
