{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "command-scrollable",
  "type": "registry:block",
  "title": "Command: Scrollable",
  "description": "Scrollable command menu with multiple items.",
  "dependencies": ["@hugeicons/core-free-icons@^4.3.5", "@hugeicons/react@^1.1.10"],
  "registryDependencies": ["@erbium/button", "@erbium/command", "@erbium/styles"],
  "files": [
    {
      "path": "src/command/examples/command-scrollable.tsx",
      "type": "registry:component",
      "target": "@components/showcase/command/examples/command-scrollable.tsx",
      "content": "import * as React from \"react\";\nimport { HugeiconsIcon } from \"@hugeicons/react\";\nimport BellIcon from \"@hugeicons/core-free-icons/BellIcon\";\nimport CalculatorIcon from \"@hugeicons/core-free-icons/CalculatorIcon\";\nimport Calendar01Icon from \"@hugeicons/core-free-icons/Calendar01Icon\";\nimport ClipboardPasteIcon from \"@hugeicons/core-free-icons/ClipboardPasteIcon\";\nimport CodeIcon from \"@hugeicons/core-free-icons/CodeIcon\";\nimport CreditCardIcon from \"@hugeicons/core-free-icons/CreditCardIcon\";\nimport FileTextIcon from \"@hugeicons/core-free-icons/FileTextIcon\";\nimport Folder01Icon from \"@hugeicons/core-free-icons/Folder01Icon\";\nimport FolderPlusIcon from \"@hugeicons/core-free-icons/FolderPlusIcon\";\nimport HelpCircleIcon from \"@hugeicons/core-free-icons/HelpCircleIcon\";\nimport Home01Icon from \"@hugeicons/core-free-icons/Home01Icon\";\nimport Image01Icon from \"@hugeicons/core-free-icons/Image01Icon\";\nimport InboxIcon from \"@hugeicons/core-free-icons/InboxIcon\";\nimport LayoutGridIcon from \"@hugeicons/core-free-icons/LayoutGridIcon\";\nimport ListIcon from \"@hugeicons/core-free-icons/ListIcon\";\nimport PlusIcon from \"@hugeicons/core-free-icons/PlusIcon\";\nimport ScissorsIcon from \"@hugeicons/core-free-icons/ScissorsIcon\";\nimport Settings01Icon from \"@hugeicons/core-free-icons/Settings01Icon\";\nimport TrashIcon from \"@hugeicons/core-free-icons/TrashIcon\";\nimport UserIcon from \"@hugeicons/core-free-icons/UserIcon\";\nimport ZoomInIcon from \"@hugeicons/core-free-icons/ZoomInIcon\";\nimport ZoomOutIcon from \"@hugeicons/core-free-icons/ZoomOutIcon\";\n\nimport { Button } from \"@/registry/erbium/ui/button\";\nimport {\n  Command,\n  CommandDialog,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n  CommandSeparator,\n  CommandShortcut,\n} from \"@/registry/erbium/ui/command\";\n\nexport function CommandManyItems() {\n  const [open, setOpen] = React.useState(false);\n\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <Button onClick={() => setOpen(true)} variant=\"outline\" className=\"w-fit\">\n        Open Menu\n      </Button>\n      <CommandDialog open={open} onOpenChange={setOpen}>\n        <Command>\n          <CommandInput placeholder=\"Type a command or search...\" />\n          <CommandList>\n            <CommandEmpty>No results found.</CommandEmpty>\n            <CommandGroup heading=\"Navigation\">\n              <CommandItem>\n                <HugeiconsIcon icon={Home01Icon} />\n                <span>Home</span>\n                <CommandShortcut hotkey=\"Mod+H\" />\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={InboxIcon} />\n                <span>Inbox</span>\n                <CommandShortcut hotkey=\"Mod+I\" />\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={FileTextIcon} />\n                <span>Documents</span>\n                <CommandShortcut hotkey=\"Mod+D\" />\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={Folder01Icon} />\n                <span>Folders</span>\n                <CommandShortcut hotkey=\"Mod+F\" />\n              </CommandItem>\n            </CommandGroup>\n            <CommandSeparator />\n            <CommandGroup heading=\"Actions\">\n              <CommandItem>\n                <HugeiconsIcon icon={PlusIcon} />\n                <span>New File</span>\n                <CommandShortcut hotkey=\"Mod+N\" />\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={FolderPlusIcon} />\n                <span>New Folder</span>\n                <CommandShortcut hotkey=\"Shift+Mod+N\" />\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={FileTextIcon} />\n                <span>Duplicate file</span>\n                <CommandShortcut hotkey=\"Mod+D\" />\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={ScissorsIcon} />\n                <span>Cut</span>\n                <CommandShortcut hotkey=\"Mod+X\" />\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={ClipboardPasteIcon} />\n                <span>Paste</span>\n                <CommandShortcut hotkey=\"Mod+V\" />\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={TrashIcon} />\n                <span>Delete</span>\n                <CommandShortcut hotkey=\"Backspace\" />\n              </CommandItem>\n            </CommandGroup>\n            <CommandSeparator />\n            <CommandGroup heading=\"View\">\n              <CommandItem>\n                <HugeiconsIcon icon={LayoutGridIcon} />\n                <span>Grid View</span>\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={ListIcon} />\n                <span>List View</span>\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={ZoomInIcon} />\n                <span>Zoom In</span>\n                <CommandShortcut hotkey=\"Mod+Plus\" />\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={ZoomOutIcon} />\n                <span>Zoom Out</span>\n                <CommandShortcut hotkey=\"Mod+-\" />\n              </CommandItem>\n            </CommandGroup>\n            <CommandSeparator />\n            <CommandGroup heading=\"Account\">\n              <CommandItem>\n                <HugeiconsIcon icon={UserIcon} />\n                <span>Profile</span>\n                <CommandShortcut hotkey=\"Mod+P\" />\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={CreditCardIcon} />\n                <span>Billing</span>\n                <CommandShortcut hotkey=\"Mod+B\" />\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={Settings01Icon} />\n                <span>Settings</span>\n                <CommandShortcut hotkey=\"Mod+S\" />\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={BellIcon} />\n                <span>Notifications</span>\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={HelpCircleIcon} />\n                <span>Help & Support</span>\n              </CommandItem>\n            </CommandGroup>\n            <CommandSeparator />\n            <CommandGroup heading=\"Tools\">\n              <CommandItem>\n                <HugeiconsIcon icon={CalculatorIcon} />\n                <span>Calculator</span>\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={Calendar01Icon} />\n                <span>Calendar</span>\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={Image01Icon} />\n                <span>Image Editor</span>\n              </CommandItem>\n              <CommandItem>\n                <HugeiconsIcon icon={CodeIcon} />\n                <span>Code Editor</span>\n              </CommandItem>\n            </CommandGroup>\n          </CommandList>\n        </Command>\n      </CommandDialog>\n    </div>\n  );\n}\n"
    },
    {
      "path": "src/command/variants/scrollable.tsx",
      "type": "registry:component",
      "target": "@components/showcase/command/variants/scrollable.tsx",
      "content": "import { CommandManyItems } from \"../examples/command-scrollable\";\n\nconst Example = () => <CommandManyItems />;\n\nexport default Example;\n"
    }
  ]
}
