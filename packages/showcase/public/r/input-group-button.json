{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "input-group-button",
  "type": "registry:block",
  "title": "Input Group: Button",
  "description": "Place an action button inside an input group.\n\nCompose copy actions with `CopyButton` and `render={<InputGroupButton size=\"icon-xs\" />}`. The block owns clipboard state, animated feedback, and announcements.",
  "registryDependencies": [
    "@erbium/copy-button",
    "@erbium/icon",
    "@erbium/input-group",
    "@erbium/popover",
    "@erbium/styles"
  ],
  "files": [
    {
      "path": "src/input-group/examples/input-group-button.tsx",
      "type": "registry:component",
      "target": "@components/showcase/input-group/examples/input-group-button.tsx",
      "content": "import { CopyButton } from \"@/registry/erbium/blocks/copy-button\";\nimport * as React from \"react\";\nimport { Icon } from \"@/registry/erbium/ui/icon\";\n\nimport {\n  InputGroup,\n  InputGroupAddon,\n  InputGroupButton,\n  InputGroupInput,\n} from \"@/registry/erbium/ui/input-group\";\nimport { Popover, PopoverContent, PopoverTrigger } from \"@/registry/erbium/ui/popover\";\n\nexport default function InputGroupButtonExample() {\n  const [isFavorite, setIsFavorite] = React.useState(false);\n\n  return (\n    <div className=\"grid w-full max-w-sm gap-section\">\n      <InputGroup>\n        <InputGroupInput value=\"https://example.com/john-doe\" readOnly />\n        <InputGroupAddon align=\"inline-end\">\n          <CopyButton\n            value=\"https://example.com/john-doe\"\n            aria-label=\"Copy profile URL\"\n            render={<InputGroupButton size=\"icon-xs\" />}\n          />\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup className=\"[--radius:9999px]\">\n        <InputGroupAddon>\n          <Popover>\n            <PopoverTrigger\n              render={\n                <InputGroupButton\n                  aria-label=\"Connection information\"\n                  variant=\"secondary\"\n                  size=\"icon-xs\"\n                >\n                  <Icon name=\"info\" />\n                </InputGroupButton>\n              }\n            />\n            <PopoverContent align=\"start\" className=\"flex flex-col gap-1 rounded-xl text-caption\">\n              <p className=\"font-medium\">Your connection is not secure.</p>\n              <p>You should not enter any sensitive information on this site.</p>\n            </PopoverContent>\n          </Popover>\n        </InputGroupAddon>\n        <InputGroupAddon className=\"pl-1.5 text-muted-foreground\">https://</InputGroupAddon>\n        <InputGroupInput id=\"input-secure-19\" />\n        <InputGroupAddon align=\"inline-end\">\n          <InputGroupButton onClick={() => setIsFavorite(!isFavorite)} size=\"icon-xs\">\n            <Icon\n              name=\"star\"\n              data-favorite={isFavorite}\n              className=\"data-[favorite=true]:fill-info data-[favorite=true]:stroke-info\"\n            />\n          </InputGroupButton>\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup>\n        <InputGroupInput placeholder=\"Type to search...\" />\n        <InputGroupAddon align=\"inline-end\">\n          <InputGroupButton variant=\"secondary\">Search</InputGroupButton>\n        </InputGroupAddon>\n      </InputGroup>\n    </div>\n  );\n}\n"
    },
    {
      "path": "src/input-group/variants/button.tsx",
      "type": "registry:component",
      "target": "@components/showcase/input-group/variants/button.tsx",
      "content": "import InputGroupButtonExample from \"../examples/input-group-button\";\n\nconst Example = () => <InputGroupButtonExample />;\n\nexport default Example;\n"
    }
  ]
}
