{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "hover-card-overview",
  "type": "registry:block",
  "title": "Hover Card: Overview",
  "description": "",
  "registryDependencies": [
    "@erbium/avatar",
    "@erbium/button",
    "@erbium/hover-card",
    "@erbium/styles"
  ],
  "files": [
    {
      "content": "import { Avatar, AvatarFallback, AvatarImage } from \"@/registry/erbium/ui/avatar\";\nimport { Button } from \"@/registry/erbium/ui/button\";\nimport { HoverCard, HoverCardContent, HoverCardTrigger } from \"@/registry/erbium/ui/hover-card\";\n\nexport default function HoverCardExample() {\n  return (\n    <HoverCard>\n      <HoverCardTrigger render={<Button variant=\"link\">@erbium</Button>} />\n      <HoverCardContent className=\"w-80\">\n        <div className=\"flex justify-between gap-group\">\n          <Avatar>\n            <AvatarImage\n              src=\"https://ui.erbium.app/brand/erbium-logo-dark.svg\"\n              alt=\"Erbium UI\"\n              className=\"bg-foreground p-1 dark:bg-background\"\n            />\n            <AvatarFallback>EU</AvatarFallback>\n          </Avatar>\n          <div className=\"space-y-1\">\n            <h4 className=\"text-subtitle\">@erbium</h4>\n            <p className=\"text-caption\">Accessible components for building your next interface.</p>\n            <div className=\"text-metadata text-muted-foreground\">Joined December 2021</div>\n          </div>\n        </div>\n      </HoverCardContent>\n    </HoverCard>\n  );\n}\n",
      "path": "src/hover-card/examples/hover-card-demo.tsx",
      "target": "@components/showcase/hover-card/examples/hover-card-demo.tsx",
      "type": "registry:component"
    },
    {
      "content": "import HoverCardExample from \"../examples/hover-card-demo\";\n\nconst Example = () => (\n  <div className=\"w-full max-w-2xl min-w-72 p-4\">\n    <HoverCardExample />\n  </div>\n);\n\nexport default Example;\n",
      "path": "src/hover-card/variants/overview.tsx",
      "target": "@components/showcase/hover-card/variants/overview.tsx",
      "type": "registry:component"
    }
  ]
}
