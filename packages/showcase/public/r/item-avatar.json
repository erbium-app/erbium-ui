{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "item-avatar",
  "type": "registry:block",
  "title": "Item: Avatar",
  "description": "You can use `ItemMedia` with `variant=\"avatar\"` to display an avatar.",
  "registryDependencies": [
    "@erbium/avatar",
    "@erbium/button",
    "@erbium/icon",
    "@erbium/item",
    "@erbium/styles"
  ],
  "files": [
    {
      "content": "import { Icon } from \"@/registry/erbium/ui/icon\";\n\nimport { Avatar, AvatarFallback, AvatarGroup, AvatarImage } from \"@/registry/erbium/ui/avatar\";\nimport { Button } from \"@/registry/erbium/ui/button\";\nimport {\n  Item,\n  ItemActions,\n  ItemContent,\n  ItemDescription,\n  ItemMedia,\n  ItemTitle,\n} from \"@/registry/erbium/ui/item\";\n\nexport default function ItemAvatarExample() {\n  return (\n    <div className=\"flex w-full max-w-lg flex-col gap-section\">\n      <Item variant=\"card\">\n        <ItemMedia>\n          <Avatar size=\"lg\">\n            <AvatarImage\n              src=\"https://images.pexels.com/photos/2379004/pexels-photo-2379004.jpeg?auto=compress&cs=tinysrgb&w=256&h=256&fit=crop\"\n              alt=\"Alex Smith\"\n            />\n            <AvatarFallback>AS</AvatarFallback>\n          </Avatar>\n        </ItemMedia>\n        <ItemContent>\n          <ItemTitle>Alex Smith</ItemTitle>\n          <ItemDescription>Last seen 5 months ago</ItemDescription>\n        </ItemContent>\n        <ItemActions>\n          <Button size=\"icon-sm\" variant=\"outline\" className=\"rounded-full\" aria-label=\"Invite\">\n            <Icon name=\"plus\" />\n          </Button>\n        </ItemActions>\n      </Item>\n      <Item variant=\"card\">\n        <ItemMedia>\n          <AvatarGroup className=\"grayscale\">\n            <Avatar className=\"hidden sm:flex\">\n              <AvatarImage\n                src=\"https://images.pexels.com/photos/1681010/pexels-photo-1681010.jpeg?auto=compress&cs=tinysrgb&w=256&h=256&fit=crop\"\n                alt=\"John Doe\"\n              />\n              <AvatarFallback>JD</AvatarFallback>\n            </Avatar>\n            <Avatar className=\"hidden sm:flex\">\n              <AvatarImage\n                src=\"https://images.pexels.com/photos/415829/pexels-photo-415829.jpeg?auto=compress&cs=tinysrgb&w=256&h=256&fit=crop\"\n                alt=\"Jane Doe\"\n              />\n              <AvatarFallback>JD</AvatarFallback>\n            </Avatar>\n            <Avatar>\n              <AvatarImage\n                src=\"https://images.pexels.com/photos/2379004/pexels-photo-2379004.jpeg?auto=compress&cs=tinysrgb&w=256&h=256&fit=crop\"\n                alt=\"Alex Smith\"\n              />\n              <AvatarFallback>AS</AvatarFallback>\n            </Avatar>\n          </AvatarGroup>\n        </ItemMedia>\n        <ItemContent>\n          <ItemTitle>No Team Members</ItemTitle>\n          <ItemDescription>Invite your team to collaborate on this project.</ItemDescription>\n        </ItemContent>\n        <ItemActions>\n          <Button size=\"sm\" variant=\"outline\">\n            Invite\n          </Button>\n        </ItemActions>\n      </Item>\n    </div>\n  );\n}\n",
      "path": "src/item/examples/item-avatar.tsx",
      "target": "@components/showcase/item/examples/item-avatar.tsx",
      "type": "registry:component"
    },
    {
      "content": "import ExampleItemAvatar from \"../examples/item-avatar\";\n\nconst Example = () => (\n  <div className=\"w-full min-w-72 max-w-2xl p-4\">\n    <ExampleItemAvatar />\n  </div>\n);\n\nexport default Example;\n",
      "path": "src/item/variants/avatar.tsx",
      "target": "@components/showcase/item/variants/avatar.tsx",
      "type": "registry:component"
    }
  ]
}
