{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "context-menu-shortcuts",
  "type": "registry:block",
  "title": "Context Menu: Shortcuts",
  "description": "Add `ContextMenuShortcut` to show keyboard hints.",
  "registryDependencies": ["@erbium/context-menu", "@erbium/styles"],
  "files": [
    {
      "content": "import {\n  ContextMenu,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuItem,\n  ContextMenuSeparator,\n  ContextMenuShortcut,\n  ContextMenuTrigger,\n  ContextMenuList,\n} from \"@/registry/erbium/ui/context-menu\";\n\nexport const ContextMenuShortcuts = () => (\n  <ContextMenu>\n    <ContextMenuTrigger className=\"flex aspect-video w-full max-w-xs items-center justify-center rounded-xl border border-dashed bg-surface-panel text-caption\">\n      <span className=\"hidden pointer-fine:inline-block\">Right click here</span>\n      <span className=\"hidden pointer-coarse:inline-block\">Long press here</span>\n    </ContextMenuTrigger>\n    <ContextMenuContent>\n      <ContextMenuList>\n        <ContextMenuGroup>\n          <ContextMenuItem>\n            Back\n            <ContextMenuShortcut hotkey=\"Mod+[\" />\n          </ContextMenuItem>\n          <ContextMenuItem disabled>\n            Forward\n            <ContextMenuShortcut hotkey=\"Mod+]\" />\n          </ContextMenuItem>\n          <ContextMenuItem>\n            Reload\n            <ContextMenuShortcut hotkey=\"Mod+R\" />\n          </ContextMenuItem>\n        </ContextMenuGroup>\n        <ContextMenuSeparator />\n        <ContextMenuGroup>\n          <ContextMenuItem>\n            Save\n            <ContextMenuShortcut hotkey=\"Mod+S\" />\n          </ContextMenuItem>\n          <ContextMenuItem>\n            Save As...\n            <ContextMenuShortcut hotkey=\"Mod+Shift+S\" />\n          </ContextMenuItem>\n        </ContextMenuGroup>\n      </ContextMenuList>\n    </ContextMenuContent>\n  </ContextMenu>\n);\n",
      "path": "src/context-menu/examples/context-menu-shortcuts.tsx",
      "target": "@components/showcase/context-menu/examples/context-menu-shortcuts.tsx",
      "type": "registry:component"
    },
    {
      "content": "import { ContextMenuShortcuts } from \"../examples/context-menu-shortcuts\";\n\nconst Example = () => <ContextMenuShortcuts />;\n\nexport default Example;\n",
      "path": "src/context-menu/variants/shortcuts.tsx",
      "target": "@components/showcase/context-menu/variants/shortcuts.tsx",
      "type": "registry:component"
    }
  ]
}
