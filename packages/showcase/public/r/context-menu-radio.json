{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "context-menu-radio",
  "type": "registry:block",
  "title": "Context Menu: Radio",
  "description": "Use `ContextMenuRadioItem` for exclusive choices.",
  "registryDependencies": ["@erbium/context-menu", "@erbium/icon", "@erbium/styles"],
  "files": [
    {
      "content": "import * as React from \"react\";\nimport { Icon } from \"@/registry/erbium/ui/icon\";\n\nimport {\n  ContextMenu,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuLabel,\n  ContextMenuRadioGroup,\n  ContextMenuRadioItem,\n  ContextMenuSeparator,\n  ContextMenuTrigger,\n  ContextMenuList,\n} from \"@/registry/erbium/ui/context-menu\";\n\nexport default function ContextMenuRadioExample() {\n  const [user, setUser] = React.useState(\"pedro\");\n  const [theme, setTheme] = React.useState(\"light\");\n\n  return (\n    <ContextMenu>\n      <ContextMenuTrigger className=\"flex aspect-video w-full max-w-xs items-center justify-center rounded-xl border border-dashed bg-surface-panel text-caption\">\n        <span className=\"hidden pointer-fine:inline-block\">Right click here</span>\n        <span className=\"hidden pointer-coarse:inline-block\">Long press here</span>\n      </ContextMenuTrigger>\n      <ContextMenuContent>\n        <ContextMenuList>\n          <ContextMenuGroup>\n            <ContextMenuLabel>People</ContextMenuLabel>\n            <ContextMenuRadioGroup value={user} onValueChange={setUser}>\n              <ContextMenuRadioItem value=\"pedro\">Pedro Duarte</ContextMenuRadioItem>\n              <ContextMenuRadioItem value=\"colm\">Colm Tuite</ContextMenuRadioItem>\n            </ContextMenuRadioGroup>\n          </ContextMenuGroup>\n          <ContextMenuSeparator />\n          <ContextMenuGroup>\n            <ContextMenuLabel>Theme</ContextMenuLabel>\n            <ContextMenuRadioGroup value={theme} onValueChange={setTheme}>\n              <ContextMenuRadioItem value=\"light\">\n                <Icon name=\"sun-03\" />\n                Light\n              </ContextMenuRadioItem>\n              <ContextMenuRadioItem value=\"dark\">\n                <Icon name=\"moon-02\" />\n                Dark\n              </ContextMenuRadioItem>\n            </ContextMenuRadioGroup>\n          </ContextMenuGroup>\n        </ContextMenuList>\n      </ContextMenuContent>\n    </ContextMenu>\n  );\n}\n",
      "path": "src/context-menu/examples/context-menu-radio.tsx",
      "target": "@components/showcase/context-menu/examples/context-menu-radio.tsx",
      "type": "registry:component"
    },
    {
      "content": "import ContextMenuRadioExample from \"../examples/context-menu-radio\";\n\nconst Example = () => <ContextMenuRadioExample />;\n\nexport default Example;\n",
      "path": "src/context-menu/variants/radio.tsx",
      "target": "@components/showcase/context-menu/variants/radio.tsx",
      "type": "registry:component"
    }
  ]
}
