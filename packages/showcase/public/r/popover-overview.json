{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "popover-overview",
  "type": "registry:block",
  "title": "Popover: Overview",
  "description": "",
  "registryDependencies": [
    "@erbium/button",
    "@erbium/field",
    "@erbium/input",
    "@erbium/popover",
    "@erbium/styles"
  ],
  "files": [
    {
      "path": "src/popover/examples/popover-demo.tsx",
      "type": "registry:component",
      "target": "@components/showcase/popover/examples/popover-demo.tsx",
      "content": "import { Button } from \"@/registry/erbium/ui/button\";\nimport { Input } from \"@/registry/erbium/ui/input\";\nimport { Field, FieldLabel } from \"@/registry/erbium/ui/field\";\nimport { Popover, PopoverContent, PopoverTrigger } from \"@/registry/erbium/ui/popover\";\n\nexport default function PopoverDemo() {\n  return (\n    <Popover>\n      <PopoverTrigger render={<Button variant=\"outline\">Open popover</Button>} />\n      <PopoverContent className=\"w-80\">\n        <div className=\"grid gap-group\">\n          <div className=\"space-y-2\">\n            <h4 className=\"text-subtitle\">Dimensions</h4>\n            <p className=\"text-caption text-muted-foreground\">Set the dimensions for the layer.</p>\n          </div>\n          <div className=\"grid gap-related\">\n            <Field className=\"grid grid-cols-3 items-center gap-group\">\n              <FieldLabel>Width</FieldLabel>\n              <Input defaultValue=\"100%\" className=\"col-span-2\" />\n            </Field>\n            <Field className=\"grid grid-cols-3 items-center gap-group\">\n              <FieldLabel>Max. width</FieldLabel>\n              <Input defaultValue=\"300px\" className=\"col-span-2\" />\n            </Field>\n            <Field className=\"grid grid-cols-3 items-center gap-group\">\n              <FieldLabel>Height</FieldLabel>\n              <Input defaultValue=\"25px\" className=\"col-span-2\" />\n            </Field>\n            <Field className=\"grid grid-cols-3 items-center gap-group\">\n              <FieldLabel>Max. height</FieldLabel>\n              <Input defaultValue=\"none\" className=\"col-span-2\" />\n            </Field>\n          </div>\n        </div>\n      </PopoverContent>\n    </Popover>\n  );\n}\n"
    },
    {
      "path": "src/popover/variants/overview.tsx",
      "type": "registry:component",
      "target": "@components/showcase/popover/variants/overview.tsx",
      "content": "import Demo from \"../examples/popover-demo\";\n\nconst Example = () => (\n  <div className=\"w-full min-w-72 max-w-2xl p-4\">\n    <Demo />\n  </div>\n);\n\nexport default Example;\n"
    }
  ]
}
