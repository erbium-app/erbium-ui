{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "alert-dialog-error",
  "type": "registry:component",
  "title": "alert dialog error",
  "description": "Erbium alert dialog error example.",
  "registryDependencies": [
    "@erbium/alert-dialog",
    "@erbium/button",
    "@erbium/icon",
    "@erbium/styles"
  ],
  "files": [
    {
      "content": "import { Icon } from \"@/registry/erbium/ui/icon\";\n\nimport {\n  AlertDialog,\n  AlertDialogAction,\n  AlertDialogCancel,\n  AlertDialogContent,\n  AlertDialogDescription,\n  AlertDialogFooter,\n  AlertDialogHeader,\n  AlertDialogMedia,\n  AlertDialogTitle,\n  AlertDialogTrigger,\n} from \"@/registry/erbium/ui/alert-dialog\";\nimport { Button } from \"@/registry/erbium/ui/button\";\n\nexport function AlertDialogError() {\n  return (\n    <AlertDialog>\n      <AlertDialogTrigger render={<Button variant=\"error\">Delete Chat</Button>} />\n      <AlertDialogContent size=\"sm\">\n        <AlertDialogHeader>\n          <AlertDialogMedia className=\"bg-error/10 text-error dark:bg-error/20 dark:text-error\">\n            <Icon name=\"delete-02\" />\n          </AlertDialogMedia>\n          <AlertDialogTitle>Delete chat?</AlertDialogTitle>\n          <AlertDialogDescription>\n            This will permanently delete this chat conversation. View <a href=\"#\">Settings</a>{\" \"}\n            delete any memories saved during this chat.\n          </AlertDialogDescription>\n        </AlertDialogHeader>\n        <AlertDialogFooter>\n          <AlertDialogCancel variant=\"outline\">Cancel</AlertDialogCancel>\n          <AlertDialogAction variant=\"error\">Delete</AlertDialogAction>\n        </AlertDialogFooter>\n      </AlertDialogContent>\n    </AlertDialog>\n  );\n}\n",
      "path": "src/alert-dialog/examples/alert-dialog-error.tsx",
      "target": "@components/showcase/alert-dialog/examples/alert-dialog-error.tsx",
      "type": "registry:component"
    }
  ]
}
