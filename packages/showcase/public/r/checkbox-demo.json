{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "checkbox-demo",
  "type": "registry:component",
  "title": "checkbox demo",
  "description": "Erbium checkbox demo example.",
  "registryDependencies": ["@erbium/checkbox", "@erbium/field", "@erbium/styles"],
  "files": [
    {
      "path": "src/checkbox/examples/checkbox-demo.tsx",
      "type": "registry:component",
      "target": "@components/showcase/checkbox/examples/checkbox-demo.tsx",
      "content": "import { Checkbox } from \"@/registry/erbium/ui/checkbox\";\nimport { Field, FieldContent, FieldDescription, FieldLabel } from \"@/registry/erbium/ui/field\";\n\nexport default function CheckboxDemo() {\n  return (\n    <div className=\"flex flex-col gap-section\">\n      <Field orientation=\"horizontal\">\n        <Checkbox />\n        <FieldLabel>Accept terms and conditions</FieldLabel>\n      </Field>\n      <Field orientation=\"horizontal\" className=\"items-start\">\n        <Checkbox defaultChecked />\n        <FieldContent>\n          <FieldLabel>Accept terms and conditions</FieldLabel>\n          <FieldDescription>\n            By clicking this checkbox, you agree to the terms and conditions.\n          </FieldDescription>\n        </FieldContent>\n      </Field>\n      <Field orientation=\"horizontal\" disabled>\n        <Checkbox />\n        <FieldLabel>Enable notifications</FieldLabel>\n      </Field>\n      <Field variant=\"card\" orientation=\"horizontal\">\n        <Checkbox defaultChecked />\n        <FieldContent>\n          <FieldLabel>Enable notifications</FieldLabel>\n          <FieldDescription>You can enable or disable notifications at any time.</FieldDescription>\n        </FieldContent>\n      </Field>\n    </div>\n  );\n}\n"
    }
  ]
}
