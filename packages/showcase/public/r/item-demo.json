{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "item-demo",
  "type": "registry:component",
  "title": "item demo",
  "description": "Erbium item demo example.",
  "registryDependencies": ["@erbium/button", "@erbium/icon", "@erbium/item", "@erbium/styles"],
  "files": [
    {
      "content": "import { Icon } from \"@/registry/erbium/ui/icon\";\n\nimport { Button } from \"@/registry/erbium/ui/button\";\nimport {\n  Item,\n  ItemActions,\n  ItemContent,\n  ItemDescription,\n  ItemMedia,\n  ItemTitle,\n} from \"@/registry/erbium/ui/item\";\n\nconst ItemDemo = () => (\n  <div className=\"flex w-full max-w-md flex-col gap-section\">\n    <Item variant=\"card\">\n      <ItemContent>\n        <ItemTitle>Basic Item</ItemTitle>\n        <ItemDescription>A simple item with title and description.</ItemDescription>\n      </ItemContent>\n      <ItemActions>\n        <Button variant=\"outline\" size=\"sm\">\n          Action\n        </Button>\n      </ItemActions>\n    </Item>\n    <Item\n      variant=\"card\"\n      size=\"sm\"\n      render={\n        <a href=\"#\">\n          <ItemMedia>\n            <Icon name=\"badge-check\" className=\"size-5\" />\n          </ItemMedia>\n          <ItemContent>\n            <ItemTitle>Your profile has been verified.</ItemTitle>\n          </ItemContent>\n          <ItemActions>\n            <Icon name=\"chevron-right\" className=\"size-4\" />\n          </ItemActions>\n        </a>\n      }\n    />\n  </div>\n);\n\nexport default ItemDemo;\n",
      "path": "src/item/examples/item-demo.tsx",
      "target": "@components/showcase/item/examples/item-demo.tsx",
      "type": "registry:component"
    }
  ]
}
