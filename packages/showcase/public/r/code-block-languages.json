{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "code-block-languages",
  "type": "registry:component",
  "title": "Code Block: Languages",
  "description": "Header icons follow the source language automatically. Language aliases share the\nsame icon; plaintext has a text-file icon, and unknown languages use a generic file.\n`diff` colors a patch by its line markers, and `ansi` renders terminal escape codes as color.",
  "registryDependencies": ["@erbium/code-block", "@erbium/styles"],
  "files": [
    {
      "content": "import { CodeBlock } from \"@/registry/erbium/blocks/code-block\";\n\nconst Example = () => (\n  <div className=\"grid w-full max-w-xl gap-group\">\n    <CodeBlock title=\"TypeScript\" language=\"typescript\" code='const name: string = \"Erbium\";' />\n    <CodeBlock title=\"Python\" language=\"py\" code='print(\"Hello, Erbium.\")' />\n    <CodeBlock\n      title=\"Patch\"\n      language=\"diff\"\n      code={'@@ -1,2 +1,2 @@\\n const theme = \"system\";\\n-const radius = 4;\\n+const radius = 8;'}\n    />\n    <CodeBlock\n      title=\"Terminal output\"\n      language=\"ansi\"\n      code={\"\\u001B[32m✓\\u001B[0m built in 120ms\\n\\u001B[33mwarning\\u001B[0m: 2 unused exports\"}\n    />\n    <CodeBlock title=\"Plain text\" language=\"text\" code=\"A readable source without highlighting.\" />\n    <CodeBlock\n      title=\"Unknown language\"\n      language=\"unknown-language\"\n      code=\"Unknown languages use the generic file icon.\"\n    />\n  </div>\n);\n\nexport default Example;\n",
      "path": "src/code-block/variants/languages.tsx",
      "target": "@components/showcase/code-block/variants/languages.tsx",
      "type": "registry:component"
    }
  ]
}
