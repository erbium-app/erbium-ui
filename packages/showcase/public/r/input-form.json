{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "input-form",
  "type": "registry:block",
  "title": "Input: Form",
  "description": "A full form example with multiple inputs, a select, and a button.",
  "registryDependencies": [
    "@erbium/button",
    "@erbium/field",
    "@erbium/input",
    "@erbium/select",
    "@erbium/styles"
  ],
  "files": [
    {
      "content": "import { Button } from \"@/registry/erbium/ui/button\";\nimport { Field, FieldDescription, FieldGroup, FieldLabel } from \"@/registry/erbium/ui/field\";\nimport { Input } from \"@/registry/erbium/ui/input\";\nimport {\n  Select,\n  SelectContent,\n  SelectGroup,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/registry/erbium/ui/select\";\n\nexport const InputForm = () => {\n  const countries = [\n    { label: \"United States\", value: \"us\" },\n    { label: \"United Kingdom\", value: \"uk\" },\n    { label: \"Canada\", value: \"ca\" },\n  ];\n\n  return (\n    <form className=\"w-full max-w-sm\">\n      <FieldGroup>\n        <Field>\n          <FieldLabel>Name</FieldLabel>\n          <Input type=\"text\" placeholder=\"Alex Smith\" required />\n        </Field>\n        <Field>\n          <FieldLabel>Email</FieldLabel>\n          <Input type=\"email\" placeholder=\"john@example.com\" />\n          <FieldDescription>We&apos;ll never share your email with anyone.</FieldDescription>\n        </Field>\n        <div className=\"grid grid-cols-2 gap-group\">\n          <Field>\n            <FieldLabel>Phone</FieldLabel>\n            <Input type=\"tel\" placeholder=\"+1 (555) 123-4567\" />\n          </Field>\n          <Field>\n            <FieldLabel htmlFor=\"form-country\">Country</FieldLabel>\n            <Select items={countries} defaultValue=\"us\">\n              <SelectTrigger id=\"form-country\">\n                <SelectValue />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectGroup>\n                  {countries.map((country) => (\n                    <SelectItem key={country.value} value={country.value}>\n                      {country.label}\n                    </SelectItem>\n                  ))}\n                </SelectGroup>\n              </SelectContent>\n            </Select>\n          </Field>\n        </div>\n        <Field>\n          <FieldLabel>Address</FieldLabel>\n          <Input type=\"text\" placeholder=\"123 Main St\" />\n        </Field>\n        <Field orientation=\"horizontal\">\n          <Button type=\"button\" variant=\"outline\">\n            Cancel\n          </Button>\n          <Button type=\"submit\">Submit</Button>\n        </Field>\n      </FieldGroup>\n    </form>\n  );\n};\n",
      "path": "src/input/examples/input-form.tsx",
      "target": "@components/showcase/input/examples/input-form.tsx",
      "type": "registry:component"
    },
    {
      "content": "import { InputForm } from \"../examples/input-form\";\n\nconst Example = () => <InputForm />;\n\nexport default Example;\n",
      "path": "src/input/variants/form.tsx",
      "target": "@components/showcase/input/variants/form.tsx",
      "type": "registry:component"
    }
  ]
}
