{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "spinner-button",
  "type": "registry:block",
  "title": "Spinner: Button",
  "description": "Use `Button loading` to show a spinner at the inline start (left in LTR, right in RTL) and block activation. `InputGroupButton` inherits the same API. Icon-only buttons center the spinner.",
  "registryDependencies": ["@erbium/button", "@erbium/styles"],
  "files": [
    {
      "content": "import { Button } from \"@/registry/erbium/ui/button\";\n\nconst SpinnerButton = () => (\n  <div className=\"flex flex-wrap items-center justify-center gap-group\">\n    <Button loading variant=\"default\">\n      default\n    </Button>\n    <Button loading variant=\"secondary\">\n      secondary\n    </Button>\n    <Button loading variant=\"outline\">\n      outline\n    </Button>\n    <Button loading variant=\"ghost\">\n      ghost\n    </Button>\n    <Button loading variant=\"link\">\n      link\n    </Button>\n    <Button loading variant=\"embedded\">\n      embedded\n    </Button>\n    <Button loading variant=\"error\">\n      error\n    </Button>\n    <Button loading variant=\"info\">\n      info\n    </Button>\n    <Button loading variant=\"success\">\n      success\n    </Button>\n    <Button loading variant=\"warning\">\n      warning\n    </Button>\n    <Button loading variant=\"ghost-error\">\n      ghost-error\n    </Button>\n    <Button loading variant=\"ghost-info\">\n      ghost-info\n    </Button>\n    <Button loading variant=\"ghost-success\">\n      ghost-success\n    </Button>\n    <Button loading variant=\"ghost-warning\">\n      ghost-warning\n    </Button>\n  </div>\n);\n\nexport default SpinnerButton;\n",
      "path": "src/spinner/examples/spinner-button.tsx",
      "target": "@components/showcase/spinner/examples/spinner-button.tsx",
      "type": "registry:component"
    },
    {
      "content": "import ExampleSpinnerButton from \"../examples/spinner-button\";\n\nconst Example = () => (\n  <div className=\"w-full min-w-72 max-w-2xl p-4\">\n    <ExampleSpinnerButton />\n  </div>\n);\n\nexport default Example;\n",
      "path": "src/spinner/variants/button.tsx",
      "target": "@components/showcase/spinner/variants/button.tsx",
      "type": "registry:component"
    }
  ]
}
