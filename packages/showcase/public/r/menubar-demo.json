{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-demo",
  "type": "registry:component",
  "title": "menubar demo",
  "description": "Erbium menubar demo example.",
  "registryDependencies": ["@erbium/copy-button", "@erbium/menubar", "@erbium/styles"],
  "files": [
    {
      "content": "import { CopyButton, CopyButtonIcon } from \"@/registry/erbium/blocks/copy-button\";\nimport {\n  Menubar,\n  MenubarCheckboxItem,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarMenu,\n  MenubarRadioGroup,\n  MenubarRadioItem,\n  MenubarSeparator,\n  MenubarShortcut,\n  MenubarSub,\n  MenubarSubContent,\n  MenubarSubTrigger,\n  MenubarTrigger,\n  MenubarList,\n} from \"@/registry/erbium/ui/menubar\";\n\nconst MenubarDemo = () => (\n  <Menubar>\n    <MenubarMenu>\n      <MenubarTrigger>File</MenubarTrigger>\n      <MenubarContent>\n        <MenubarList>\n          <MenubarItem>\n            New Tab <MenubarShortcut hotkey=\"Mod+T\" />\n          </MenubarItem>\n          <MenubarItem>\n            New Window <MenubarShortcut hotkey=\"Mod+N\" />\n          </MenubarItem>\n          <MenubarItem disabled>New Incognito Window</MenubarItem>\n          <MenubarSeparator />\n          <MenubarSub>\n            <MenubarSubTrigger>Share</MenubarSubTrigger>\n            <MenubarSubContent>\n              <MenubarList>\n                <MenubarItem>Email link</MenubarItem>\n                <MenubarItem>Messages</MenubarItem>\n                <MenubarItem>Notes</MenubarItem>\n              </MenubarList>\n            </MenubarSubContent>\n          </MenubarSub>\n          <MenubarSeparator />\n          <MenubarItem>\n            Print... <MenubarShortcut hotkey=\"Mod+P\" />\n          </MenubarItem>\n        </MenubarList>\n      </MenubarContent>\n    </MenubarMenu>\n    <MenubarMenu>\n      <MenubarTrigger>Edit</MenubarTrigger>\n      <MenubarContent>\n        <MenubarList>\n          <MenubarItem>\n            Undo <MenubarShortcut hotkey=\"Mod+Z\" />\n          </MenubarItem>\n          <MenubarItem>\n            Redo <MenubarShortcut hotkey=\"Shift+Mod+Z\" />\n          </MenubarItem>\n          <MenubarSeparator />\n          <MenubarSub>\n            <MenubarSubTrigger>Find</MenubarSubTrigger>\n            <MenubarSubContent>\n              <MenubarList>\n                <MenubarItem>Search the web</MenubarItem>\n                <MenubarSeparator />\n                <MenubarItem>Find...</MenubarItem>\n                <MenubarItem>Find Next</MenubarItem>\n                <MenubarItem>Find Previous</MenubarItem>\n              </MenubarList>\n            </MenubarSubContent>\n          </MenubarSub>\n          <MenubarSeparator />\n          <MenubarItem>Cut</MenubarItem>\n          <CopyButton value=\"Erbium UI\" render={<MenubarItem />}>\n            <CopyButtonIcon />\n            <span>Copy</span>\n          </CopyButton>\n          <MenubarItem>Paste</MenubarItem>\n        </MenubarList>\n      </MenubarContent>\n    </MenubarMenu>\n    <MenubarMenu>\n      <MenubarTrigger>View</MenubarTrigger>\n      <MenubarContent>\n        <MenubarList>\n          <MenubarGroup>\n            <MenubarCheckboxItem>Always Show Bookmarks Bar</MenubarCheckboxItem>\n            <MenubarCheckboxItem checked>Always Show Full URLs</MenubarCheckboxItem>\n          </MenubarGroup>\n          <MenubarSeparator />\n          <MenubarItem inset>\n            Reload <MenubarShortcut hotkey=\"Mod+R\" />\n          </MenubarItem>\n          <MenubarItem disabled inset>\n            Force Reload <MenubarShortcut hotkey=\"Shift+Mod+R\" />\n          </MenubarItem>\n          <MenubarSeparator />\n          <MenubarItem inset>Toggle Fullscreen</MenubarItem>\n          <MenubarSeparator />\n          <MenubarItem inset>Hide Sidebar</MenubarItem>\n        </MenubarList>\n      </MenubarContent>\n    </MenubarMenu>\n    <MenubarMenu>\n      <MenubarTrigger>Profiles</MenubarTrigger>\n      <MenubarContent>\n        <MenubarList>\n          <MenubarRadioGroup value=\"benoit\">\n            <MenubarRadioItem value=\"andy\">Andy</MenubarRadioItem>\n            <MenubarRadioItem value=\"benoit\">Benoit</MenubarRadioItem>\n            <MenubarRadioItem value=\"Luis\">Luis</MenubarRadioItem>\n          </MenubarRadioGroup>\n          <MenubarSeparator />\n          <MenubarItem inset>Edit...</MenubarItem>\n          <MenubarSeparator />\n          <MenubarItem inset>Add Profile...</MenubarItem>\n        </MenubarList>\n      </MenubarContent>\n    </MenubarMenu>\n  </Menubar>\n);\n\nexport default MenubarDemo;\n",
      "path": "src/menubar/examples/menubar-demo.tsx",
      "target": "@components/showcase/menubar/examples/menubar-demo.tsx",
      "type": "registry:component"
    }
  ]
}
