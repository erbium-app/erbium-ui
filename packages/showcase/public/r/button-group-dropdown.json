{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "button-group-dropdown",
  "type": "registry:component",
  "title": "button group dropdown",
  "description": "Erbium button group dropdown example.",
  "registryDependencies": [
    "@erbium/button",
    "@erbium/button-group",
    "@erbium/copy-button",
    "@erbium/dropdown-menu",
    "@erbium/icon",
    "@erbium/stateful-icon",
    "@erbium/styles"
  ],
  "files": [
    {
      "path": "src/button-group/examples/button-group-dropdown.tsx",
      "type": "registry:component",
      "target": "@components/showcase/button-group/examples/button-group-dropdown.tsx",
      "content": "import { CopyButton, CopyButtonIcon } from \"@/registry/erbium/blocks/copy-button\";\nimport { Icon } from \"@/registry/erbium/ui/icon\";\n\nimport { RotatingChevron } from \"@/registry/erbium/ui/stateful-icon\";\nimport { Button } from \"@/registry/erbium/ui/button\";\nimport { ButtonGroup } from \"@/registry/erbium/ui/button-group\";\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuGroup,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n  DropdownMenuList,\n} from \"@/registry/erbium/ui/dropdown-menu\";\n\nexport default function ButtonGroupDropdown() {\n  return (\n    <ButtonGroup>\n      <Button variant=\"outline\">Follow</Button>\n      <DropdownMenu>\n        <DropdownMenuTrigger\n          render={\n            <Button variant=\"outline\" className=\"group group/menu-trigger\">\n              <RotatingChevron />\n            </Button>\n          }\n        />\n        <DropdownMenuContent align=\"end\" className=\"[--radius:1rem]\">\n          <DropdownMenuList>\n            <DropdownMenuGroup>\n              <DropdownMenuItem>\n                <Icon name=\"volume-off\" />\n                Mute Conversation\n              </DropdownMenuItem>\n              <DropdownMenuItem>\n                <Icon name=\"check\" />\n                Mark as Read\n              </DropdownMenuItem>\n              <DropdownMenuItem>\n                <Icon name=\"alert-01\" />\n                Report Conversation\n              </DropdownMenuItem>\n              <DropdownMenuItem>\n                <Icon name=\"user-round-x\" />\n                Block User\n              </DropdownMenuItem>\n              <DropdownMenuItem>\n                <Icon name=\"share-01\" />\n                Share Conversation\n              </DropdownMenuItem>\n              <CopyButton value=\"Conversation with Alex\" render={<DropdownMenuItem />}>\n                <CopyButtonIcon />\n                <span>Copy Conversation</span>\n              </CopyButton>\n            </DropdownMenuGroup>\n            <DropdownMenuSeparator />\n            <DropdownMenuGroup>\n              <DropdownMenuItem variant=\"error\">\n                <Icon name=\"trash\" />\n                Delete Conversation\n              </DropdownMenuItem>\n            </DropdownMenuGroup>\n          </DropdownMenuList>\n        </DropdownMenuContent>\n      </DropdownMenu>\n    </ButtonGroup>\n  );\n}\n"
    }
  ]
}
