{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-submenu",
  "type": "registry:block",
  "title": "Menubar: Submenu",
  "description": "Use `MenubarSub`, `MenubarSubTrigger`, and `MenubarSubContent` for nested menus.",
  "registryDependencies": ["@erbium/copy-button", "@erbium/menubar", "@erbium/styles"],
  "files": [
    {
      "content": "import { CopyButton, CopyButtonIcon } from \"@/registry/erbium/blocks/copy-button\";\nimport {\n  Menubar,\n  MenubarContent,\n  MenubarItem,\n  MenubarMenu,\n  MenubarSeparator,\n  MenubarShortcut,\n  MenubarSub,\n  MenubarSubContent,\n  MenubarSubTrigger,\n  MenubarTrigger,\n  MenubarList,\n} from \"@/registry/erbium/ui/menubar\";\n\nexport const MenubarSubmenu = () => (\n  <Menubar className=\"w-72\">\n    <MenubarMenu>\n      <MenubarTrigger>File</MenubarTrigger>\n      <MenubarContent>\n        <MenubarList>\n          <MenubarSub>\n            <MenubarSubTrigger>Share</MenubarSubTrigger>\n            <MenubarSubContent>\n              <MenubarList>\n                <MenubarItem>Email link</MenubarItem>\n                <MenubarItem>Messages</MenubarItem>\n                <MenubarItem>Notes</MenubarItem>\n              </MenubarList>\n            </MenubarSubContent>\n          </MenubarSub>\n          <MenubarSeparator />\n          <MenubarItem>\n            Print... <MenubarShortcut hotkey=\"Mod+P\" />\n          </MenubarItem>\n        </MenubarList>\n      </MenubarContent>\n    </MenubarMenu>\n    <MenubarMenu>\n      <MenubarTrigger>Edit</MenubarTrigger>\n      <MenubarContent>\n        <MenubarList>\n          <MenubarItem>\n            Undo <MenubarShortcut hotkey=\"Mod+Z\" />\n          </MenubarItem>\n          <MenubarItem>\n            Redo <MenubarShortcut hotkey=\"Mod+Shift+Z\" />\n          </MenubarItem>\n          <MenubarSeparator />\n          <MenubarSub>\n            <MenubarSubTrigger>Find</MenubarSubTrigger>\n            <MenubarSubContent>\n              <MenubarList>\n                <MenubarItem>Find...</MenubarItem>\n                <MenubarItem>Find Next</MenubarItem>\n                <MenubarItem>Find Previous</MenubarItem>\n              </MenubarList>\n            </MenubarSubContent>\n          </MenubarSub>\n          <MenubarSeparator />\n          <MenubarItem>Cut</MenubarItem>\n          <CopyButton value=\"Erbium UI\" render={<MenubarItem />}>\n            <CopyButtonIcon />\n            <span>Copy</span>\n          </CopyButton>\n          <MenubarItem>Paste</MenubarItem>\n        </MenubarList>\n      </MenubarContent>\n    </MenubarMenu>\n  </Menubar>\n);\n",
      "path": "src/menubar/examples/menubar-submenu.tsx",
      "target": "@components/showcase/menubar/examples/menubar-submenu.tsx",
      "type": "registry:component"
    },
    {
      "content": "import { MenubarSubmenu } from \"../examples/menubar-submenu\";\n\nconst Example = () => <MenubarSubmenu />;\n\nexport default Example;\n",
      "path": "src/menubar/variants/submenu.tsx",
      "target": "@components/showcase/menubar/variants/submenu.tsx",
      "type": "registry:component"
    }
  ]
}
