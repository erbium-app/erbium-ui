      "content": "import { Avatar, AvatarFallback, AvatarGroup, AvatarImage } from \"@/registry/erbium/ui/avatar\";\n\nconst AvatarDemo = () => (\n  <div className=\"flex flex-row flex-wrap items-center gap-12\">\n    <Avatar>\n      <AvatarImage\n        src=\"https://images.pexels.com/photos/1681010/pexels-photo-1681010.jpeg?auto=compress&cs=tinysrgb&w=256&h=256&fit=crop\"\n        alt=\"John Doe\"\n      />\n      <AvatarFallback>JD</AvatarFallback>\n    </Avatar>\n    <Avatar>\n      <AvatarImage\n        src=\"https://images.pexels.com/photos/2379004/pexels-photo-2379004.jpeg?auto=compress&cs=tinysrgb&w=256&h=256&fit=crop\"\n        alt=\"Alex Smith\"\n      />\n      <AvatarFallback>AS</AvatarFallback>\n    </Avatar>\n    <AvatarGroup className=\"grayscale\">\n      <Avatar>\n        <AvatarImage\n          src=\"https://images.pexels.com/photos/1681010/pexels-photo-1681010.jpeg?auto=compress&cs=tinysrgb&w=256&h=256&fit=crop\"\n          alt=\"John Doe\"\n        />\n        <AvatarFallback>JD</AvatarFallback>\n      </Avatar>\n      <Avatar>\n        <AvatarImage\n          src=\"https://images.pexels.com/photos/415829/pexels-photo-415829.jpeg?auto=compress&cs=tinysrgb&w=256&h=256&fit=crop\"\n          alt=\"Jane Doe\"\n        />\n        <AvatarFallback>JD</AvatarFallback>\n      </Avatar>\n      <Avatar>\n        <AvatarImage\n          src=\"https://images.pexels.com/photos/2379004/pexels-photo-2379004.jpeg?auto=compress&cs=tinysrgb&w=256&h=256&fit=crop\"\n          alt=\"Alex Smith\"\n        />\n        <AvatarFallback>AS</AvatarFallback>\n      </Avatar>\n    </AvatarGroup>\n  </div>\n);\n\nexport default AvatarDemo;\n",
      "path": "src/avatar/examples/avatar-demo.tsx",
      "target": "@components/showcase/avatar/examples/avatar-demo.tsx",
      "type": "registry:component"
    }
  ]
}
