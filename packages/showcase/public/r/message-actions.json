{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "message-actions",
  "type": "registry:block",
  "title": "Message: Actions",
  "description": "Place message-level actions in `MessageFooter`, such as copy, retry, or feedback buttons.",
  "registryDependencies": [
    "@erbium/bubble",
    "@erbium/button",
    "@erbium/copy-button",
    "@erbium/icon",
    "@erbium/message",
    "@erbium/styles"
  ],
  "files": [
    {
      "content": "import { CopyButton } from \"@/registry/erbium/blocks/copy-button\";\nimport { Icon } from \"@/registry/erbium/ui/icon\";\n\nimport { Bubble, BubbleContent } from \"@/registry/erbium/ui/bubble\";\nimport { Button } from \"@/registry/erbium/ui/button\";\nimport { Message, MessageContent, MessageFooter } from \"@/registry/erbium/ui/message\";\n\nexport const MessageActionsDemo = () => (\n  <div className=\"flex w-full max-w-sm flex-col gap-8 py-12\">\n    <Message>\n      <MessageContent>\n        <Bubble variant=\"muted\">\n          <BubbleContent>The install failure is coming from the workspace package.</BubbleContent>\n        </Bubble>\n        <MessageFooter>\n          <CopyButton\n            value=\"The install failure is coming from the workspace package.\"\n            aria-label=\"Copy message\"\n          />\n          <Button variant=\"ghost\" size=\"icon\" aria-label=\"Like\" title=\"Like\">\n            <Icon name=\"thumbs-up\" />\n          </Button>\n          <Button variant=\"ghost\" size=\"icon\" aria-label=\"Dislike\" title=\"Dislike\">\n            <Icon name=\"thumbs-down\" />\n          </Button>\n        </MessageFooter>\n      </MessageContent>\n    </Message>\n    <Message align=\"end\">\n      <MessageContent>\n        <Bubble>\n          <BubbleContent>Okay drop me a link. Taking a look...</BubbleContent>\n        </Bubble>\n        <MessageFooter className=\"gap-related\">\n          <span className=\"font-normal text-error\">Failed to send</span>\n          <Button variant=\"ghost\" size=\"icon-xs\" title=\"Retry\" aria-label=\"Retry\">\n            <Icon name=\"refresh-ccw\" />\n          </Button>\n        </MessageFooter>\n      </MessageContent>\n    </Message>\n  </div>\n);\n",
      "path": "src/message/examples/message-actions.tsx",
      "target": "@components/showcase/message/examples/message-actions.tsx",
      "type": "registry:component"
    },
    {
      "content": "import { MessageActionsDemo } from \"../examples/message-actions\";\n\nconst Example = () => <MessageActionsDemo />;\n\nexport default Example;\n",
      "path": "src/message/variants/actions.tsx",
      "target": "@components/showcase/message/variants/actions.tsx",
      "type": "registry:component"
    }
  ]
}
