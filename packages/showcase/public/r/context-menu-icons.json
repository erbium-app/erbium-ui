{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "context-menu-icons",
  "type": "registry:block",
  "title": "Context Menu: Icons",
  "description": "Combine icons with labels for quick scanning.",
  "registryDependencies": [
    "@erbium/context-menu",
    "@erbium/copy-button",
    "@erbium/icon",
    "@erbium/styles"
  ],
  "files": [
    {
      "path": "src/context-menu/examples/context-menu-icons.tsx",
      "type": "registry:component",
      "target": "@components/showcase/context-menu/examples/context-menu-icons.tsx",
      "content": "import { CopyButton, CopyButtonIcon } from \"@/registry/erbium/blocks/copy-button\";\nimport { Icon } from \"@/registry/erbium/ui/icon\";\n\nimport {\n  ContextMenu,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuItem,\n  ContextMenuSeparator,\n  ContextMenuTrigger,\n  ContextMenuList,\n} from \"@/registry/erbium/ui/context-menu\";\n\nexport function ContextMenuIcons() {\n  return (\n    <ContextMenu>\n      <ContextMenuTrigger className=\"flex aspect-video w-full max-w-xs items-center justify-center rounded-xl border border-dashed bg-surface-panel text-caption\">\n        <span className=\"hidden pointer-fine:inline-block\">Right click here</span>\n        <span className=\"hidden pointer-coarse:inline-block\">Long press here</span>\n      </ContextMenuTrigger>\n      <ContextMenuContent>\n        <ContextMenuList>\n          <ContextMenuGroup>\n            <CopyButton value=\"Erbium UI\" render={<ContextMenuItem />}>\n              <CopyButtonIcon />\n              <span>Copy</span>\n            </CopyButton>\n            <ContextMenuItem>\n              <Icon name=\"scissors\" />\n              Cut\n            </ContextMenuItem>\n            <ContextMenuItem>\n              <Icon name=\"clipboard-paste\" />\n              Paste\n            </ContextMenuItem>\n          </ContextMenuGroup>\n          <ContextMenuSeparator />\n          <ContextMenuGroup>\n            <ContextMenuItem variant=\"error\">\n              <Icon name=\"trash\" />\n              Delete\n            </ContextMenuItem>\n          </ContextMenuGroup>\n        </ContextMenuList>\n      </ContextMenuContent>\n    </ContextMenu>\n  );\n}\n"
    },
    {
      "path": "src/context-menu/variants/icons.tsx",
      "type": "registry:component",
      "target": "@components/showcase/context-menu/variants/icons.tsx",
      "content": "import { ContextMenuIcons } from \"../examples/context-menu-icons\";\n\nconst Example = () => <ContextMenuIcons />;\n\nexport default Example;\n"
    }
  ]
}
