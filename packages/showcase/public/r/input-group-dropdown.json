{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "input-group-dropdown",
  "type": "registry:block",
  "title": "Input Group: Dropdown",
  "description": "Add a dropdown action inside an input group.",
  "dependencies": ["@hugeicons/core-free-icons@^4.3.5", "@hugeicons/react@^1.1.10"],
  "registryDependencies": [
    "@erbium/copy-button",
    "@erbium/dropdown-menu",
    "@erbium/input-group",
    "@erbium/stateful-icon",
    "@erbium/styles"
  ],
  "files": [
    {
      "path": "src/input-group/examples/input-group-dropdown.tsx",
      "type": "registry:component",
      "target": "@components/showcase/input-group/examples/input-group-dropdown.tsx",
      "content": "import { CopyButton, CopyButtonIcon } from \"@/registry/erbium/blocks/copy-button\";\nimport { HugeiconsIcon } from \"@hugeicons/react\";\nimport MoreHorizontalIcon from \"@hugeicons/core-free-icons/MoreHorizontalIcon\";\n\nimport { RotatingChevron } from \"@/registry/erbium/ui/stateful-icon\";\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuTrigger,\n} from \"@/registry/erbium/ui/dropdown-menu\";\nimport {\n  InputGroup,\n  InputGroupAddon,\n  InputGroupButton,\n  InputGroupInput,\n} from \"@/registry/erbium/ui/input-group\";\n\nexport default function InputGroupDropdown() {\n  return (\n    <div className=\"grid w-full max-w-sm gap-4\">\n      <InputGroup>\n        <InputGroupInput placeholder=\"Enter file name\" />\n        <InputGroupAddon align=\"inline-end\">\n          <DropdownMenu>\n            <DropdownMenuTrigger\n              render={\n                <InputGroupButton variant=\"ghost\" aria-label=\"More\" size=\"icon-xs\">\n                  <HugeiconsIcon icon={MoreHorizontalIcon} />\n                </InputGroupButton>\n              }\n            />\n            <DropdownMenuContent align=\"end\">\n              <DropdownMenuItem>Settings</DropdownMenuItem>\n              <CopyButton value=\"/projects/erbium/script.js\" render={<DropdownMenuItem />}>\n                <CopyButtonIcon />\n                <span>Copy path</span>\n              </CopyButton>\n              <DropdownMenuItem>Open location</DropdownMenuItem>\n            </DropdownMenuContent>\n          </DropdownMenu>\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup className=\"[--radius:1rem]\">\n        <InputGroupInput placeholder=\"Enter search query\" />\n        <InputGroupAddon align=\"inline-end\">\n          <DropdownMenu>\n            <DropdownMenuTrigger\n              render={\n                <InputGroupButton\n                  variant=\"ghost\"\n                  className=\"group group/search-menu-trigger pr-1.5! text-xs\"\n                >\n                  Search In... <RotatingChevron className=\"size-3\" />\n                </InputGroupButton>\n              }\n            />\n            <DropdownMenuContent align=\"end\" className=\"[--radius:0.95rem]\">\n              <DropdownMenuItem>Documentation</DropdownMenuItem>\n              <DropdownMenuItem>Blog Posts</DropdownMenuItem>\n              <DropdownMenuItem>Changelog</DropdownMenuItem>\n            </DropdownMenuContent>\n          </DropdownMenu>\n        </InputGroupAddon>\n      </InputGroup>\n    </div>\n  );\n}\n"
    },
    {
      "path": "src/input-group/variants/dropdown.tsx",
      "type": "registry:component",
      "target": "@components/showcase/input-group/variants/dropdown.tsx",
      "content": "import ExampleInputGroupDropdown from \"../examples/input-group-dropdown\";\n\nconst Example = () => (\n  <div className=\"w-full min-w-72 max-w-2xl p-4\">\n    <ExampleInputGroupDropdown />\n  </div>\n);\n\nexport default Example;\n"
    }
  ]
}
