  "files": [
    {
      "content": "import { Avatar, AvatarFallback, AvatarImage } from \"@/registry/erbium/ui/avatar\";\n\nexport const AvatarSizeExample = () => (\n  <div className=\"flex flex-wrap items-center gap-related grayscale\">\n    <Avatar size=\"sm\">\n      <AvatarImage\n        src=\"https://images.pexels.com/photos/1681010/pexels-photo-1681010.jpeg?auto=compress&cs=tinysrgb&w=256&h=256&fit=crop\"\n        alt=\"John Doe\"\n      />\n      <AvatarFallback>JD</AvatarFallback>\n    </Avatar>\n    <Avatar>\n      <AvatarImage\n        src=\"https://images.pexels.com/photos/1681010/pexels-photo-1681010.jpeg?auto=compress&cs=tinysrgb&w=256&h=256&fit=crop\"\n        alt=\"John Doe\"\n      />\n      <AvatarFallback>JD</AvatarFallback>\n    </Avatar>\n    <Avatar size=\"lg\">\n      <AvatarImage\n        src=\"https://images.pexels.com/photos/1681010/pexels-photo-1681010.jpeg?auto=compress&cs=tinysrgb&w=256&h=256&fit=crop\"\n        alt=\"John Doe\"\n      />\n      <AvatarFallback>JD</AvatarFallback>\n    </Avatar>\n  </div>\n);\n",
      "path": "src/avatar/examples/avatar-size.tsx",
      "target": "@components/showcase/avatar/examples/avatar-size.tsx",
      "type": "registry:component"
    }
  ]
}
