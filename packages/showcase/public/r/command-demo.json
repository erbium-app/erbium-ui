{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "command-demo",
  "type": "registry:component",
  "title": "command demo",
  "description": "Erbium command demo example.",
  "dependencies": ["@hugeicons/core-free-icons@^4.3.5", "@hugeicons/react@^1.1.10"],
  "registryDependencies": ["@erbium/command", "@erbium/styles"],
  "files": [
    {
      "path": "src/command/examples/command-demo.tsx",
      "type": "registry:component",
      "target": "@components/showcase/command/examples/command-demo.tsx",
      "content": "import { HugeiconsIcon } from \"@hugeicons/react\";\nimport CalculatorIcon from \"@hugeicons/core-free-icons/CalculatorIcon\";\nimport Calendar01Icon from \"@hugeicons/core-free-icons/Calendar01Icon\";\nimport CreditCardIcon from \"@hugeicons/core-free-icons/CreditCardIcon\";\nimport Settings01Icon from \"@hugeicons/core-free-icons/Settings01Icon\";\nimport SmileIcon from \"@hugeicons/core-free-icons/SmileIcon\";\nimport UserIcon from \"@hugeicons/core-free-icons/UserIcon\";\n\nimport {\n  Command,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n  CommandSeparator,\n  CommandShortcut,\n} from \"@/registry/erbium/ui/command\";\n\nexport default function CommandDemo() {\n  return (\n    <Command className=\"md:min-w-[450px]\">\n      <CommandInput placeholder=\"Type a command or search...\" />\n      <CommandList>\n        <CommandEmpty>No results found.</CommandEmpty>\n        <CommandGroup heading=\"Suggestions\">\n          <CommandItem>\n            <HugeiconsIcon icon={Calendar01Icon} />\n            <span>Calendar</span>\n          </CommandItem>\n          <CommandItem>\n            <HugeiconsIcon icon={SmileIcon} />\n            <span>Search Emoji</span>\n          </CommandItem>\n          <CommandItem disabled>\n            <HugeiconsIcon icon={CalculatorIcon} />\n            <span>Calculator</span>\n          </CommandItem>\n        </CommandGroup>\n        <CommandSeparator />\n        <CommandGroup heading=\"Settings\">\n          <CommandItem>\n            <HugeiconsIcon icon={UserIcon} />\n            <span>Profile</span>\n            <CommandShortcut hotkey=\"Mod+P\" />\n          </CommandItem>\n          <CommandItem>\n            <HugeiconsIcon icon={CreditCardIcon} />\n            <span>Billing</span>\n            <CommandShortcut hotkey=\"Mod+B\" />\n          </CommandItem>\n          <CommandItem>\n            <HugeiconsIcon icon={Settings01Icon} />\n            <span>Settings</span>\n            <CommandShortcut hotkey=\"Mod+S\" />\n          </CommandItem>\n        </CommandGroup>\n      </CommandList>\n    </Command>\n  );\n}\n"
    }
  ]
}
