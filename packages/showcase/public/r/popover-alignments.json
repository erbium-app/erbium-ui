{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "popover-alignments",
  "type": "registry:component",
  "title": "popover alignments",
  "description": "Erbium popover alignments example.",
  "registryDependencies": ["@erbium/button", "@erbium/popover", "@erbium/styles"],
  "files": [
    {
      "path": "src/popover/examples/popover-alignments.tsx",
      "type": "registry:component",
      "target": "@components/showcase/popover/examples/popover-alignments.tsx",
      "content": "import { Button } from \"@/registry/erbium/ui/button\";\nimport { Popover, PopoverContent, PopoverTrigger } from \"@/registry/erbium/ui/popover\";\n\nexport function PopoverAlignments() {\n  return (\n    <>\n      <div className=\"flex gap-section\">\n        <Popover>\n          <PopoverTrigger render={<Button variant=\"outline\" size=\"sm\" />}>Start</PopoverTrigger>\n          <PopoverContent align=\"start\" className=\"w-40\">\n            Aligned to start\n          </PopoverContent>\n        </Popover>\n        <Popover>\n          <PopoverTrigger render={<Button variant=\"outline\" size=\"sm\" />}>Center</PopoverTrigger>\n          <PopoverContent align=\"center\" className=\"w-40\">\n            Aligned to center\n          </PopoverContent>\n        </Popover>\n        <Popover>\n          <PopoverTrigger render={<Button variant=\"outline\" size=\"sm\" />}>End</PopoverTrigger>\n          <PopoverContent align=\"end\" className=\"w-40\">\n            Aligned to end\n          </PopoverContent>\n        </Popover>\n      </div>\n    </>\n  );\n}\n"
    }
  ]
}
