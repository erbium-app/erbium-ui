{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "alert-demo",
  "type": "registry:component",
  "title": "alert demo",
  "description": "Erbium alert demo example.",
  "registryDependencies": ["@erbium/alert", "@erbium/styles"],
  "files": [
    {
      "content": "import { Alert, AlertDescription, AlertTitle } from \"@/registry/erbium/ui/alert\";\n\nexport default function AlertExample() {\n  return (\n    <section className=\"w-full max-w-2xl\">\n      <div className=\"grid gap-3 p-5\">\n        <Alert>\n          <AlertTitle>Workspace connected</AlertTitle>\n          <AlertDescription>\n            The agent can read the app and package files for this task.\n          </AlertDescription>\n        </Alert>\n        <Alert variant=\"info\">\n          <AlertTitle>Plan ready</AlertTitle>\n          <AlertDescription>\n            The agent identified three files to update before writing code.\n          </AlertDescription>\n        </Alert>\n        <Alert variant=\"success\">\n          <AlertTitle>Verification passed</AlertTitle>\n          <AlertDescription>Type checks and 42 tests passed after the changes.</AlertDescription>\n        </Alert>\n        <Alert variant=\"warning\">\n          <AlertTitle>Approval required</AlertTitle>\n          <AlertDescription>\n            The agent needs permission to install a new dependency.\n          </AlertDescription>\n        </Alert>\n        <Alert variant=\"error\">\n          <AlertTitle>Browser preview failed</AlertTitle>\n          <AlertDescription>\n            The preview server did not start. Check the build log and retry.\n          </AlertDescription>\n        </Alert>\n      </div>\n    </section>\n  );\n}\n",
      "path": "src/alert/examples/alert-demo.tsx",
      "target": "@components/showcase/alert/examples/alert-demo.tsx",
      "type": "registry:component"
    }
  ]
}
