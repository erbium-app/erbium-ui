{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "context-menu-submenu",
  "type": "registry:block",
  "title": "Context Menu: Submenu",
  "description": "Use `ContextMenuSub` to nest secondary actions.",
  "registryDependencies": ["@erbium/context-menu", "@erbium/copy-button", "@erbium/styles"],
  "files": [
    {
      "content": "import { CopyButton, CopyButtonIcon } from \"@/registry/erbium/blocks/copy-button\";\nimport {\n  ContextMenu,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuItem,\n  ContextMenuSeparator,\n  ContextMenuShortcut,\n  ContextMenuSub,\n  ContextMenuSubContent,\n  ContextMenuSubTrigger,\n  ContextMenuTrigger,\n  ContextMenuList,\n} from \"@/registry/erbium/ui/context-menu\";\n\nexport default function ContextMenuSubmenuExample() {\n  return (\n    <ContextMenu>\n      <ContextMenuTrigger className=\"flex aspect-video w-full max-w-xs items-center justify-center rounded-xl border border-dashed bg-surface-panel text-caption\">\n        <span className=\"hidden pointer-fine:inline-block\">Right click here</span>\n        <span className=\"hidden pointer-coarse:inline-block\">Long press here</span>\n      </ContextMenuTrigger>\n      <ContextMenuContent>\n        <ContextMenuList>\n          <ContextMenuGroup>\n            <CopyButton value=\"Erbium UI\" render={<ContextMenuItem />}>\n              <CopyButtonIcon />\n              <span>Copy</span>\n              <ContextMenuShortcut hotkey=\"Mod+C\" />\n            </CopyButton>\n            <ContextMenuItem>\n              Cut\n              <ContextMenuShortcut hotkey=\"Mod+X\" />\n            </ContextMenuItem>\n          </ContextMenuGroup>\n          <ContextMenuSub>\n            <ContextMenuSubTrigger>More Tools</ContextMenuSubTrigger>\n            <ContextMenuSubContent>\n              <ContextMenuList>\n                <ContextMenuGroup>\n                  <ContextMenuItem>Save Page...</ContextMenuItem>\n                  <ContextMenuItem>Create Shortcut...</ContextMenuItem>\n                  <ContextMenuItem>Name Window...</ContextMenuItem>\n                </ContextMenuGroup>\n                <ContextMenuSeparator />\n                <ContextMenuGroup>\n                  <ContextMenuItem>Developer Tools</ContextMenuItem>\n                </ContextMenuGroup>\n                <ContextMenuSeparator />\n                <ContextMenuGroup>\n                  <ContextMenuItem variant=\"error\">Delete</ContextMenuItem>\n                </ContextMenuGroup>\n              </ContextMenuList>\n            </ContextMenuSubContent>\n          </ContextMenuSub>\n        </ContextMenuList>\n      </ContextMenuContent>\n    </ContextMenu>\n  );\n}\n",
      "path": "src/context-menu/examples/context-menu-submenu.tsx",
      "target": "@components/showcase/context-menu/examples/context-menu-submenu.tsx",
      "type": "registry:component"
    },
    {
      "content": "import ContextMenuSubmenuExample from \"../examples/context-menu-submenu\";\n\nconst Example = () => <ContextMenuSubmenuExample />;\n\nexport default Example;\n",
      "path": "src/context-menu/variants/submenu.tsx",
      "target": "@components/showcase/context-menu/variants/submenu.tsx",
      "type": "registry:component"
    }
  ]
}
