{
  "name": "@erbium/icons",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-independent SVG assets, icon names, and sprites for Erbium.",
  "files": [
    "svg",
    "src/generated",
    "NOTICE.md",
    "LICENSE.pierre.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/generated/index.d.ts",
      "default": "./src/generated/index.js"
    },
    "./sprite": {
      "types": "./src/generated/sprite.d.ts",
      "default": "./src/generated/sprite.js"
    },
    "./sprite.svg": "./src/generated/sprite.svg",
    "./svg/*": "./svg/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "node scripts/generate.mjs --watch",
    "check": "node scripts/generate.mjs --check"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "svgo": "4.1.0",
    "vite-plus": "catalog:"
  }
}
