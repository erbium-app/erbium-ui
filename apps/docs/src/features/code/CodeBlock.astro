---
import { codeBlockStyles } from "@/styles/content";
import { highlightSource, highlightColorSource } from "@/build/markdown/highlight";

interface Props {
  source: string;
  path: string;
  colorSwatches?: boolean;
  appearance?: "light" | "dark";
}
const { source, path, colorSwatches = false, appearance } = Astro.props;
function formatCodeSource(source: string) {
  const lines = source
    .replace(/^\n+|\n+$/g, "")
    .split("\n")
    .map((line) => line.replace(/[\t ]+$/, ""));
  const indentation = lines
    .filter((line) => line.trim())
    .reduce((minimum, line) => Math.min(minimum, line.match(/^[\t ]*/)?.[0].length ?? 0), Infinity);

  return Number.isFinite(indentation)
    ? lines.map((line) => (line.trim() ? line.slice(indentation) : "")).join("\n")
    : "";
}
const code = formatCodeSource(source);
---

<docs-code-block
  class={codeBlockStyles}
  data-code-appearance={appearance}
  data-copy-label={`Copy ${path.replace(/^src\//, "")}`}
>
  <pre
    class="th-code">
    <code set:html={colorSwatches ? highlightColorSource(code) : highlightSource(code, path)} />
  </pre>
</docs-code-block>

<script>
  import "@/features/code/code-block.client";
</script>
