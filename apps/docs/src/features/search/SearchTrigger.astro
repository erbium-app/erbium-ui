---
import Button from "@/components/primitives/Button.astro";
import Icon from "@/components/primitives/Icon.astro";
import Kbd from "@/components/primitives/Kbd.astro";
---
  <Button variant="outline" class="docs-search-trigger w-60 justify-start text-muted-foreground [&_>_span]:min-w-0 [&_>_span]:flex-1 [&_>_span]:truncate [&_>_span]:text-start max-[1100px]:w-48 max-[1100px]:[&_>_span]:overflow-hidden max-[1100px]:[&_>_span]:text-ellipsis max-[560px]:w-auto max-[560px]:[&_>_span]:hidden max-[560px]:[&_kbd]:hidden" aria-label="Search documentation" aria-haspopup="dialog" aria-controls="docs-search-dialog" data-search-open>
    <Icon name="search-01" />
    <span>Search documentation…</span>
    <Kbd class="shrink-0" aria-label="Command or Control plus K">⌘ K</Kbd>
  </Button>
