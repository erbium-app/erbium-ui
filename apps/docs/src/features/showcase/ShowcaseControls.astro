---
import type { ShowcaseStory } from "@erbium/showcase/catalog";
import { controlRows, displayValue } from "./controls";
import Button from "../../components/primitives/Button.astro";
import Input from "../../components/primitives/Input.astro";
import Select from "../../components/primitives/Select.astro";
import SelectItem from "../../components/primitives/SelectItem.astro";
import Switch from "../../components/primitives/Switch.astro";
import Textarea from "../../components/primitives/Textarea.astro";
import Table from "../../components/primitives/Table.astro";
import TableHeader from "../../components/primitives/TableHeader.astro";
import TableBody from "../../components/primitives/TableBody.astro";
import TableRow from "../../components/primitives/TableRow.astro";
import TableHead from "../../components/primitives/TableHead.astro";
import TableCell from "../../components/primitives/TableCell.astro";
interface Props {
  story: ShowcaseStory;
  id: string;
}
const { story, id } = Astro.props;
const rows = controlRows(story);
---

{
  rows.length > 0 && (
    <showcase-controls
      class="preview-controls block w-full mt-4 border border-transparent rounded-lg overflow-hidden surface-panel"
      data-defaults={JSON.stringify(story.args ?? {})}
    >
      <form aria-labelledby={`${id}-controls-title`}>
        <header class="preview-controls-header flex items-center justify-between gap-4 p-[1rem_1.25rem] carve-bottom [&_h3]:m-0 [&_h3]:text-sm [&_h3]:font-semibold [&_p]:m-[0.25rem_0_0] [&_p]:text-muted-foreground [&_p]:text-xs max-[640px]:p-[1rem_0.75rem]">
          <div>
            <>
              <h3 id={`${id}-controls-title`}>Playground API</h3>
              <p>Explore the props. Changes update the preview above.</p>
            </>
          </div>
          <Button type="reset" variant="outline" size="xs">
            Reset
          </Button>
        </header>
        <Table class="preview-api-table table-fixed text-xs [&_th]:p-[0.625rem_1.25rem] [&_th]:text-muted-foreground [&_th]:[font-size:0.7rem] [&_th:first-child]:w-[42%] [&_th:nth-child(2)]:w-[22%] [&_td]:p-[1rem_1.25rem] [&_td]:align-top [&_td_p]:m-[0.45rem_0_0] [&_td_p]:leading-[1.6] [&_td_p]:text-muted-foreground max-[640px]:[&_th]:p-3 max-[640px]:[&_td]:p-3 max-[640px]:[&_th:first-child]:w-[48%] max-[640px]:[&_th:nth-child(2)]:hidden max-[640px]:[&_td:nth-child(2)]:hidden" aria-label="Playground properties">
          <TableHeader>
            <TableRow>
              <>
                <TableHead scope="col">Property / type</TableHead>
                <TableHead scope="col">Example default</TableHead>
                <TableHead scope="col">Value</TableHead>
              </>
            </TableRow>
          </TableHeader>
          <TableBody>
            {rows.map((row) => {
              const controlId = `${id}-control-${row.name}`;
              const errorId = `${controlId}-error`;
              const editable = Boolean(
                row.options ||
                ["boolean", "object", "text", "number", "range"].includes(
                  row.control || "",
                ),
              );
              const PropertyName = editable ? "label" : "span";
              return (
                <TableRow>
                  <TableCell>
                    <PropertyName
                      for={editable ? controlId : undefined}
                      class="preview-prop-name block w-fit font-medium text-[0.75rem] leading-[1.5] font-mono cursor-pointer"
                    >
                      {row.name}
                    </PropertyName>
                    <code class="preview-prop-type block mt-[0.35rem] text-[0.6875rem] leading-[1.6] font-mono text-muted-foreground wrap-anywhere">{row.type}</code>
                    <span class="preview-mobile-default hidden max-[640px]:block max-[640px]:mt-[0.4rem] max-[640px]:[font-size:0.6875rem] max-[640px]:text-muted-foreground max-[640px]:wrap-anywhere">
                      Default: <code>{displayValue(row.value)}</code>
                    </span>
                    {row.description && (
                      <p id={`${controlId}-description`}>{row.description}</p>
                    )}
                  </TableCell>
                  <TableCell>
                    <code class="preview-default text-[0.6875rem] leading-[1.6] font-mono text-muted-foreground whitespace-pre-wrap wrap-anywhere">
                      {displayValue(row.value)}
                    </code>
                  </TableCell>
                  <TableCell>
                    <div class="preview-control-value grid gap-[0.35rem] min-w-0 [&_[data-slot='input']]:text-xs [&_[data-slot='textarea']]:text-xs [&_[data-slot='textarea']]:font-mono">
                      {row.options ? (
                        <Select
                          id={controlId}
                          name={row.name}
                          aria-label={row.name}
                          aria-describedby={
                            row.description
                              ? `${controlId}-description`
                              : undefined
                          }
                          data-control="select"
                          data-options={JSON.stringify(row.options)}
                        >
                          <SelectItem
                            value=""
                            selected={row.value === undefined}
                          >
                            Unset
                          </SelectItem>
                          {row.options.map((option, index) => (
                            <SelectItem
                              value={String(index)}
                              selected={
                                displayValue(option) === displayValue(row.value)
                              }
                            >
                              {typeof option === "string"
                                ? option
                                : displayValue(option)}
                            </SelectItem>
                          ))}
                        </Select>
                      ) : row.control === "boolean" ? (
                        <div class="preview-boolean flex items-center gap-2.5 min-h-8 [&_output]:text-[0.6875rem] [&_output]:font-mono [&_output]:text-muted-foreground">
                          <Switch
                            id={controlId}
                            name={row.name}
                            checked={Boolean(row.value)}
                            aria-label={row.name}
                            aria-describedby={
                              row.description
                                ? `${controlId}-description`
                                : undefined
                            }
                            data-control="boolean"
                          />
                          <output for={controlId}>
                            {String(Boolean(row.value))}
                          </output>
                        </div>
                      ) : row.control === "object" ? (
                        <>
                          <Textarea
                            id={controlId}
                            name={row.name}
                            value={
                              row.value === undefined
                                ? ""
                                : JSON.stringify(row.value, null, 2)
                            }
                            rows={2}
                            aria-label={row.name}
                            aria-describedby={[
                              row.description ? `${controlId}-description` : "",
                              errorId,
                            ]
                              .filter(Boolean)
                              .join(" ")}
                            data-control="object"
                          />
                          <span
                            id={errorId}
                            class="preview-control-error [font-size:0.6875rem] text-error [&:empty]:hidden"
                            role="status"
                          />
                        </>
                      ) : ["text", "number", "range"].includes(
                          row.control || "",
                        ) ? (
                        <Input
                          id={controlId}
                          name={row.name}
                          type={
                            row.control === "number"
                              ? "number"
                              : row.control === "range"
                                ? "range"
                                : "text"
                          }
                          value={
                            typeof row.value === "string" ||
                            typeof row.value === "number"
                              ? row.value
                              : ""
                          }
                          min={row.constraints?.min}
                          max={row.constraints?.max}
                          step={
                            row.constraints?.step ??
                            (row.control === "number" ? "any" : undefined)
                          }
                          aria-label={row.name}
                          aria-describedby={
                            row.description
                              ? `${controlId}-description`
                              : undefined
                          }
                          data-control={row.control}
                        />
                      ) : (
                        <span class="preview-readonly block py-[0.35rem] text-muted-foreground [font-size:0.6875rem]" id={controlId}>
                          {row.type === "callback"
                            ? "Event callback"
                            : "Read only"}
                        </span>
                      )}
                    </div>
                  </TableCell>
                </TableRow>
              );
            })}
          </TableBody>
        </Table>
      </form>
    </showcase-controls>
  )
}
<script>
  import "./controls.client";
</script>
