---
import Prose from "@/components/content/Prose.astro";
import { loadShowcase, type ShowcaseStory } from "@erbium/showcase/catalog";
import ShowcaseControls from "@/features/showcase/ShowcaseControls.astro";
import Icon from "@/components/primitives/Icon.astro";
import Add01Icon from "@hugeicons/core-free-icons/Add01Icon";
import Link01Icon from "@hugeicons/core-free-icons/Link01Icon";
import CodeBlock from "@/features/code/CodeBlock.astro";
import Separator from "@/components/primitives/Separator.astro";
import ShowcaseTabs from "@/features/showcase/ShowcaseTabs.tsx";
import ShowcaseThemeToggle from "@/features/showcase/ShowcaseThemeToggle.astro";
import CopyButton from "@/features/code/CopyButton.astro";
import ComponentPreview from "@/features/showcase/ComponentPreview.tsx";
import Spinner from "@/components/primitives/Spinner.astro";
interface Props {
  name: string;
  variant: string;
  slug: string;
  anchorId?: string;
  separator?: boolean;
  title: string;
  source: string;
  files: { path: string; source: string }[];
}
const { name, variant, slug, title, source, files } = Astro.props;
const anchorId = Astro.props.anchorId ?? slug;
const id = `${name}-${slug}`;
const sources = files.length ? files : [{ path: `${slug}.tsx`, source }];
const catalog = await loadShowcase(name);
const story = catalog[variant] as ShowcaseStory;
const command = `npx shadcn@latest add @erbium-examples/${name}-${slug}`;
---

<section id={anchorId} class="demo-section my-10 scroll-mt-8 [&_>_h2]:m-[0_0_0.5rem] [&_>_h2]:text-title [&_>_h2]:font-semibold  [&_>_h2_a:hover_.heading-anchor]:inline-flex [&_>_h2_a:hover_.heading-anchor]:align-middle [&_>_h2_a:hover_.heading-anchor]:opacity-100 [&_>_h2_a:focus-visible_.heading-anchor]:inline-flex [&_>_h2_a:focus-visible_.heading-anchor]:align-middle [&_>_h2_a:focus-visible_.heading-anchor]:opacity-100">
  {Astro.props.separator !== false && <Separator class="showcase-header-separator mb-4" variant="full" decorative />}
  <h2>
    <a href={`#${anchorId}`}
      >{title}<span class="heading-anchor inline-flex align-middle opacity-0 ms-2 text-muted-foreground font-normal" aria-hidden="true"
        ><Icon icon={Link01Icon} size={14} /></span
      ></a
    >
  </h2>
  <Prose as="div" class="variant-description [text-wrap-style:pretty] text-muted-foreground text-control [&_p]:m-[0.5rem_0_0.8rem]"><slot /></Prose>
  <showcase-tabs class="showcase">
    <div class="showcase-toolbar flex items-center justify-between pb-[0.65rem]">
      <ShowcaseTabs id={id} title={title} client:load />
    </div>
    <div
      id={`${id}-preview`}
      role="tabpanel"
      aria-labelledby={`${id}-preview-tab`}
      data-panel="preview"
      class="component-demo surface-field [--surface-face:var(--surface-canvas)] relative flex flex-col items-center justify-center min-h-64 p-0 border border-transparent rounded-lg text-foreground overflow-auto"
      tabindex="0"
    >
      <div class="showcase-preview-actions flex items-center gap-1 absolute top-2 end-2 z-1 rounded-sm bg-surface-canvas">
        <ShowcaseThemeToggle />
      </div>
      <div class="showcase-content flex flex-col items-center justify-center gap-section w-full min-h-64 p-0 bg-surface-canvas text-foreground max-[560px]:p-[1.25rem_0.75rem]" data-showcase-content data-preview-name={name} data-preview-slug={slug}>
        <ComponentPreview name={name} slug={slug} args={JSON.parse(JSON.stringify(story.args ?? {}))} client:visible={{ rootMargin: "200px" }}>
          <Spinner slot="loading" aria-label="Loading preview" />
        </ComponentPreview>
      </div>
    </div>
    <div
      id={`${id}-code`}
      role="tabpanel"
      aria-labelledby={`${id}-code-tab`}
      data-panel="code"
      class="showcase-code grid gap-group min-w-0"
      tabindex="0"
      hidden
    >
      {
        sources.map((file) => (
          <CodeBlock source={file.source} path={file.path} />
        ))
      }
    </div>
    <ShowcaseControls story={story} id={id} />
  </showcase-tabs>
  <details class="install-example mt-3 text-metadata text-muted-foreground [&_summary]:flex [&_summary]:w-fit [&_summary]:gap-3 [&_summary]:items-center [&_summary]:cursor-pointer [&_summary]:list-none [&_summary]:py-[0.3rem] [&_summary::-webkit-details-marker]:hidden [&[open]_summary_>_span]:[transform:rotate(45deg)] [&_summary:focus-visible]:[outline:2px_solid_var(--ring)] [&_summary:focus-visible]:[outline-offset:3px]">
    <summary
      >Install this example <span aria-hidden="true"
        ><Icon icon={Add01Icon} size={14} /></span
      ></summary
    ><div class="install-command surface-field [--surface-face:var(--surface-canvas)] flex items-center justify-between gap-3 p-[0.7rem_1rem] border border-transparent rounded-md mt-2 text-foreground [&_code]:flex-1 [&_code]:min-w-0 [&_code]:whitespace-nowrap [&_code]:overflow-auto [&_code]:text-metadata  [&_code]:font-mono">
      <code id={`${id}-install`}>{command}</code><CopyButton
        iconOnly
        target={`${id}-install`}
        label="Copy installation command"
      />
    </div>
  </details>
</section>
<script>
  import "@/features/showcase/tabs.client";
</script>
