---
import SiteLayout from "./SiteLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
interface Props {
  title?: string;
  description?: string;
  headings?: { depth: number; slug: string; text: string }[];
}
const { headings = [], ...siteProps } = Astro.props;
---

<SiteLayout {...siteProps}>
    <div class="docs-page-frame">
      <main id="main-content" tabindex="-1" class="docs-page">
        <div class="docs-page-body">
          {headings.length > 0 && <TableOfContents headings={headings} />}
          <div class="docs-page-inner"><slot /></div>
        </div>
      </main>
    </div>
</SiteLayout>
