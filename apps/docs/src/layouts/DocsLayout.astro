---
import SiteLayout from "./SiteLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
interface Props {
  title?: string;
  description?: string;
  headings?: { depth: number; slug: string; text: string }[];
}
const { headings = [], ...siteProps } = Astro.props;
---

<SiteLayout {...siteProps}>
    <div class="docs-page-frame min-w-0 my-[var(--site-section-space)]">
      <main id="main-content" tabindex="-1" class="docs-page surface-panel border border-transparent min-w-0 rounded-xl p-[var(--docs-page-padding-start)_var(--docs-page-padding-inline)_var(--docs-page-padding-end)] max-[959px]:bg-transparent max-[959px]:shadow-none max-[959px]:border-0 max-[959px]:rounded-none">
        <div class="docs-page-body min-w-0 grid [grid-template-columns:minmax(0,_1fr)_11rem] items-start gap-12 [&_>_.docs-page-inner]:[grid-column:1] [&_>_.docs-page-inner]:[grid-row:1] max-[1200px]:flex max-[1200px]:flex-col max-[1200px]:gap-6">
          {headings.length > 0 && <TableOfContents headings={headings} />}
          <div class="docs-page-inner w-full max-w-192 mx-auto min-w-0 max-[959px]:max-w-none"><slot /></div>
        </div>
      </main>
    </div>
</SiteLayout>
