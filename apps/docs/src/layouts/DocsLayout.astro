---
import SidebarProvider from "../components/ui/sidebar/SidebarProvider.astro";
import SiteLayout from "./SiteLayout.astro";
import DocsSidebar from "../components/shell/DocsSidebar.astro";
interface Props {
  title?: string;
  description?: string;
}
---

<SiteLayout {...Astro.props}>
  <SidebarProvider class="docs-frame site-container">
    <DocsSidebar />
    <div class="docs-page-frame">
      <main id="main-content" tabindex="-1" class="docs-page surface-panel">
        <div class="docs-page-inner"><slot /></div>
      </main>
    </div>
  </SidebarProvider>
</SiteLayout>
