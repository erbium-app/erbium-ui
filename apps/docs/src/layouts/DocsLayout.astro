---
import { components, componentGroups } from "../data/components";
import ComponentSearch from "../components/ComponentSearch.tsx";
interface Props { title?: string; description?: string; }
const { title = "Erbium UI", description = "Composable React primitives for thoughtful interfaces." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · Erbium UI</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/"><span class="brand-mark">e</span><span>erbium <small>ui</small></span></a>
      <div class="topbar-actions"><ComponentSearch client:load components={components} /><a href="https://github.com/erbium-app/erbium-ui" class="github-link">GitHub ↗</a></div>
    </header>
    <div class="docs-frame">
      <aside class="sidebar">
        <a class="back-link" href="/">← Overview</a>
        <nav aria-label="Documentation">
          <p class="nav-label">Explore</p>
          <a class:list={{ "nav-link": true, active: Astro.url.pathname === "/docs" }} href="/docs">Introduction</a>
          <a class="nav-link" href="/docs/installation">Installation</a>
          <p class="nav-label">Utilities</p>
          <a class:list={{ "nav-link": true, active: Astro.url.pathname === "/docs/utilities/scroll-fade" }} href="/docs/utilities/scroll-fade">Scroll Fade</a>
          <p class="nav-label">Components</p>
          {componentGroups.map((group) => <div class="nav-group"><p class="group-label">{group.label}</p>{group.names.map((name) => { const component = components.find((item) => item.name === name); return component && <a class:list={{ "nav-link": true, active: Astro.url.pathname === `/docs/components/${name}` }} href={`/docs/components/${name}`}>{component.title}</a>; })}</div>)}
          <p class="nav-label">All components</p>
          <div class="all-components">{components.filter((item) => !componentGroups.some((group) => group.names.includes(item.name))).map((component) => <a class="nav-link" href={`/docs/components/${component.name}`}>{component.title}</a>)}</div>
        </nav>
      </aside>
      <main class="main-content"><slot /></main>
    </div>
  </body>
</html>
<style is:global>
  @import "@erbium/ui/globals.css";
  @import "../styles/docs.css";
  :root { --docs-ink: #171717; --docs-muted: #737373; --docs-line: #e7e5e4; --docs-accent: #c2410c; }
  * { box-sizing: border-box; }
  body { margin: 0; color: var(--docs-ink); background: #fafaf9; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  a { color: inherit; text-decoration: none; }
  .topbar { height: 4.25rem; display: flex; align-items: center; justify-content: space-between; padding: 0 2.5rem; border-bottom: 1px solid var(--docs-line); background: color-mix(in srgb, #fafaf9 92%, transparent); position: sticky; top: 0; z-index: 10; backdrop-filter: blur(14px); }
  .brand { display: inline-flex; align-items: center; gap: .6rem; font-weight: 650; letter-spacing: -.02em; }.brand small { color: var(--docs-muted); font-size: .7em; font-weight: 500; }.brand-mark { display: grid; place-items: center; width: 1.8rem; height: 1.8rem; border-radius: .55rem; background: #171717; color: white; font-family: Georgia, serif; font-size: 1.25rem; font-style: italic; }
  .topbar-actions { display:flex; align-items:center; gap:1.25rem; }.github-link { color: var(--docs-muted); font-size: .875rem; }.github-link:hover { color: var(--docs-ink); }
  .docs-frame { display: grid; grid-template-columns: 16rem minmax(0, 1fr); min-height: calc(100vh - 4.25rem); max-width: 1440px; margin: 0 auto; }.sidebar { border-right: 1px solid var(--docs-line); padding: 2rem 1.25rem; }.back-link { display: block; color: var(--docs-muted); font-size: .8rem; margin: 0 .75rem 2rem; }.back-link:hover { color: var(--docs-ink); }.nav-label, .group-label { color: #a8a29e; font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; margin: 1.75rem .75rem .5rem; }.group-label { color: #a8a29e; font-size: .7rem; letter-spacing: .02em; text-transform: none; margin: 1rem .75rem .2rem; }.nav-link { display:block; border-radius: .45rem; padding: .4rem .75rem; color: var(--docs-muted); font-size: .82rem; }.nav-link:hover, .nav-link.active { color: var(--docs-ink); background: #f0eeeb; }.nav-link.active { font-weight: 600; color: var(--docs-accent); }.main-content { min-width: 0; padding: 4.5rem clamp(1.5rem, 7vw, 7rem); max-width: 1040px; width: 100%; }.all-components { max-height: 28rem; overflow: auto; }
  @media (max-width: 760px) { .topbar { padding: 0 1rem; }.github-link { display:none; }.docs-frame { display:block; }.sidebar { display:none; }.main-content { padding: 2.5rem 1.25rem; } }
</style>
