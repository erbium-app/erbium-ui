---
import { markdownPath } from "../lib/agent-pages";
import { ogPageForRoute, ogSize, plainText } from "../lib/og-pages";
import { lightColors, showcaseLightThemeCss } from "../lib/semantic-colors";
import { syntaxThemeCss } from "../lib/highlight-theme.mjs";
import SiteHeader from "../components/shell/SiteHeader.astro";
import "../styles/docs.css";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Erbium UI",
  description = "Accessible React components that you can customize and own.",
} = Astro.props;
const pageTitle = title === "Erbium UI" ? title : `${title} · Erbium UI`;
const socialPage = ogPageForRoute(Astro.url.pathname);
const canonicalUrl = new URL(socialPage.route, Astro.site);
const imageUrl = new URL(socialPage.imagePath, Astro.site);
const socialDescription = plainText(description);
const imageAlt = `${socialPage.title} — Erbium UI ${socialPage.section}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <style is:inline set:html={syntaxThemeCss + "\n" + showcaseLightThemeCss}></style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={socialDescription} />
    <meta name="theme-color" content={lightColors.background} />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Erbium UI" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={ogSize.width} />
    <meta property="og:image:height" content={ogSize.height} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link
      rel="alternate"
      type="text/markdown"
      href={markdownPath(Astro.url.pathname.replace(/\/$/, "") || "/")}
      title="Markdown"
    />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="Agent documentation index"
    />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link id="site-favicon" rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const preference = localStorage.getItem("erbium-theme");
        document.documentElement.classList.toggle(
          "dark",
          preference
            ? preference === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches,
        );
      } catch {
        document.documentElement.classList.toggle(
          "dark",
          window.matchMedia("(prefers-color-scheme: dark)").matches,
        );
      }
      document.getElementById("site-favicon").setAttribute(
        "href",
        document.documentElement.classList.contains("dark")
          ? "/brand/erbium-logo-dark.svg"
          : "/brand/erbium-logo-light.svg",
      );
      document.querySelector('meta[name="theme-color"]').setAttribute(
        "content",
        getComputedStyle(document.documentElement).getPropertyValue("--background").trim(),
      );
    </script>
  </head>
  <body><a href="#main-content" class="skip-link">Skip to content</a><SiteHeader /><slot /></body>
</html>
<script>
  import "../components/code-block";
</script>
