---
import SiteHeader from "../components/shell/SiteHeader.astro";
import "../styles/docs.css";
interface Props { title?: string; description?: string; }
const { title = "Erbium UI", description = "Accessible React components that you can customize and own." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1c6b48" />
    <title>{title} · Erbium UI</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const preference = localStorage.getItem("erbium-theme");
        document.documentElement.classList.toggle("dark", preference ? preference === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches);
      } catch { document.documentElement.classList.toggle("dark", window.matchMedia("(prefers-color-scheme: dark)").matches); }
    </script>
  </head>
  <body><a href="#main-content" class="skip-link">Skip to content</a><SiteHeader /><slot /></body>
</html>
