---
import { structuredData } from "../lib/structured-data";
import { siteName, siteDescription } from "../lib/site-config";
import { themeInitScript } from "../lib/theme-init";
import { ClientRouter } from "astro:transitions";
import { markdownPath } from "../lib/agent-pages";
import { ogPageForRoute, ogSize, plainText } from "../lib/og-pages";
import { lightColors, showcaseLightThemeCss } from "../lib/semantic-colors";
import { syntaxThemeCss } from "../lib/highlight-theme.mjs";
import SidebarProvider from "../components/ui/sidebar/SidebarProvider.astro";
import DocsSidebar from "../components/shell/DocsSidebar.astro";
import Brand from "../components/shell/Brand.astro";
import MobileNavigation from "../components/shell/MobileNavigation.astro";
import "../styles/docs.css";
interface Props {
  title?: string;
  description?: string;
  indexable?: boolean;
  shell?: "docs" | "standalone";
}
const {
  title = siteName,
  description = siteDescription,
  indexable = true,
  shell = "docs",
} = Astro.props;
const pageTitle = Astro.url.pathname === "/" ? `${siteName} · Accessible React components` : `${title} · ${siteName}`;
const socialPage = ogPageForRoute(indexable ? Astro.url.pathname : "/");
const canonicalUrl = new URL(socialPage.route, Astro.site);
const imageUrl = new URL(socialPage.imagePath, Astro.site);
const socialDescription = plainText(description);
const imageAlt = `${socialPage.title} — Erbium UI ${socialPage.section}`;
const analyticsToken = import.meta.env.PROD
  ? import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN
  : undefined;
---

<!doctype html>
<html class="[scrollbar-gutter:stable] scroll-pt-8 [font-optical-sizing:auto] antialiased has-[.docs-search-dialog[open]]:overflow-hidden has-[.mobile-navigation-panel[open]]:overflow-hidden" lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={socialDescription} />
    <meta name="robots" content={indexable ? "index, follow, max-image-preview:large" : "noindex, follow"} />
    <meta name="theme-color" content={lightColors.background} />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Erbium UI" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={socialDescription} />
    {indexable && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={ogSize.width} />
    <meta property="og:image:height" content={ogSize.height} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {indexable && <link
      rel="alternate"
      type="text/markdown"
      href={markdownPath(Astro.url.pathname.replace(/\/$/, "") || "/")}
      title="Markdown"
    />}
    <link
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="Agent documentation index"
    />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {indexable && <link rel="canonical" href={canonicalUrl} />}
    {indexable && <script type="application/ld+json" is:inline set:html={structuredData(socialPage.route, title, socialDescription, imageUrl.href)} />}
    <link
      id="site-favicon"
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    />
    <ClientRouter fallback="swap" />
    <style is:inline set:html={syntaxThemeCss + "\n" + showcaseLightThemeCss}
    ></style>
    <script is:inline set:html={themeInitScript} />
  </head>
  <body class="m-0 font-sans wrap-anywhere break-normal max-[959px]:bg-surface-panel">
    <a href="#main-content" class="skip-link fixed top-2 start-4 z-100 p-[0.6rem_1rem] bg-primary text-primary-foreground rounded-md [transform:translateY(-150%)] [&:focus]:[transform:translateY(0)]"> Skip to content </a>
    {shell === "standalone" ? <slot /> : <div class="site-shell ms-[max(var(--site-gutter),_calc((100%_-_var(--site-max-width))_/_2))] me-[var(--site-gutter)]">
      <header class="mobile-site-header hidden max-[959px]:text-foreground max-[959px]:flex max-[959px]:items-center max-[959px]:justify-between max-[959px]:gap-4 max-[959px]:py-3 max-[959px]:[&_>_mobile-navigation_>_button]:w-11 max-[959px]:[&_>_mobile-navigation_>_button]:h-11">
        <Brand />
        <MobileNavigation />
      </header>
      <SidebarProvider class="docs-frame grid [grid-template-columns:var(--sidebar-width)_minmax(0,_1fr)] items-start gap-[var(--site-column-gap)] min-h-[100svh] max-[959px]:block">
        <DocsSidebar />
        <div class="site-page-content min-w-0" transition:name="docs-content" transition:animate="none"><slot /></div>
      </SidebarProvider>
    </div>}
    {analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      ></script>
    )}
  </body>
</html>
<script>
  import "../components/code-block";

</script>
