---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { Content, frontmatter } from "@erbium/content/shimmer.md";
---
<DocsLayout title={frontmatter.title} description={frontmatter.description}>
  <article class="markdown-copy"><Content /></article>
  <div class="shimmer-demo" aria-label="Shimmer text preview"><p class="shimmer text-muted-foreground">Generating response…</p></div>
</DocsLayout>
<style>.shimmer-demo { display:grid; min-height:8rem; place-items:center; margin-top:2rem; border:1px solid var(--docs-line); border-radius:.8rem; background:var(--background); }</style>
