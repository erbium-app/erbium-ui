---
import DocsLayout from "../../layouts/DocsLayout.astro";
import ComponentPreview from "../../components/ComponentPreview.tsx";
import { Content, frontmatter } from "@erbium/content/introduction.md";
---
<DocsLayout title="Documentation" description={frontmatter.description}>
  <article class="markdown-copy"><h1>{frontmatter.title}</h1><Content /></article>
  <div class="sampler">
    <ComponentPreview name="card" client:load />
    <ComponentPreview name="input" client:load />
    <ComponentPreview name="switch" client:load />
  </div>
</DocsLayout>
<style>
.sampler { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,16rem),1fr)); gap:1rem; }
</style>
