---
import DocsLayout from "../../layouts/DocsLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { Content, frontmatter } from "@erbium/content/installation.md";
---
<DocsLayout title={frontmatter.title} description={frontmatter.description}>
  <PageHeader title={frontmatter.title} description={frontmatter.description} category="Getting started" previous={{ title: "Introduction", href: "/docs" }} next={{ title: "Components", href: "/docs/components" }} />
  <article class="markdown-copy"><Content /></article>
</DocsLayout>
