---
import { proseStyles } from "../../lib/docs-styles";
import DocsLayout from "../../layouts/DocsLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { Content, frontmatter, getHeadings } from "@erbium/content/installation.md";
---
<DocsLayout title={frontmatter.title} description={frontmatter.description} headings={getHeadings()}>
  <PageHeader title={frontmatter.title} description={frontmatter.description} previous={{ title: "Introduction", href: "/" }} next={{ title: "Using components", href: "/docs/getting-started" }} />
  <article class={proseStyles}><Content /></article>
</DocsLayout>
