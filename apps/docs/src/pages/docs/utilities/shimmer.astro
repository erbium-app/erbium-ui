---
import { proseStyles } from "../../../lib/docs-styles";
import PageHeader from "../../../components/PageHeader.astro";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import { Content, frontmatter } from "@erbium/content/shimmer.md";
---
<DocsLayout title={frontmatter.title} description={frontmatter.description}>
  <PageHeader title={frontmatter.title} description={frontmatter.description} />
  <article class:list={[proseStyles, 'shimmer-copy']}><Content /></article>
  <div class="grid min-h-32 place-items-center mt-8 border border-border rounded-lg bg-background" aria-label="Shimmer text preview"><p class="shimmer text-muted-foreground">Generating response…</p></div>
</DocsLayout>
