---
import DocsLayout from "../layouts/DocsLayout.astro";
import ComponentPreview from "../components/ComponentPreview.tsx";
import { components } from "../data/components";
---
<DocsLayout title="A calmer way to build interfaces" description="Erbium UI is a small, accessible component system for React.">
  <section class="hero">
    <p class="eyebrow">The Erbium component library</p>
    <h1>Interfaces with a little more <em>care.</em></h1>
    <p class="lede">Accessible, composable React primitives with a focused visual language. Copy the source, make it yours, and ship something considered.</p>
    <div class="hero-actions"><a class="button button-primary" href="/docs">Read the docs <span>→</span></a><a class="button button-secondary" href="/docs/components/button">Browse components</a></div>
  </section>
  <section class="showcase-section"><div class="section-heading"><div><p class="eyebrow">Built from the source</p><h2>A toolkit, not a black box.</h2></div><span class="component-count">{components.length} components</span></div><div class="showcase-card"><div class="showcase-copy"><span class="mini-label">A small sample</span><h3>Simple defaults. Sharp edges where they matter.</h3><p>Every component is built on accessible primitives and ships with its source. The docs are a workbench for exploring the details.</p><a href="/docs/components/button">Explore Button →</a></div><div class="showcase-demo"><ComponentPreview name="button" client:load /></div></div></section>
</DocsLayout>
<style>
  .hero { max-width: 47rem; padding: 3rem 0 7rem; }.eyebrow, .mini-label { color: #c2410c; font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }.hero h1 { max-width: 42rem; margin: 1rem 0; font-size: clamp(3.2rem, 7vw, 6.4rem); line-height: .96; letter-spacing: -.075em; font-weight: 650; }.hero h1 em { color: #c2410c; font-family: Georgia, serif; font-weight: 400; }.lede { max-width: 34rem; color: #737373; font-size: 1.12rem; line-height: 1.7; }.hero-actions { display:flex; gap:.65rem; margin-top:2rem; }.button { display:inline-flex; align-items:center; gap:.7rem; border-radius:.55rem; padding:.7rem 1rem; font-size:.82rem; font-weight:600; }.button-primary { color:#fff; background:#171717; }.button-primary:hover { background:#c2410c; }.button-secondary { border:1px solid #d6d3d1; background:#fff; }.showcase-section { border-top:1px solid #e7e5e4; padding-top:2.5rem; }.section-heading { display:flex; align-items:end; justify-content:space-between; }.section-heading h2 { margin:.5rem 0 1.5rem; font-size:1.6rem; letter-spacing:-.04em; }.component-count { color:#a8a29e; font-size:.78rem; margin-bottom:1.8rem; }.showcase-card { display:grid; grid-template-columns: .85fr 1.15fr; overflow:hidden; border:1px solid #e7e5e4; border-radius:1rem; background:white; }.showcase-copy { padding:2rem; }.showcase-copy h3 { max-width:14rem; margin:.8rem 0; font-size:1.45rem; line-height:1.15; letter-spacing:-.04em; }.showcase-copy p { color:#737373; font-size:.88rem; line-height:1.6; }.showcase-copy a { display:inline-block; color:#c2410c; margin-top:1rem; font-size:.82rem; font-weight:600; }.showcase-demo { display:grid; place-items:center; min-height:17rem; padding:2rem; background:#f5f5f4; background-image: radial-gradient(#d6d3d1 1px, transparent 1px); background-size: 16px 16px; }
  @media (max-width: 700px) { .hero { padding-top:1rem; padding-bottom:4rem; }.hero h1 { font-size:3.7rem; }.showcase-card { grid-template-columns:1fr; }.showcase-demo { min-height:12rem; } }
</style>
