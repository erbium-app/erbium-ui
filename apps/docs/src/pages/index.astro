---
import DocsLayout from "../layouts/DocsLayout.astro";
import ComponentPreview from "../components/ComponentPreview.tsx";
import { Content, frontmatter } from "@erbium/content/overview.md";
---
<DocsLayout title={frontmatter.title} description={frontmatter.description}>
  <article class="markdown-copy hero"><Content /></article>
  <div class="showcase-demo"><ComponentPreview name="button" client:load /></div>
</DocsLayout>
<style>
.hero { max-width: 47rem; padding: 2rem 0; }
.hero :global(h1) { max-width:42rem; font-size:clamp(3.2rem,7vw,6.4rem); line-height:.96; letter-spacing:-.075em; font-weight:650; }
.hero :global(p) { max-width:34rem; font-size:1.12rem; }
.showcase-demo { display:grid; place-items:center; min-height:17rem; padding:2rem; border:1px solid var(--docs-line); border-radius:1rem; background:var(--background); }
</style>
