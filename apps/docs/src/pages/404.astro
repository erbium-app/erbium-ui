---
import DocumentLayout from "../layouts/DocumentLayout.astro";
import Brand from "../components/shell/Brand.astro";
import ThemeToggle from "../components/shell/ThemeToggle.astro";
import Button from "../components/primitives/Button.astro";
---

<DocumentLayout
  title="Page not found"
  description="This documentation page could not be found."
  indexable={false}
>
  <div class="min-h-svh flex flex-col">
    <header class="flex items-center justify-between px-[clamp(1.25rem,4vw,4rem)] py-6">
      <Brand />
      <ThemeToggle />
    </header>
    <main id="main-content" tabindex="-1" class="flex-1 grid place-items-center px-6 pt-12 pb-28">
      <div class="w-full max-w-120">
        <header class="page-header mb-4 [&_h1]:min-w-0 [&_h1]:wrap-anywhere [&_h1]:m-0 [&_h1]:text-foreground [&_h1]:text-3xl [&_h1]:font-bold [&_h1]:leading-[1.2] [&_h1]:tracking-[normal] min-[1280px]:[&_h1]:text-4xl min-[1280px]:[&_h1]:leading-[1.1111] [&_+_.demo-section]:mt-4">
          <h1>Page not found</h1>
          <p class="page-description [text-wrap-style:pretty] max-w-168 mt-[0.65rem] text-lg leading-[1.5556] text-muted-foreground max-[560px]:[font-size:0.9375rem]">
            This page may have moved or been removed. Let’s get you back to the
            docs.
          </p>
        </header>
        <div class="flex flex-wrap gap-3 mt-8">
          <Button href="/">Back to home</Button>
        </div>
      </div>
    </main>
  </div>
</DocumentLayout>
