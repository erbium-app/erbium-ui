---
import { documentationSections, type DocumentationKind } from "../data/documentation-sections";
import { components } from "../data/components";
import {
  Content as HooksContent,
  frontmatter as hooksFrontmatter,
} from "@erbium/content/hooks.md";
import { Content as FoundationsContent, frontmatter as foundationsFrontmatter } from "@erbium/content/foundations.md";
import { Content as ProvidersContent, frontmatter as providersFrontmatter } from "@erbium/content/providers.md";
import { Content as UtilitiesContent, frontmatter as utilitiesFrontmatter } from "@erbium/content/utilities.md";
import { Content as BlocksContent, frontmatter as blocksFrontmatter } from "@erbium/content/blocks.md";
import DocsLayout from "../layouts/DocsLayout.astro";
import PageHeader from "./PageHeader.astro";
interface Props {
  kind: Exclude<DocumentationKind, "component">;
}
const { kind } = Astro.props;
const documents = {
  block: { Content: BlocksContent, frontmatter: blocksFrontmatter },
  hook: { Content: HooksContent, frontmatter: hooksFrontmatter },
  foundation: { Content: FoundationsContent, frontmatter: foundationsFrontmatter },
  provider: { Content: ProvidersContent, frontmatter: providersFrontmatter },
  utility: { Content: UtilitiesContent, frontmatter: utilitiesFrontmatter },
};
const { frontmatter, Content } = documents[kind];
const groups = documentationSections.filter((section) => section.kind === kind).map((section) => ({
  ...section,
  items: [
    ...section.names.map((name) => components.find((item) => item.name === name)!),
    ...(kind === "utility" ? [{ title: "Shimmer", href: "/docs/utilities/shimmer" }] : []),
  ].sort((a, b) => a.title.localeCompare(b.title)),
}));
---

<DocsLayout title={frontmatter.title} description={frontmatter.description}>
  <PageHeader
    title={frontmatter.title}
    description={frontmatter.description}
  />
  <article class="markdown-copy directory-intro"><Content /></article>
  {groups.map((group) => <section id={group.slug} class="directory-section">
    <div class="documentation-directory">{group.items.map((item) => <a href={item.href} class="directory-item"><div class="directory-item-copy"><h3>{item.title}</h3></div></a>)}</div>
  </section>)}
</DocsLayout>
