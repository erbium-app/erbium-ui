---
import { proseStyles } from "../lib/docs-styles";
import { componentDocuments } from "@erbium/content/documents";
import theme from "../../../../packages/ui/src/styles/theme.css?raw";
import surfaces from "../../../../packages/ui/src/styles/surfaces.css?raw";
import DocsLayout from "../layouts/DocsLayout.astro";
import PageHeader from "./PageHeader.astro";
import CodeBlock from "./CodeBlock.astro";
import { colorPreviewSyntaxThemeCss } from "../lib/highlight-theme.mjs";

const page = componentDocuments["../components/colors/index.md"];
const { Content, frontmatter } = page;
function block(source: string, selector: string) {
  const start = source.indexOf(`${selector} {`);
  return source.slice(start, source.indexOf("\n}", start) + 2);
}
const colorPreviewThemeCss = ["light", "dark"].map((appearance) =>
  [theme, surfaces].map((source) =>
    block(source, appearance === "light" ? ":root" : ".dark")
      .replace(appearance === "light" ? ":root" : ".dark", `[data-code-appearance="${appearance}"]`),
  ).join("\n"),
).join("\n");
const examples = [
  { id: "light-colors", title: "Light colors", appearance: "light" as const, source: block(theme, ":root") },
  { id: "dark-colors", title: "Dark colors", appearance: "dark" as const, source: block(theme, ".dark") },
  { id: "surface-colors", title: "Surface colors", source: `${block(surfaces, ":root")}\n\n${block(surfaces, ".dark")}` },
  { id: "tailwind-mappings", title: "Tailwind mappings", source: `${block(theme, "@theme inline")}\n\n${block(surfaces, "@theme inline")}` },
];
const headings = [...await page.getHeadings(), ...examples.map(({ id, title }) => ({ depth: 2, slug: id, text: title }))];
---
<DocsLayout title="Colors" description={frontmatter.description} headings={headings}>
  <PageHeader title="Colors" description={frontmatter.description} next={{ title: "Surfaces", href: "/docs/foundations/surfaces" }} />
  <article class:list={[proseStyles, 'component-documentation [&[data-repeated-summary]_>_p:first-child]:hidden']}><Content /></article>
  <style is:inline set:html={colorPreviewThemeCss + "\n" + colorPreviewSyntaxThemeCss} />
  {examples.map(({ id, title, source, appearance }) => <section class={proseStyles} aria-labelledby={id}>
    <h2 id={id}>{title}</h2>
    <CodeBlock source={source} path={`${id}.css`} appearance={appearance} colorSwatches />
  </section>)}
</DocsLayout>
