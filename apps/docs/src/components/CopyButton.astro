---
import Button from "./ui/Button.astro";
import StatefulIcon from "./ui/StatefulIcon.astro";
import CopyIcon from "@hugeicons/core-free-icons/CopyIcon";
import Cancel01Icon from "@hugeicons/core-free-icons/Cancel01Icon";
import CheckIcon from "@hugeicons/core-free-icons/CheckIcon";
interface Props {
  target?: string;
  url?: string;
  text?: string;
  variant?: "ghost" | "outline";
  label?: string;
  iconOnly?: boolean;
}
const { target, url, text = "Copy", variant = "ghost", label = "Copy code", iconOnly = false } = Astro.props;
---
<docs-copy data-target={target} data-url={url}>
  <Button variant={variant} size={iconOnly ? "icon" : "xs"} aria-label={label}>
    <StatefulIcon state="idle" icons={{ idle: CopyIcon, copied: CheckIcon, error: Cancel01Icon }} class={iconOnly ? "size-4" : "size-3"} data-icon={iconOnly ? undefined : "inline-start"} />
    {!iconOnly && <span class="inline-grid items-center justify-items-center" aria-hidden="true">
      <span data-copy-label="idle" data-active="true" class="col-start-1 row-start-1 whitespace-nowrap opacity-0 -translate-y-1 transition duration-150 data-[active=true]:translate-y-0 data-[active=true]:opacity-100 motion-reduce:transition-none">{text}</span>
      <span data-copy-label="copied" data-active="false" class="col-start-1 row-start-1 whitespace-nowrap opacity-0 translate-y-1 transition duration-150 data-[active=true]:translate-y-0 data-[active=true]:opacity-100 motion-reduce:transition-none">Copied</span>
      <span data-copy-label="error" data-active="false" class="col-start-1 row-start-1 whitespace-nowrap opacity-0 translate-y-1 transition duration-150 data-[active=true]:translate-y-0 data-[active=true]:opacity-100 motion-reduce:transition-none">Failed</span>
    </span>}
  </Button>
  <span class="sr-only" role="status"></span>
</docs-copy>
<script>
  import "../lib/copy-control";
</script>
