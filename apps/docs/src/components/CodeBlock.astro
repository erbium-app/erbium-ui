---
import { highlightSource } from "../lib/highlight";

interface Props {
  source: string;
  path: string;
}
const { source, path } = Astro.props;
---

<docs-code-block class="docs-code-block" data-copy-label={`Copy ${path.replace(/^src\//, "")}`}>
  <pre class="th-code"><code set:html={highlightSource(source, path)} /></pre>
</docs-code-block>
