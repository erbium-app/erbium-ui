---
import Separator from "@/components/primitives/Separator.astro";
import SidebarContent from "@/components/primitives/sidebar/SidebarContent.astro";
import SidebarGroup from "@/components/primitives/sidebar/SidebarGroup.astro";
import SidebarGroupLabel from "@/components/primitives/sidebar/SidebarGroupLabel.astro";
import SidebarGroupContent from "@/components/primitives/sidebar/SidebarGroupContent.astro";
import SidebarMenu from "@/components/primitives/sidebar/SidebarMenu.astro";
import SidebarMenuItem from "@/components/primitives/sidebar/SidebarMenuItem.astro";
import { navigationGroups } from "@/content/catalog";
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<SidebarContent
  class="docs-sidebar-content scrollbar-gutter-stable scrollbar-thin [scrollbar-color:color-mix(in_srgb,var(--muted-foreground)_35%,transparent)_transparent] pe-[0.7rem] pb-8"
>
  <nav aria-label="Documentation">
    {
      navigationGroups.map((group, index) => (
        <>
          {index > 0 && (
            <Separator
              class="docs-nav-separator my-3"
              variant="inset"
              decorative
            />
          )}
          <SidebarGroup class="docs-nav-group p-[0.5rem_0]">
            <SidebarGroupLabel class="docs-nav-label text-foreground text-metadata font-semibold px-[0.65rem] mb-1 [&_>_a]:flex [&_>_a]:w-full [&_>_a]:justify-between [&_>_a]:items-center">
              {group.href ? (
                <a href={group.href} data-astro-prefetch="hover">
                  {group.title}
                </a>
              ) : (
                group.title
              )}
            </SidebarGroupLabel>
            <SidebarGroupContent>
              <SidebarMenu>
                {group.items.map((item) => (
                  <SidebarMenuItem>
                    <a
                      href={item.href}
                      data-astro-prefetch="hover"
                      aria-current={pathname === item.href ? "page" : undefined}
                      data-active={pathname === item.href ? "" : undefined}
                      class="docs-nav-link"
                    >
                      {item.title}
                    </a>
                  </SidebarMenuItem>
                ))}
              </SidebarMenu>
            </SidebarGroupContent>
          </SidebarGroup>
        </>
      ))
    }
  </nav>
</SidebarContent>
