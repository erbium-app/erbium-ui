---
import Separator from "../ui/Separator.astro";
import SidebarContent from "../ui/sidebar/SidebarContent.astro";
import SidebarGroup from "../ui/sidebar/SidebarGroup.astro";
import SidebarGroupLabel from "../ui/sidebar/SidebarGroupLabel.astro";
import SidebarGroupContent from "../ui/sidebar/SidebarGroupContent.astro";
import SidebarMenu from "../ui/sidebar/SidebarMenu.astro";
import SidebarMenuItem from "../ui/sidebar/SidebarMenuItem.astro";
import SidebarMenuButton from "../ui/sidebar/SidebarMenuButton.astro";
import { navigationGroups } from "../../data/components";
interface Props { persist?: string; }
const { persist } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<SidebarContent class="docs-sidebar-content" transition:persist={persist}>
  <nav aria-label="Documentation">
    {
      navigationGroups.map((group, index) => (
        <>
          {index > 0 && (
            <Separator class="docs-nav-separator" variant="inset" decorative />
          )}
          <SidebarGroup class="docs-nav-group">
            <SidebarGroupLabel class="docs-nav-label">
              {group.href ? (
                <a href={group.href} data-astro-prefetch="hover">
                  {group.title}
                </a>
              ) : (
                group.title
              )}
            </SidebarGroupLabel>
            <SidebarGroupContent>
              <SidebarMenu>
                {group.items.map((item) => (
                  <SidebarMenuItem>
                    <SidebarMenuButton
                      href={item.href}
                      data-astro-prefetch="hover"
                      isActive={pathname === item.href}
                      class="docs-nav-link"
                    >
                      {item.title}
                    </SidebarMenuButton>
                  </SidebarMenuItem>
                ))}
              </SidebarMenu>
            </SidebarGroupContent>
          </SidebarGroup>
        </>
      ))
    }
  </nav>
</SidebarContent>

<script>
  const sidebarContent = () => document.querySelector<HTMLElement>(
    ".docs-sidebar .docs-sidebar-content",
  );
  const revealActive = () => {
    const sidebar = sidebarContent();
    const active = sidebar?.querySelector<HTMLElement>('[aria-current="page"]');
    if (!sidebar || !active || sidebar.clientHeight === 0) return;
    const viewport = sidebar.getBoundingClientRect();
    const bounds = active.getBoundingClientRect();
    if (bounds.top < viewport.top) sidebar.scrollTop += bounds.top - viewport.top;
    else if (bounds.bottom > viewport.bottom) sidebar.scrollTop += bounds.bottom - viewport.bottom;
  };
  let sidebarScrollTop = 0;
  let sidebarNavigation = false;
  document.addEventListener("astro:before-preparation", (event) => {
    sidebarNavigation = event.sourceElement instanceof Element &&
      Boolean(event.sourceElement.closest(".docs-sidebar .docs-sidebar-content"));
  });
  document.addEventListener("astro:before-swap", () => {
    sidebarScrollTop = document.querySelector<HTMLElement>(
      ".docs-sidebar .docs-sidebar-content",
    )?.scrollTop ?? 0;
  });
  // Astro restores focus to persisted links during the swap, which can scroll
  // their container. Restore the offset after that focus step, before paint.
  document.addEventListener("astro:after-swap", () => {
    const sidebar = document.querySelector<HTMLElement>(
      ".docs-sidebar .docs-sidebar-content",
    );
    if (sidebar) sidebar.scrollTop = sidebarScrollTop;
    const pathname = window.location.pathname.replace(/\/$/, "") || "/";
    for (const link of document.querySelectorAll<HTMLAnchorElement>(".docs-nav-link")) {
      const active = link.pathname === pathname;
      link.toggleAttribute("data-active", active);
      if (active) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    }
    if (!sidebarNavigation) revealActive();
  });
  revealActive();
</script>
