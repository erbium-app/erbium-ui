---
import SidebarProvider from "@/components/primitives/sidebar/SidebarProvider.astro";
import DocsSidebar from "@/components/shell/DocsSidebar.astro";
import Brand from "@/components/shell/Brand.astro";
import MobileNavigation from "@/components/shell/MobileNavigation.astro";
import SearchDialog from "@/features/search/SearchDialog.astro";
---

<div
  class="site-shell ms-[max(var(--site-gutter),calc((100%-var(--site-max-width))/2))] me-(--site-gutter)"
>
  <header
    transition:persist="docs-mobile-header"
    class="mobile-site-header hidden max-[959px]:text-foreground max-[959px]:flex max-[959px]:items-center max-[959px]:justify-between max-[959px]:gap-4 max-[959px]:py-3 max-[959px]:[&_>_mobile-navigation_>_button]:w-11 max-[959px]:[&_>_mobile-navigation_>_button]:h-11"
  >
    <Brand />
    <MobileNavigation />
  </header>
  <SidebarProvider
    class="docs-frame grid grid-cols-[var(--sidebar-width)_minmax(0,1fr)] items-start gap-(--site-column-gap) min-h-svh max-[959px]:block"
  >
    <div class="contents" transition:persist="docs-sidebar">
      <DocsSidebar />
    </div>
    <div class="site-page-content min-w-0">
      <slot />
    </div>
  </SidebarProvider>
</div>
<SearchDialog />
<script>
  import "@/runtime/navigation.client";
</script>
