---
import SidebarProvider from "@/components/primitives/sidebar/SidebarProvider.astro";
import DocsSidebar from "@/components/shell/DocsSidebar.astro";
import Brand from "@/components/shell/Brand.astro";
import MobileNavigation from "@/components/shell/MobileNavigation.astro";
import SearchDialog from "@/features/search/SearchDialog.astro";
---
    <div class="site-shell ms-[max(var(--site-gutter),_calc((100%_-_var(--site-max-width))_/_2))] me-[var(--site-gutter)]">
      <header transition:persist="docs-mobile-header" class="mobile-site-header hidden max-[959px]:text-foreground max-[959px]:flex max-[959px]:items-center max-[959px]:justify-between max-[959px]:gap-4 max-[959px]:py-3 max-[959px]:[&_>_mobile-navigation_>_button]:w-11 max-[959px]:[&_>_mobile-navigation_>_button]:h-11">
        <Brand />
        <MobileNavigation />
      </header>
      <SidebarProvider class="docs-frame grid [grid-template-columns:var(--sidebar-width)_minmax(0,_1fr)] items-start gap-[var(--site-column-gap)] min-h-[100svh] max-[959px]:block">
        <div class="contents" transition:persist="docs-sidebar"><DocsSidebar /></div>
        <div class="site-page-content min-w-0" transition:name="docs-content" transition:animate="none"><slot /></div>
      </SidebarProvider>
    </div>
<SearchDialog />
<script>
  import "@/runtime/navigation.client";
</script>
