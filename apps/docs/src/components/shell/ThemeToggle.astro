---
import Button from "../ui/Button.astro";
import ThemeToggleIcon from "../ui/ThemeToggleIcon.astro";
---

<theme-toggle>
  <Button
    variant="ghost"
    size="icon"
    aria-label="Use dark theme"
    aria-pressed="false"
    data-theme-toggle
    ><ThemeToggleIcon /></Button
  >
</theme-toggle>
