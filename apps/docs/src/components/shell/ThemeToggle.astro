---
import Button from "../primitives/Button.astro";
import ThemeToggleIcon from "../primitives/ThemeToggleIcon.astro";
---

<theme-toggle class="inline-flex">
  <Button
    variant="ghost"
    size="icon"
    aria-label="Use dark theme"
    aria-pressed="false"
    data-theme-toggle
    ><ThemeToggleIcon /></Button
  >
</theme-toggle>
