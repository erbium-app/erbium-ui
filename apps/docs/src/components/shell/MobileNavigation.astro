---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import Menu01Icon from "@hugeicons/core-free-icons/Menu01Icon";
import Cancel01Icon from "@hugeicons/core-free-icons/Cancel01Icon";
import ThemeToggle from "./ThemeToggle.astro";
import GithubIcon from "@hugeicons/core-free-icons/GithubIcon";
import Brand from "./Brand.astro";
import DocsNavigation from "./DocsNavigation.astro";
---

<mobile-navigation class="mobile-navigation">
  <Button
    variant="ghost"
    size="icon"
    aria-label="Open navigation"
    aria-haspopup="dialog"
    aria-controls="mobile-navigation"
    aria-expanded="false"
    data-navigation-open><Icon icon={Menu01Icon} /></Button
  >
  <dialog
    id="mobile-navigation"
    class="mobile-navigation-panel"
    aria-label="Documentation navigation"
  >
    <div class="mobile-navigation-header">
      <Brand /><Button
        variant="ghost"
        size="icon"
        aria-label="Close navigation"
        data-navigation-close><Icon icon={Cancel01Icon} /></Button
      >
    </div>
    <div class="mobile-sidebar-search"><Button variant="outline" class="w-full" data-navigation-search>Search documentation… <kbd>⌘ K</kbd></Button></div>
    <DocsNavigation />
    <div class="mobile-sidebar-footer"><Button href="https://github.com/erbium-app/erbium-ui" target="_blank" rel="noopener noreferrer" variant="ghost" size="icon" aria-label="Erbium UI on GitHub"><Icon icon={GithubIcon} /></Button><ThemeToggle /></div>
  </dialog>
</mobile-navigation>
<script>
  class MobileNavigation extends HTMLElement {
    private controller?: AbortController;
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const options = { signal: this.controller.signal };
      const dialog = this.querySelector<HTMLDialogElement>("dialog")!;
      const trigger = this.querySelector<HTMLButtonElement>(
        "[data-navigation-open]",
      )!;
      this.querySelector("[data-navigation-search]")?.addEventListener("click", () => {
        dialog.close();
        window.dispatchEvent(new Event("erbium-search-open"));
      }, options);
      trigger.addEventListener("click", () => {
        dialog.showModal();
        trigger.setAttribute("aria-expanded", "true");
      }, options);
      this.querySelector("[data-navigation-close]")?.addEventListener(
        "click",
        () => dialog.close(),
        options,
      );
      dialog.addEventListener("close", () =>
        trigger.setAttribute("aria-expanded", "false"),
        options,
      );
      dialog.addEventListener("click", (event) => {
        const bounds = dialog.getBoundingClientRect();
        if (
          event.target === dialog &&
          (event.clientX < bounds.left ||
            event.clientX > bounds.right ||
            event.clientY < bounds.top ||
            event.clientY > bounds.bottom)
        )
          dialog.close();
        if (event.target instanceof Element && event.target.closest("a"))
          dialog.close();
      }, options);
      window
        .matchMedia("(min-width: 960px)")
        .addEventListener("change", (event) => {
          if (event.matches) dialog.close();
        }, { signal: this.controller.signal });
    }
    disconnectedCallback() {
      this.controller?.abort();
    }
  }
  if (!customElements.get("mobile-navigation"))
    customElements.define("mobile-navigation", MobileNavigation);
</script>
