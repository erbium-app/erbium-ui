---
import Sidebar from "../ui/sidebar/Sidebar.astro";
import SidebarFooter from "../ui/sidebar/SidebarFooter.astro";
import DocsNavigation from "./DocsNavigation.astro";
---
<Sidebar class="docs-sidebar" collapsible="none">
  <DocsNavigation />
  <SidebarFooter class="docs-sidebar-footer"><span class="status-dot"></span>Open source. Yours to shape.</SidebarFooter>
</Sidebar>
<script>
  const sidebar = document.querySelector<HTMLElement>(".docs-sidebar .docs-sidebar-content");
  const active = sidebar?.querySelector<HTMLElement>('[aria-current="page"]');
  if (sidebar && active) {
    const offset = active.getBoundingClientRect().top - sidebar.getBoundingClientRect().top;
    if (offset > sidebar.clientHeight - 64) sidebar.scrollTop = offset - sidebar.clientHeight / 2;
  }
</script>
