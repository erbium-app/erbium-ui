---
import type { HTMLAttributes } from "astro/types";
import { tableStyles } from "@erbium/ui/lib/table-styles";
import { cn } from "@erbium/ui/lib/utils";
type Props = HTMLAttributes<"th">;
const { class: className, ...props } = Astro.props;
---
<th data-slot="table-head" class={cn(tableStyles.tableHead, className)} {...props}><slot /></th>
