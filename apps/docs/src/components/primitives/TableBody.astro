---
import type { HTMLAttributes } from "astro/types";
import { tableStyles } from "@erbium/ui/lib/table-styles";
import { cn } from "@erbium/ui/lib/utils";
type Props = HTMLAttributes<"tbody">;
const { class: className, ...props } = Astro.props;
---
<tbody data-slot="table-body" class={cn(tableStyles.tableBody, className)} {...props}><slot /></tbody>
