---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@erbium/ui/lib/utils";
type Props = Omit<HTMLAttributes<"select">, "size"> & { size?: "sm" | "default"; placeholder?: string };
const { class: className, size = "default", placeholder, ...props } = Astro.props;
---
<div class="astro-select relative w-full" data-slot="select">
  <select data-slot="select-trigger" data-size={size} class={cn("astro-select-control surface-field appearance-none w-full min-w-0 h-8 border border-transparent rounded-md px-[0.625rem_2rem]  text-foreground outline-none [&[data-size='sm']]:h-7 [&:focus-visible]:border-ring [&:disabled]:opacity-50 [&:disabled]:cursor-not-allowed [&[aria-invalid='true']]:border-error", className)} {...props}>
    {placeholder && <option value="" disabled>{placeholder}</option>}
    <slot />
  </select>
  <svg aria-hidden="true" viewBox="0 0 24 24" class="astro-select-chevron absolute end-[0.6rem] top-[50%] -translate-y-1/2 w-4 h-4 pointer-events-none text-muted-foreground"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
</div>
