---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@erbium/ui/lib/utils";
type Props = HTMLAttributes<"tr">;
const { class: className, ...props } = Astro.props;
---
<tr data-slot="table-row" class={cn("carve-bottom transition-colors hover:bg-muted-hover", className)} {...props}><slot /></tr>
