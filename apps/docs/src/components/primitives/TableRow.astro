---
import type { HTMLAttributes } from "astro/types";
import { tableStyles } from "@erbium/ui/lib/table-styles";
import { cn } from "@erbium/ui/lib/utils";
type Props = HTMLAttributes<"tr">;
const { class: className, ...props } = Astro.props;
---
<tr data-slot="table-row" class={cn(tableStyles.tableRow, className)} {...props}><slot /></tr>
