---
import type { HTMLAttributes } from "astro/types";
import { kbdClassName } from "@erbium/ui/lib/kbd-styles";
import { cn } from "@erbium/ui/lib/utils";
type Props = HTMLAttributes<"kbd">;
const { class: className, ...props } = Astro.props;
---
<kbd data-slot="kbd" dir="ltr" class={cn(kbdClassName, className)} {...props}><slot /></kbd>
