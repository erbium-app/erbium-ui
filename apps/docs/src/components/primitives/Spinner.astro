---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@erbium/ui/lib/utils";

type Props = HTMLAttributes<"svg">;
const { class: className, ...props } = Astro.props;
const id = `spinner-${crypto.randomUUID()}`;
const leadingId = `${id}-leading`;
const trailingId = `${id}-trailing`;
---

<svg
  data-slot="spinner"
  role="status"
  aria-label="Loading"
  class={cn("size-4 shrink-0 animate-spin", className)}
  fill="none"
  viewBox="0 0 18 18"
  xmlns="http://www.w3.org/2000/svg"
  {...props}
>
  <path
    d="M9 16.25C13.0041 16.25 16.25 13.0041 16.25 9C16.25 4.99594 13.0041 1.75 9 1.75"
    stroke={`url(#${leadingId})`}
    stroke-width="1.5"
  />
  <path
    d="M9 16.25C4.99594 16.25 1.75 13.0041 1.75 9C1.75 4.99594 4.99594 1.75 9 1.75"
    stroke={`url(#${trailingId})`}
    stroke-width="1.5"
  />
  <circle class="fill-current" cx="9" cy="16.25" r="0.75" />
  <defs>
    <linearGradient
      gradientUnits="userSpaceOnUse"
      id={leadingId}
      x1="9"
      x2="9"
      y1="2.5"
      y2="16.25"
    >
      <stop stop-color="currentColor" stop-opacity="0.5" />
      <stop offset="1" stop-color="currentColor" />
    </linearGradient>
    <linearGradient
      gradientUnits="userSpaceOnUse"
      id={trailingId}
      x1="9"
      x2="9"
      y1="2.5"
      y2="16.25"
    >
      <stop stop-color="currentColor" stop-opacity="0.5" />
      <stop offset="1" stop-color="currentColor" stop-opacity="0" />
    </linearGradient>
  </defs>
</svg>
