---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@erbium/ui/lib/utils";
type Props = Omit<HTMLAttributes<"svg">, "children"> & {
  isOpen?: boolean;
  side?: "left" | "right";
  duration?: number;
};
const {
  isOpen = false,
  side = "left",
  duration = 0.3,
  class: className,
  ...props
} = Astro.props;
---

<svg
  {...props}
  aria-hidden="true"
  class={cn("size-3.75 shrink-0 text-muted-foreground data-[side=right]:-scale-x-100", className)}
  data-slot="sidebar-toggle-icon"
  data-state={isOpen ? "open" : "closed"}
  data-side={side}
  fill="none"
  focusable="false"
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect
    height="18"
    rx="4"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    width="20"
    x="2"
    y="3"
  />
  <rect
    class="w-0.5 transition-[width] ease-out [[data-state=open]_&]:w-1.5 motion-reduce:transition-none"
    fill="currentColor"
    height="12"
    width={isOpen ? 6 : 2}
    rx="1"
    x="5"
    y="6"
    style={{ transitionDuration: `${duration}s` }}
  />
</svg>
