---
import type { HTMLAttributes } from "astro/types";
import { switchGeometryClassName } from "@erbium/ui/lib/switch-styles";
import { cn } from "@erbium/ui/lib/utils";
type Props = Omit<HTMLAttributes<"input">, "size" | "type"> & { defaultChecked?: boolean; readOnly?: boolean; size?: "sm" | "default" };
const { class: className, checked, defaultChecked, readOnly, readonly, size = "default", ...props } = Astro.props;
---
<span class={cn("astro-switch group/switch relative inline-flex shrink-0", switchGeometryClassName, className)} data-size={size}>
  <input class="peer absolute inset-0 z-1 m-0 size-full cursor-pointer opacity-0 disabled:cursor-not-allowed" type="checkbox" role="switch" data-slot="switch" checked={checked ?? defaultChecked} readonly={readOnly || readonly} {...props} />
  <span class="flex w-full items-center rounded-full border border-transparent bg-input dark:bg-input/80 px-px transition-colors peer-checked:bg-selection peer-focus-visible:border-ring peer-disabled:opacity-50 peer-aria-invalid:outline peer-aria-invalid:outline-error motion-reduce:transition-none" aria-hidden="true"><span data-slot="switch-thumb" class="size-3.5 rounded-full bg-background transition-transform group-data-[size=sm]/switch:size-2.5 group-has-checked/switch:translate-x-3.5 rtl:group-has-checked/switch:-translate-x-3.5 group-data-[size=sm]/switch:group-has-checked/switch:translate-x-2.5 rtl:group-data-[size=sm]/switch:group-has-checked/switch:-translate-x-2.5 dark:bg-foreground dark:group-has-checked/switch:bg-selection-foreground motion-reduce:transition-none" /></span>
</span>
<script>
  document.addEventListener("click", (event) => {
    if (event.target instanceof HTMLInputElement && event.target.matches('.astro-switch input[readonly]')) event.preventDefault();
  });
</script>
