---
import type { HTMLAttributes } from "astro/types";
import type { IconProps } from "@erbium/ui/components/icon";

type Props = HTMLAttributes<"svg"> & {
  name: IconProps["name"];
  size?: number;
};
const { name, size = 20, ...props } = Astro.props;
---

<!-- Symbols come from the IconSprite mounted in DocumentLayout. -->
<svg width={size} height={size} aria-hidden="true" focusable="false" {...props}>
  <use href={`#erbium-icon-${name}`} />
</svg>
