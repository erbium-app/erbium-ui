---
import { loadShowcase, type ShowcaseStory } from "@erbium/showcase/catalog";
import ShowcaseControls from "./ShowcaseControls.astro";
import Icon from "./ui/Icon.astro";
import Add01Icon from "@hugeicons/core-free-icons/Add01Icon";
import Link01Icon from "@hugeicons/core-free-icons/Link01Icon";
import CodeBlock from "./CodeBlock.astro";
import Separator from "./ui/Separator.astro";
import Button from "./ui/Button.astro";
import ShowcaseThemeToggle from "./ShowcaseThemeToggle.tsx";
import CopyButton from "./CopyButton.astro";
import ComponentPreview from "./ComponentPreview.tsx";
interface Props {
  name: string;
  variant: string;
  slug: string;
  anchorId?: string;
  title: string;
  source: string;
  files: { path: string; source: string }[];
}
const { name, variant, slug, title, source, files } = Astro.props;
const anchorId = Astro.props.anchorId ?? slug;
const id = `${name}-${slug}`;
const sources = files.length ? files : [{ path: `${slug}.tsx`, source }];
const catalog = await loadShowcase(name);
const story = catalog[variant] as ShowcaseStory;
const command = `npx shadcn@latest add @erbium-examples/${name}-${slug}`;
---

<section id={anchorId} class="demo-section">
  <Separator class="showcase-header-separator" variant="full" decorative />
  <h2>
    <a href={`#${anchorId}`}
      >{title}<span class="heading-anchor" aria-hidden="true"><Icon icon={Link01Icon} size={14} /></span></a
    >
  </h2>
  <div class="markdown-copy variant-description"><slot /></div>
  <showcase-tabs class="showcase">
    <div class="showcase-toolbar">
      <div role="tablist" aria-label={`${title} example`}>
        <Button
          id={`${id}-preview-tab`}
          variant="ghost"
          size="sm"
          role="tab"
          aria-selected="true"
          aria-controls={`${id}-preview`}
          data-tab="preview">Preview</Button
        >
        <Button
          id={`${id}-code-tab`}
          variant="ghost"
          size="sm"
          role="tab"
          aria-selected="false"
          aria-controls={`${id}-code`}
          tabindex="-1"
          data-tab="code">Code</Button
        >
      </div>
    </div>
    <div
      id={`${id}-preview`}
      role="tabpanel"
      aria-labelledby={`${id}-preview-tab`}
      data-panel="preview"
      class="component-demo"
      tabindex="0"
    >
      <div class="showcase-preview-actions"><ShowcaseThemeToggle client:load /></div>
      <div class="showcase-content" data-showcase-content>
        <ComponentPreview name={name} variant={variant} client:visible />
      </div>
    </div>
    <div
      id={`${id}-code`}
      role="tabpanel"
      aria-labelledby={`${id}-code-tab`}
      data-panel="code"
      class="showcase-code"
      tabindex="0"
      hidden
    >
      {
        sources.map((file) => (
          <CodeBlock source={file.source} path={file.path} />
        ))
      }
    </div>
    <ShowcaseControls story={story} id={id} />
  </showcase-tabs>
  <details class="install-example">
    <summary>Install this example <span aria-hidden="true"><Icon icon={Add01Icon} size={14} /></span></summary
    ><div class="install-command">
      <code id={`${id}-install`}>{command}</code><CopyButton
        iconOnly
        target={`${id}-install`}
        label="Copy installation command"
      />
    </div>
  </details>
</section>
<script>
  class ShowcaseTabs extends HTMLElement {
    connectedCallback() {
      const tabs = [
        ...this.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
      ];
      const select = (tab: HTMLButtonElement) => {
        for (const button of tabs) {
          button.setAttribute("aria-selected", String(button === tab));
          button.tabIndex = button === tab ? 0 : -1;
        }
        for (const panel of this.querySelectorAll<HTMLElement>("[data-panel]"))
          panel.hidden = panel.dataset.panel !== tab.dataset.tab;
      };
      for (const [index, tab] of tabs.entries()) {
        tab.addEventListener("click", () => select(tab));
        tab.addEventListener("keydown", (event) => {
          const rtl = getComputedStyle(this).direction === "rtl";
          let next = index;
          if (event.key === "ArrowRight")
            next = (index + (rtl ? -1 : 1) + tabs.length) % tabs.length;
          else if (event.key === "ArrowLeft")
            next = (index + (rtl ? 1 : -1) + tabs.length) % tabs.length;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = tabs.length - 1;
          else return;
          event.preventDefault();
          select(tabs[next]);
          tabs[next].focus();
        });
      }
    }
  }
  if (!customElements.get("showcase-tabs"))
    customElements.define("showcase-tabs", ShowcaseTabs);
</script>
