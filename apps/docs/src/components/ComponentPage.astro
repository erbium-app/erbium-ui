---
import { componentReference } from "@erbium/content/markdown";
import Icon from "./ui/Icon.astro";
import ArrowUpRight01Icon from "@hugeicons/core-free-icons/ArrowUpRight01Icon";
import ArrowLeft01Icon from "@hugeicons/core-free-icons/ArrowLeft01Icon";
import ArrowRight01Icon from "@hugeicons/core-free-icons/ArrowRight01Icon";
import {
  componentDocuments,
  variantDocuments,
} from "@erbium/content/documents";
import manifest from "@erbium/showcase/manifest";
import { showcaseSource } from "@erbium/showcase/sources";
import showcaseRegistry from "@erbium/showcase/registry";
import { documentationSections } from "../data/documentation-sections";
import { components } from "../data/components";
import DocsLayout from "../layouts/DocsLayout.astro";
import PageHeader from "./PageHeader.astro";
import Showcase from "./Showcase.astro";
import ShowcaseToaster from "./ShowcaseToaster.tsx";
import Button from "./ui/Button.astro";
interface Props {
  name: string;
}
const { name } = Astro.props;
const component = components.find((item) => item.name === name)!;
const reference = componentReference(name);
const pages = componentDocuments as Record<
  string,
  import("astro").MarkdownInstance<Record<string, string>>
>;
const descriptions = variantDocuments as typeof pages;
const page = pages[`../components/${name}/index.md`];
if (!page) throw new Error(`Missing Markdown documentation: ${name}`);
const { Content, frontmatter } = page;
const repeatedSummary =
  page
    .rawContent()
    .replace(/^---[\s\S]*?---/, "")
    .trim()
    .split(/\n\s*\n/)[0] === frontmatter.description;
const catalog = manifest.find((entry) => entry.name === name)!;
const variants = catalog.variants.map((variant) => ({
  ...variant,
  Content: descriptions[`../components/${name}/${variant.slug}.md`].Content,
  source: showcaseSource(variant.source),
  files:
    showcaseRegistry.items
      .find((item) => item.name === `${name}-${variant.slug}`)
      ?.files?.map((file) => ({
        path: file.path,
        source: showcaseSource(file.path),
      })) ?? [],
}));
const lead =
  variants.find((item) => item.exportName === "Overview") ?? variants[0];
const remaining = variants.filter((item) => item !== lead);
const markdownHeadings = (await page.getHeadings()).filter((heading) => heading.depth === 2 || heading.depth === 3);
const showcaseAnchor = (slug: string) => markdownHeadings.some((heading) => heading.slug === slug) ? `example-${slug}` : slug;
const headings = [
  { depth: 2, slug: showcaseAnchor(lead.slug), text: lead.title },
  ...markdownHeadings,
  ...remaining.map((variant) => ({ depth: 2, slug: showcaseAnchor(variant.slug), text: variant.title })),
  ...(reference ? [{ depth: 2, slug: "component-reference-title", text: reference.title }] : []),
];
const section = documentationSections.find((section) => section.slug === component.sectionSlug)!;
const neighbors = section.names.map((name) => components.find((item) => item.name === name)!);
const index = neighbors.findIndex((item) => item.name === name);
---

<DocsLayout title={component.title} description={frontmatter.description} headings={headings}>
  <PageHeader
    title={component.title}
    description={frontmatter.description}
    previous={neighbors[index - 1]}
    next={neighbors[index + 1]}
  >
    {
      component.files?.[0] && (
        <Button
          href={`https://github.com/erbium-app/erbium-ui/blob/main/packages/ui/${component.files[0].path}`}
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
          size="xs"
        >
          View source <Icon icon={ArrowUpRight01Icon} size={14} />
        </Button>
      )
    }
  </PageHeader>
  <Showcase
    name={name}
    separator={false}
    variant={lead.exportName}
    slug={lead.slug}
    anchorId={showcaseAnchor(lead.slug)}
    title={lead.title}
    source={lead.source}
    files={lead.files}><lead.Content /></Showcase
  >
  <article
    class="markdown-copy component-documentation"
    data-repeated-summary={repeatedSummary ? "" : undefined}
  >
    <Content />
  </article>
  {
    remaining.map((variant) => (
      <Showcase
        name={name}
        variant={variant.exportName}
        slug={variant.slug}
        anchorId={showcaseAnchor(variant.slug)}
        title={variant.title}
        source={variant.source}
        files={variant.files}
      >
        <variant.Content />
      </Showcase>
    ))
  }
  {name === "toast" && <ShowcaseToaster client:load />}
  {reference && <section class="component-reference" aria-labelledby="component-reference-title">
    <h2 id="component-reference-title">{reference.title}</h2>
    <p>{reference.description}</p>
    <div class="page-actions">{reference.links.map((link) => <Button href={link.href} target="_blank" rel="noopener noreferrer" variant="outline" size="sm">{link.title}<Icon icon={ArrowUpRight01Icon} size={14} /></Button>)}</div>
  </section>}
  <nav aria-label="Adjacent documentation pages" class="page-pagination">
    {
      neighbors[index - 1] ? (
        <Button href={neighbors[index - 1].href} variant="outline" class="pagination-button" aria-label={`Previous: ${neighbors[index - 1].title}`}>
          <>
            <span class="pagination-label"><Icon icon={ArrowLeft01Icon} size={14} class="rtl:rotate-180" /> Previous</span>
            <strong>{neighbors[index - 1].title}</strong>
          </>
        </Button>
      ) : (
        <span />
      )
    }
    {
      neighbors[index + 1] && (
        <Button href={neighbors[index + 1].href} variant="outline" class="pagination-button" aria-label={`Next: ${neighbors[index + 1].title}`}>
          <>
            <span class="pagination-label">Next <Icon icon={ArrowRight01Icon} size={14} class="rtl:rotate-180" /></span>
            <strong>{neighbors[index + 1].title}</strong>
          </>
        </Button>
      )
    }
  </nav>
</DocsLayout>
