---
import type { components as documentation } from "../data/components";
import { kindTitles } from "../data/documentation-sections";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
import Kbd from "./ui/Kbd.astro";
import Search01Icon from "@hugeicons/core-free-icons/Search01Icon";
import Cancel01Icon from "@hugeicons/core-free-icons/Cancel01Icon";
import ArrowUp01Icon from "@hugeicons/core-free-icons/ArrowUp01Icon";
import ArrowDown01Icon from "@hugeicons/core-free-icons/ArrowDown01Icon";
interface Props { components: typeof documentation }
const groups = [
  { title: "Overview", items: [
    { title: "Introduction", href: "/", name: "introduction", description: "" },
    { title: "Roadmap", href: "/docs/roadmap", name: "roadmap", description: "Planned components, tools, and platforms." },
  ] },
  { title: "Guides", items: [
    { title: "Installation", href: "/docs/installation", name: "installation", description: "" },
    { title: "Using components", href: "/docs/getting-started", name: "getting-started", description: "Compose installed components, examples, and stories." },
    { title: "Typography", href: "/docs/typography", name: "typography", description: "Fonts, type roles, and Typeset reading presets." },
  ] },
  ...(["foundation", "block", "component", "hook", "utility", "provider"] as const).map((kind) => ({
    title: kindTitles[kind], items: [
      ...Astro.props.components.filter((item) => item.kind === kind),
      ...(kind === "utility" ? [{ title: "Shimmer", href: "/docs/utilities/shimmer", name: "shimmer", description: "Animated text highlighting." }] : []),
    ].sort((a, b) => a.title.localeCompare(b.title)),
  })),
];
const normalize = (text: string) => text.toLowerCase().replace(/[-_]/g, " ").trim();
---

<docs-search class="contents">
  <Button variant="outline" class="docs-search-trigger w-60 justify-start gap-2 text-muted-foreground text-xs [&_>_span]:flex-1 [&_>_span]:text-start [&_kbd]:[font-size:0.65rem] max-[1100px]:w-48 max-[1100px]:[&_>_span]:overflow-hidden max-[1100px]:[&_>_span]:text-ellipsis max-[560px]:w-8 max-[560px]:h-8 max-[560px]:p-[0.4rem] max-[560px]:[&_>_span]:hidden max-[560px]:[&_kbd]:hidden max-[560px]:[&_svg]:w-4 max-[560px]:[&_svg]:h-4" aria-haspopup="dialog" aria-controls="docs-search-dialog" data-search-open>
    <Icon icon={Search01Icon} />
    <span>Search documentation…</span>
    <Kbd class="shrink-0" aria-label="Command or Control plus K">⌘ K</Kbd>
  </Button>
  <dialog id="docs-search-dialog" class="docs-search-dialog fixed top-[15vh] bottom-auto w-[min(32rem,_calc(100vw_-_2rem))] max-h-[min(32rem,_75dvh)] mx-auto p-0 border border-border rounded-xl bg-popover text-popover-foreground [box-shadow:0_16px_48px_oklch(0%_0_none_/_0.2)] overflow-hidden [&[open]]:flex [&[open]]:flex-col [&::backdrop]:[background:oklch(0%_0_none_/_0.4)] [&_.search-footer]:shrink-0" aria-labelledby="docs-search-title" aria-describedby="docs-search-description">
    <h2 id="docs-search-title" class="sr-only">Search documentation</h2>
    <p id="docs-search-description" class="sr-only">Find a component, hook, or guide. Use the arrow keys to navigate results and Enter to open a page.</p>
    <div class="docs-search-input-row flex items-center gap-2 p-[0.7rem_0.8rem] shrink-0 carve-bottom [&_>_svg]:text-muted-foreground [&_>_svg]:shrink-0 [&_input]:w-full [&_input]:min-w-0 [&_input]:border-0 [&_input]:outline-none [&_input]:bg-transparent [&_input]:text-inherit [&_input]:[font-family:inherit] [&_input]:text-sm [&:focus-within]:[box-shadow:inset_0_-2px_var(--ring)]">
      <Icon icon={Search01Icon} size={18} />
      <input type="search" placeholder="Search documentation…" aria-label="Search documentation" aria-controls="docs-search-results" autocomplete="off" spellcheck="false" />
      <Button variant="ghost" size="icon-xs" aria-label="Close search" data-search-close><Icon icon={Cancel01Icon} size={16} /></Button>
    </div>
    <div id="docs-search-results" class="docs-search-results overflow-y-auto overscroll-contain p-[0.4rem] min-h-0 [&_h3]:p-[0.5rem_0.5rem_0.25rem] [&_h3]:[font-size:0.7rem] [&_h3]:font-medium [&_h3]:text-muted-foreground [&_ul]:list-none [&_ul]:m-0 [&_ul]:p-0 [&_a]:flex [&_a]:items-center [&_a]:gap-2 [&_a]:p-2 [&_a]:rounded-sm [&_a]:[font-size:0.8rem] [&_a]:no-underline [&_a]:outline-none [&_a:hover]:bg-accent [&_a:hover]:text-accent-foreground [&_a:focus-visible]:bg-accent [&_a:focus-visible]:text-accent-foreground [&_[data-search-empty]]:p-6 [&_[data-search-empty]]:text-center [&_[data-search-empty]]:text-sm">
      {groups.map((group) => (
        <section data-search-group aria-label={group.title}>
          <h3>{group.title}</h3>
          <ul>
            {group.items.map((item) => (
              <li data-search-item data-title={normalize(item.title)} data-keywords={normalize(`${item.name} ${item.description}`)}>
                <a href={item.href}><span>{item.title}</span><span class="search-result-path ms-auto font-mono [font-size:0.65rem] text-muted-foreground max-[560px]:hidden">{item.href.replace("/docs/", "")}</span></a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p data-search-empty hidden>No results found.</p>
    </div>
    <span class="sr-only" role="status" data-search-status></span>
    <div class="search-footer flex gap-4 p-[0.7rem_0.8rem] carve-top text-muted-foreground [font-size:0.68rem] [&_>_span]:flex [&_>_span]:items-center [&_>_span]:gap-1">
      <span><Kbd aria-label="Up arrow"><Icon icon={ArrowUp01Icon} size={12} /></Kbd><Kbd aria-label="Down arrow"><Icon icon={ArrowDown01Icon} size={12} /></Kbd> Navigate</span>
      <span><Kbd>Enter</Kbd> Open</span>
      <span><Kbd>Esc</Kbd> Close</span>
    </div>
  </dialog>
</docs-search>
<script>
  import { prefetch } from "astro:prefetch";

  class DocsSearch extends HTMLElement {
    private controller?: AbortController;
    private dialog?: HTMLDialogElement;
    private prefetchTimer?: ReturnType<typeof setTimeout>;

    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const options = { signal: this.controller.signal };
      const dialog = this.querySelector<HTMLDialogElement>("dialog")!;
      const input = this.querySelector<HTMLInputElement>('input[type="search"]')!;
      const items = [...this.querySelectorAll<HTMLElement>("[data-search-item]")];
      const groups = [...this.querySelectorAll<HTMLElement>("[data-search-group]")];
      const empty = this.querySelector<HTMLElement>("[data-search-empty]")!;
      const status = this.querySelector<HTMLElement>("[data-search-status]")!;
      // The sidebar is hidden on mobile; keep the modal outside that subtree.
      this.dialog = dialog;
      document.body.append(dialog);
      const visibleLinks = () => items.filter((item) => !item.hidden).map((item) => item.querySelector<HTMLAnchorElement>("a")!);
      const filter = () => {
        const query = input.value.toLowerCase().replace(/[-_]/g, " ").trim();
        for (const item of items) item.hidden = !(`${item.dataset.title} ${item.dataset.keywords}`).includes(query);
        for (const group of groups) group.hidden = !group.querySelector('[data-search-item]:not([hidden])');
        const count = visibleLinks().length;
        empty.hidden = count > 0;
        status.textContent = `${count} ${count === 1 ? "result" : "results"} found.`;
      };
      const open = () => {
        document.querySelector<HTMLDialogElement>(".mobile-navigation-panel[open]")?.close();
        if (dialog.open) return;
        input.value = "";
        filter();
        dialog.showModal();
        input.focus();
      };
      this.querySelector("[data-search-open]")?.addEventListener("click", open, options);
      dialog.querySelector("[data-search-close]")?.addEventListener("click", () => dialog.close(), options);
      window.addEventListener("erbium-search-open", open, options);
      document.addEventListener("astro:before-swap", () => dialog.close(), options);
      window.addEventListener("keydown", (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          if (dialog.open) dialog.close();
          else open();
        }
      }, options);
      input.addEventListener("input", () => {
        filter();
        clearTimeout(this.prefetchTimer);
        // Enter opens the first match without focusing its link first.
        this.prefetchTimer = setTimeout(() => {
          const first = visibleLinks()[0];
          if (dialog.open && input.value.trim() && first) prefetch(first.href);
        }, 150);
      }, options);
      dialog.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          dialog.close();
          return;
        }
        const links = visibleLinks();
        if (!links.length) return;
        const index = links.indexOf(document.activeElement as HTMLAnchorElement);
        let next: number;
        if (event.key === "ArrowDown") next = (index + 1) % links.length;
        else if (event.key === "ArrowUp") next = index <= 0 ? links.length - 1 : index - 1;
        else if (index >= 0 && event.key === "Home") next = 0;
        else if (index >= 0 && event.key === "End") next = links.length - 1;
        else if (event.target === input && event.key === "Enter") {
          event.preventDefault();
          links[0].click();
          return;
        } else return;
        event.preventDefault();
        links[next].focus();
      }, options);
      dialog.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest("a")) dialog.close();
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
      }, options);
    }

    disconnectedCallback() {
      this.controller?.abort();
      clearTimeout(this.prefetchTimer);
      this.dialog?.close();
      this.dialog?.remove();
    }
  }
  if (!customElements.get("docs-search")) customElements.define("docs-search", DocsSearch);
</script>
