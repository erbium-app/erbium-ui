---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@erbium/ui/lib/utils";
import { sidebarStyles } from "@erbium/ui/lib/sidebar-styles";
type Props = HTMLAttributes<"div">;
const { class: className, ...props } = Astro.props;
---
<div data-slot="sidebar-footer" data-sidebar="footer" class={cn(sidebarStyles.header, className)} {...props}><slot /></div>
