---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@erbium/ui/lib/utils";
type Props = HTMLAttributes<"aside"> & {
  side?: "left" | "right";
  collapsible?: "none";
};
const {
  class: className,
  side = "left",
  collapsible = "none",
  ...props
} = Astro.props;
---

<aside
  data-slot="sidebar"
  data-side={side}
  data-collapsible={collapsible}
  class={cn(
    "group flex w-(--sidebar-width,16rem) flex-col text-sidebar-foreground",
    className,
  )}
  {...props}
>
  <slot />
</aside>
