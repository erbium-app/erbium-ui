---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@erbium/ui/lib/utils";
type Props = HTMLAttributes<"th">;
const { class: className, ...props } = Astro.props;
---
<th data-slot="table-head" class={cn("h-10 px-2 text-start align-middle font-medium whitespace-nowrap text-foreground", className)} {...props}><slot /></th>
