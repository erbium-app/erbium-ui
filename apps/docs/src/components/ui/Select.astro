---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@erbium/ui/lib/utils";
type Props = Omit<HTMLAttributes<"select">, "size"> & { size?: "sm" | "default"; placeholder?: string };
const { class: className, size = "default", placeholder, ...props } = Astro.props;
---
<div class="astro-select" data-slot="select">
  <select data-slot="select-trigger" data-size={size} class={cn("astro-select-control", className)} {...props}>
    {placeholder && <option value="" disabled>{placeholder}</option>}
    <slot />
  </select>
  <svg aria-hidden="true" viewBox="0 0 24 24" class="astro-select-chevron"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
</div>
