---
import Separator from "./ui/Separator.astro";
import CopyButton from "./CopyButton.astro";
import { markdownPath } from "../lib/agent-pages";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
import ArrowLeft01Icon from "@hugeicons/core-free-icons/ArrowLeft01Icon";
import ArrowRight01Icon from "@hugeicons/core-free-icons/ArrowRight01Icon";
interface Props {
  title: string;
  description?: string;
  previous?: { title: string; href: string };
  next?: { title: string; href: string };
}
const { title, description, previous, next } = Astro.props;
---

<header class="page-header">
  <div class="page-header-top">
    <h1>{title}</h1>
    <div class="page-neighbors">
      {
        previous && (
          <Button
            href={previous.href}
            variant="outline"
            size="icon-sm"
            aria-label={`Previous: ${previous.title}`}
            title={previous.title}
          >
            <Icon icon={ArrowLeft01Icon} />
          </Button>
        )
      }{
        next && (
          <Button
            href={next.href}
            variant="outline"
            size="icon-sm"
            aria-label={`Next: ${next.title}`}
            title={next.title}
          >
            <Icon icon={ArrowRight01Icon} />
          </Button>
        )
      }
    </div>
  </div>
  {description && <p class="page-description">{description}</p>}
  <div class="page-actions">
    <slot />
    <CopyButton
      url={markdownPath(Astro.url.pathname.replace(/\/$/, "") || "/")}
      text="Copy Markdown"
      label="Copy page as Markdown"
      variant="outline"
    />
  </div>
  <Separator class="page-header-separator" variant="full" decorative />
</header>
