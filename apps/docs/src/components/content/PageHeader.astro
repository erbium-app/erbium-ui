---
import Separator from "@/components/primitives/Separator.astro";
import CopyButton from "@/features/code/CopyButton.astro";
import { markdownPath } from "@/build/agent/artifacts";
import Button from "@/components/primitives/Button.astro";
import Icon from "@/components/primitives/Icon.astro";
interface Props {
  title: string;
  description?: string;
  previous?: { title: string; href: string };
  next?: { title: string; href: string };
}
const { title, description, previous, next } = Astro.props;
---

<header
  class="page-header mb-4 [&_h1]:min-w-0 [&_h1]:wrap-anywhere [&_h1]:m-0 [&_h1]:text-foreground [&_h1]:text-display [&+.demo-section]:mt-4"
>
  <div class="page-header-top flex justify-between items-center gap-group">
    <h1>{title}</h1>
    <div class="page-neighbors shrink-0 flex gap-[0.35rem]">
      {
        previous && (
          <Button
            href={previous.href}
            data-astro-prefetch="viewport"
            variant="outline"
            size="icon-sm"
            aria-label={`Previous: ${previous.title}`}
            title={previous.title}
          >
            <Icon name="arrow-left-01" />
          </Button>
        )
      }{
        next && (
          <Button
            href={next.href}
            data-astro-prefetch="viewport"
            variant="outline"
            size="icon-sm"
            aria-label={`Next: ${next.title}`}
            title={next.title}
          >
            <Icon name="arrow-right-01" />
          </Button>
        )
      }
    </div>
  </div>
  {
    description && (
      <p class="page-description max-w-2xl mt-(--docs-description-gap) text-body text-muted-foreground">
        {description}
      </p>
    )
  }
  <div class="page-actions flex flex-wrap gap-related mt-[1.15rem] empty:hidden">
    <slot />
    <CopyButton
      url={markdownPath(Astro.url.pathname.replace(/\/$/, "") || "/")}
      text="Copy Markdown"
      label="Copy page as Markdown"
      variant="outline"
    />
  </div>
  <Separator class="page-header-separator mt-6" variant="full" decorative />
</header>
