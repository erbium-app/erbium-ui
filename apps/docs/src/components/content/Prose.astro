---
import type { HTMLAttributes } from "astro/types";
import { proseStyles } from "@/styles/content";
interface Props extends HTMLAttributes<"article"> {
  as?: "article" | "section" | "div";
}
const { as: Tag = "article", class: className, ...props } = Astro.props;
---

<Tag {...props} class:list={[proseStyles, className]}><slot /></Tag>
<script>
  import "@/features/code/code-block.client";
</script>
