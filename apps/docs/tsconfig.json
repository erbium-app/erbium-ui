{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@public/*": ["./public/*"],
      "@ui/*": ["../../packages/ui/*"],
      "@reference/*": ["../../.reference/*"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*", "astro.config.mjs"]
}
