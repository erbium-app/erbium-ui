{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "item-variant",
  "title": "Item Variant",
  "description": "Erbium item variant example.",
  "registryDependencies": ["@erbium/button", "@erbium/item"],
  "files": [
    {
      "path": "registry/examples/item-variant.tsx",
      "content": "// @ts-nocheck\nimport { Button } from \"../components/button\";\nimport {\n  Item,\n  ItemActions,\n  ItemContent,\n  ItemDescription,\n  ItemTitle,\n} from \"../components/item\";\n\nexport default function ItemVariant() {\n  return (\n    <div className=\"flex flex-col gap-6\">\n      <Item>\n        <ItemContent>\n          <ItemTitle>Default Variant</ItemTitle>\n          <ItemDescription>Flat styling that inherits its surrounding surface.</ItemDescription>\n        </ItemContent>\n        <ItemActions>\n          <Button variant=\"outline\" size=\"sm\">\n            Open\n          </Button>\n        </ItemActions>\n      </Item>\n      <Item variant=\"outline\">\n        <ItemContent>\n          <ItemTitle>Outline Variant</ItemTitle>\n          <ItemDescription>Raised panel styling with a subtle edge and shadow.</ItemDescription>\n        </ItemContent>\n        <ItemActions>\n          <Button variant=\"outline\" size=\"sm\">\n            Open\n          </Button>\n        </ItemActions>\n      </Item>\n      <Item variant=\"muted\">\n        <ItemContent>\n          <ItemTitle>Muted Variant</ItemTitle>\n          <ItemDescription>A softer panel surface for secondary content.</ItemDescription>\n        </ItemContent>\n        <ItemActions>\n          <Button variant=\"outline\" size=\"sm\">\n            Open\n          </Button>\n        </ItemActions>\n      </Item>\n    </div>\n  );\n}\n",
      "type": "registry:component",
      "target": "~/src/examples/item-variant.tsx"
    }
  ],
  "type": "registry:component"
}
