{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar-demo",
  "title": "Sidebar Demo",
  "description": "Erbium sidebar demo example.",
  "dependencies": ["lucide-react"],
  "registryDependencies": ["@erbium/collapsible", "@erbium/separator", "@erbium/sidebar"],
  "files": [
    {
      "path": "registry/examples/sidebar-demo.tsx",
      "content": "// @ts-nocheck\nimport { ChevronDownIcon } from \"lucide-react\";\nimport {\n  Collapsible,\n  CollapsibleContent,\n  CollapsibleTrigger,\n} from \"../components/collapsible\";\nimport { Separator } from \"../components/separator\";\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarGroup,\n  SidebarGroupContent,\n  SidebarGroupLabel,\n  SidebarMenu,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarProvider,\n} from \"../components/sidebar\";\nexport default function Demo() {\n  return (\n    <SidebarProvider defaultOpen>\n      <div className=\"relative h-64 w-80 overflow-hidden border\">\n        <Sidebar collapsible=\"none\">\n          <SidebarContent>\n            <Collapsible defaultOpen className=\"group/workspace\">\n              <SidebarGroup>\n                <SidebarGroupLabel\n                  className=\"hover:bg-sidebar-accent data-panel-open:rounded-b-none [&:has(+_[data-slot=collapsible-content]:not([hidden]))]:rounded-b-none\"\n                  render={<CollapsibleTrigger />}\n                >\n                  Workspace\n                  <ChevronDownIcon\n                    aria-hidden=\"true\"\n                    className=\"ms-auto transition-transform duration-200 group-data-open/workspace:rotate-180 motion-reduce:transition-none\"\n                  />\n                </SidebarGroupLabel>\n                <CollapsibleContent>\n                  <Separator className=\"bg-sidebar-border\" />\n                  <SidebarGroupContent>\n                    <SidebarMenu>\n                      <SidebarMenuItem>\n                        <SidebarMenuButton>Overview</SidebarMenuButton>\n                      </SidebarMenuItem>\n                      <SidebarMenuItem>\n                        <SidebarMenuButton>Settings</SidebarMenuButton>\n                      </SidebarMenuItem>\n                    </SidebarMenu>\n                  </SidebarGroupContent>\n                </CollapsibleContent>\n              </SidebarGroup>\n            </Collapsible>\n          </SidebarContent>\n        </Sidebar>\n      </div>\n    </SidebarProvider>\n  );\n}\n",
      "type": "registry:component",
      "target": "~/src/examples/sidebar-demo.tsx"
    }
  ],
  "type": "registry:component"
}
