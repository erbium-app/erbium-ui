{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sheet-demo",
  "title": "Sheet Demo",
  "description": "Erbium sheet demo example.",
  "registryDependencies": ["@erbium/button", "@erbium/input", "@erbium/label", "@erbium/sheet"],
  "files": [
    {
      "path": "registry/examples/sheet-demo.tsx",
      "content": "// @ts-nocheck\nimport { Button } from \"../components/button\";\nimport { Input } from \"../components/input\";\nimport { Label } from \"../components/label\";\nimport {\n  Sheet,\n  SheetClose,\n  SheetPanel,\n  SheetDescription,\n  SheetFooter,\n  SheetHeader,\n  SheetContent,\n  SheetTitle,\n  SheetTrigger,\n} from \"../components/sheet\";\n\nexport default function SheetDemo() {\n  return (\n    <Sheet>\n      <SheetTrigger render={<Button variant=\"outline\">Open</Button>} />\n      <SheetPanel>\n        <SheetHeader>\n          <SheetTitle>Edit profile</SheetTitle>\n          <SheetDescription>\n            Make changes to your profile here. Click save when you&apos;re done.\n          </SheetDescription>\n        </SheetHeader>\n        <SheetContent className=\"grid content-start gap-6\">\n          <div className=\"grid gap-3\">\n            <Label htmlFor=\"sheet-demo-name\">Name</Label>\n            <Input id=\"sheet-demo-name\" defaultValue=\"Pedro Duarte\" />\n          </div>\n          <div className=\"grid gap-3\">\n            <Label htmlFor=\"sheet-demo-username\">Username</Label>\n            <Input id=\"sheet-demo-username\" defaultValue=\"@peduarte\" />\n          </div>\n        </SheetContent>\n        <SheetFooter>\n          <SheetClose render={<Button variant=\"outline\">Close</Button>} />\n          <SheetClose render={<Button>Save changes</Button>} />\n        </SheetFooter>\n      </SheetPanel>\n    </Sheet>\n  );\n}\n",
      "type": "registry:component",
      "target": "~/src/examples/sheet-demo.tsx"
    }
  ],
  "type": "registry:component"
}
