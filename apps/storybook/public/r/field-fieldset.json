{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "field-fieldset",
  "title": "Field Fieldset",
  "description": "Erbium field fieldset example.",
  "registryDependencies": ["@erbium/field", "@erbium/input"],
  "files": [
    {
      "path": "registry/examples/field-fieldset.tsx",
      "content": "// @ts-nocheck\nimport {\n  Field,\n  FieldDescription,\n  FieldGroup,\n  FieldLabel,\n  FieldLegend,\n  FieldSet,\n} from \"../components/field\";\nimport { Input } from \"../components/input\";\n\nexport default function FieldFieldset() {\n  return (\n    <div className=\"w-full max-w-md space-y-6\">\n      <FieldSet>\n        <FieldLegend>Address Information</FieldLegend>\n        <FieldDescription>We need your address to deliver your order.</FieldDescription>\n        <FieldGroup>\n          <Field>\n            <FieldLabel>Street Address</FieldLabel>\n            <Input type=\"text\" placeholder=\"123 Main St\" />\n          </Field>\n          <div className=\"grid grid-cols-2 gap-4\">\n            <Field>\n              <FieldLabel>City</FieldLabel>\n              <Input type=\"text\" placeholder=\"New York\" />\n            </Field>\n            <Field>\n              <FieldLabel>Postal Code</FieldLabel>\n              <Input type=\"text\" placeholder=\"90502\" />\n            </Field>\n          </div>\n        </FieldGroup>\n      </FieldSet>\n    </div>\n  );\n}\n",
      "type": "registry:component",
      "target": "~/src/examples/field-fieldset.tsx"
    }
  ],
  "type": "registry:component"
}
