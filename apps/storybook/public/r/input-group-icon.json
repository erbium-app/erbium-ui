{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "input-group-icon",
  "title": "Input Group Icon",
  "description": "Erbium input group icon example.",
  "dependencies": ["lucide-react"],
  "registryDependencies": ["@erbium/input-group"],
  "files": [
    {
      "path": "registry/examples/input-group-icon.tsx",
      "content": "// @ts-nocheck\nimport { CheckIcon, CreditCardIcon, InfoIcon, MailIcon, SearchIcon, StarIcon } from \"lucide-react\";\n\nimport { InputGroup, InputGroupAddon, InputGroupInput } from \"../components/input-group\";\n\nexport default function InputGroupIcon() {\n  return (\n    <div className=\"grid w-full max-w-sm gap-6\">\n      <InputGroup>\n        <InputGroupInput placeholder=\"Search...\" />\n        <InputGroupAddon>\n          <SearchIcon />\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup>\n        <InputGroupInput type=\"email\" placeholder=\"Enter your email\" />\n        <InputGroupAddon>\n          <MailIcon />\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup>\n        <InputGroupInput placeholder=\"Card number\" />\n        <InputGroupAddon>\n          <CreditCardIcon />\n        </InputGroupAddon>\n        <InputGroupAddon align=\"inline-end\">\n          <CheckIcon />\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup>\n        <InputGroupInput placeholder=\"Card number\" />\n        <InputGroupAddon align=\"inline-end\">\n          <StarIcon />\n          <InfoIcon />\n        </InputGroupAddon>\n      </InputGroup>\n    </div>\n  );\n}\n",
      "type": "registry:component",
      "target": "~/src/examples/input-group-icon.tsx"
    }
  ],
  "type": "registry:component"
}
