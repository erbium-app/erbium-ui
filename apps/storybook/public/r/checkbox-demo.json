{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "checkbox-demo",
  "title": "Checkbox Demo",
  "description": "Erbium checkbox demo example.",
  "registryDependencies": ["@erbium/checkbox", "@erbium/field"],
  "files": [
    {
      "path": "registry/examples/checkbox-demo.tsx",
      "content": "// @ts-nocheck\nimport { Checkbox } from \"../components/checkbox\";\nimport { Field, FieldContent, FieldDescription, FieldLabel } from \"../components/field\";\n\nexport default function CheckboxDemo() {\n  return (\n    <div className=\"flex flex-col gap-6\">\n      <Field orientation=\"horizontal\">\n        <Checkbox />\n        <FieldLabel>Accept terms and conditions</FieldLabel>\n      </Field>\n      <Field orientation=\"horizontal\" className=\"items-start\">\n        <Checkbox defaultChecked />\n        <FieldContent>\n          <FieldLabel>Accept terms and conditions</FieldLabel>\n          <FieldDescription>\n            By clicking this checkbox, you agree to the terms and conditions.\n          </FieldDescription>\n        </FieldContent>\n      </Field>\n      <Field orientation=\"horizontal\" disabled>\n        <Checkbox />\n        <FieldLabel>Enable notifications</FieldLabel>\n      </Field>\n      <Field variant=\"card\" orientation=\"horizontal\">\n        <Checkbox defaultChecked />\n        <FieldContent>\n          <FieldLabel>Enable notifications</FieldLabel>\n          <FieldDescription>You can enable or disable notifications at any time.</FieldDescription>\n        </FieldContent>\n      </Field>\n    </div>\n  );\n}\n",
      "type": "registry:component",
      "target": "~/src/examples/checkbox-demo.tsx"
    }
  ],
  "type": "registry:component"
}
