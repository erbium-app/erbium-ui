{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "tabs-demo",
  "title": "Tabs Demo",
  "description": "Erbium tabs demo example.",
  "registryDependencies": [
    "@erbium/button",
    "@erbium/card",
    "@erbium/field",
    "@erbium/input",
    "@erbium/tabs"
  ],
  "files": [
    {
      "path": "registry/examples/tabs-demo.tsx",
      "content": "// @ts-nocheck\nimport { Button } from \"../components/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardFooter,\n  CardHeader,\n  CardTitle,\n} from \"../components/card\";\nimport { Input } from \"../components/input\";\nimport { Field, FieldLabel } from \"../components/field\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"../components/tabs\";\n\nexport default function TabsDemo() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-6\">\n      <Tabs defaultValue=\"account\">\n        <TabsList>\n          <TabsTrigger value=\"account\">Account</TabsTrigger>\n          <TabsTrigger value=\"password\">Password</TabsTrigger>\n        </TabsList>\n        <TabsContent value=\"account\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Account</CardTitle>\n              <CardDescription>\n                Make changes to your account here. Click save when you&apos;re done.\n              </CardDescription>\n            </CardHeader>\n            <CardContent className=\"grid gap-6\">\n              <Field>\n                <FieldLabel htmlFor=\"tabs-demo-name\">Name</FieldLabel>\n                <Input id=\"tabs-demo-name\" defaultValue=\"Pedro Duarte\" />\n              </Field>\n              <Field>\n                <FieldLabel htmlFor=\"tabs-demo-username\">Username</FieldLabel>\n                <Input id=\"tabs-demo-username\" defaultValue=\"@peduarte\" />\n              </Field>\n            </CardContent>\n            <CardFooter>\n              <Button>Save changes</Button>\n            </CardFooter>\n          </Card>\n        </TabsContent>\n        <TabsContent value=\"password\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Password</CardTitle>\n              <CardDescription>\n                Change your password here. After saving, you&apos;ll be logged out.\n              </CardDescription>\n            </CardHeader>\n            <CardContent className=\"grid gap-6\">\n              <Field>\n                <FieldLabel htmlFor=\"tabs-demo-current\">Current password</FieldLabel>\n                <Input id=\"tabs-demo-current\" type=\"password\" />\n              </Field>\n              <Field>\n                <FieldLabel htmlFor=\"tabs-demo-new\">New password</FieldLabel>\n                <Input id=\"tabs-demo-new\" type=\"password\" />\n              </Field>\n            </CardContent>\n            <CardFooter>\n              <Button>Save password</Button>\n            </CardFooter>\n          </Card>\n        </TabsContent>\n      </Tabs>\n    </div>\n  );\n}\n",
      "type": "registry:component",
      "target": "~/src/examples/tabs-demo.tsx"
    }
  ],
  "type": "registry:component"
}
