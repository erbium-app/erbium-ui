{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "button-group-size",
  "title": "Button Group Size",
  "description": "Erbium button group size example.",
  "dependencies": ["@hugeicons/core-free-icons", "@hugeicons/react"],
  "registryDependencies": ["@erbium/button", "@erbium/button-group"],
  "files": [
    {
      "path": "registry/examples/button-group-size.tsx",
      "content": "// @ts-nocheck\nimport { HugeiconsIcon } from \"@hugeicons/react\";\nimport PlusIcon from \"@hugeicons/core-free-icons/PlusIcon\";\n\nimport { Button } from \"../components/button\";\nimport { ButtonGroup } from \"../components/button-group\";\n\nexport default function ButtonGroupSize() {\n  return (\n    <div className=\"flex flex-col items-start gap-8\">\n      <ButtonGroup>\n        <Button variant=\"outline\" size=\"sm\">\n          Small\n        </Button>\n        <Button variant=\"outline\" size=\"sm\">\n          Button\n        </Button>\n        <Button variant=\"outline\" size=\"sm\">\n          Group\n        </Button>\n        <Button variant=\"outline\" size=\"icon-sm\">\n          <HugeiconsIcon icon={PlusIcon} />\n        </Button>\n      </ButtonGroup>\n      <ButtonGroup>\n        <Button variant=\"outline\">Default</Button>\n        <Button variant=\"outline\">Button</Button>\n        <Button variant=\"outline\">Group</Button>\n        <Button variant=\"outline\" size=\"icon\">\n          <HugeiconsIcon icon={PlusIcon} />\n        </Button>\n      </ButtonGroup>\n      <ButtonGroup>\n        <Button variant=\"outline\" size=\"lg\">\n          Large\n        </Button>\n        <Button variant=\"outline\" size=\"lg\">\n          Button\n        </Button>\n        <Button variant=\"outline\" size=\"lg\">\n          Group\n        </Button>\n        <Button variant=\"outline\" size=\"icon-lg\">\n          <HugeiconsIcon icon={PlusIcon} />\n        </Button>\n      </ButtonGroup>\n    </div>\n  );\n}\n",
      "type": "registry:component",
      "target": "~/src/examples/button-group-size.tsx"
    }
  ],
  "type": "registry:component"
}
