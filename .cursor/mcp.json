{
  "mcpServers": {
    "context7": {
      "command": "vp",
      "args": ["dlx", "--silent", "@upstash/context7-mcp"],
      "type": "stdio"
    },
    "shadcn": {
      "command": "vp",
      "args": ["dlx", "--silent", "shadcn@latest", "mcp"],
      "type": "stdio"
    },
    "better-auth": {
      "url": "https://mcp.chonkie.ai/better-auth/better-auth-builder/mcp",
      "type": "remote"
    }
  }
}
